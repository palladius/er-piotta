---
import '../styles/global.css';

interface Props {
  title: string;
  activeTab?: 'ale' | 'sebi' | 'famiglia';
}

const { title, activeTab = 'ale' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} · Er Piotta Tandem IMS</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body class="min-h-screen flex flex-col antialiased">

  <!-- Top App Navigation Header -->
  <header class="bg-slate-950/95 backdrop-blur-xl border-b border-slate-800/80 sticky top-0 z-50 shadow-2xl">
    <div class="max-w-[1440px] mx-auto px-4 py-2.5 flex flex-wrap items-center justify-between gap-3">
      
      <!-- Brand & Subtitle -->
      <a href={`${baseUrl}/`} class="flex items-center space-x-3 group no-underline">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 via-amber-500 to-amber-600 text-slate-950 flex items-center justify-center text-xl font-black shadow-lg shadow-amber-500/20 group-hover:scale-105 transition">
          🪽
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <span class="font-extrabold text-lg text-white tracking-tight group-hover:text-amber-400 transition">Er Piotta</span>
            <span class="text-[10px] uppercase font-mono font-bold bg-amber-400/20 text-amber-300 px-1.5 py-0.5 rounded border border-amber-400/30">Tandem IMS</span>
          </div>
          <p class="text-[11px] text-slate-400">Guida & Orari Settimanali Carlesso Family</p>
        </div>
      </a>

      <!-- Quick Switcher Tabs -->
      <div class="flex items-center gap-2">
        <a href={`${baseUrl}/ale`} class={`flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-extrabold transition no-underline ${activeTab === 'ale' ? 'bg-blue-600 text-white shadow-md shadow-blue-500/30 ring-2 ring-blue-400' : 'bg-slate-900 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-800'}`}>
          <span class="text-sm">👦</span>
          <span>Alessandro (P3)</span>
        </a>

        <a href={`${baseUrl}/sebi`} class={`flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-extrabold transition no-underline ${activeTab === 'sebi' ? 'bg-emerald-600 text-white shadow-md shadow-emerald-500/30 ring-2 ring-emerald-400' : 'bg-slate-900 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-800'}`}>
          <span class="text-sm">🧒</span>
          <span>Sebastian (P1)</span>
        </a>

        <a href={`${baseUrl}/famiglia`} class={`flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-extrabold transition no-underline ${activeTab === 'famiglia' ? 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow-md shadow-purple-500/30 ring-2 ring-purple-400' : 'bg-slate-900 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-800'}`}>
          <span class="text-sm">👥</span>
          <span>Famiglia (Confronto)</span>
        </a>
      </div>

      <!-- Quick Parent Duty Legend Pill -->
      <div class="hidden lg:flex items-center space-x-2 text-xs font-bold">
        <span class="badge badge-purple">
          <span class="w-2 h-2 rounded-full bg-purple-400"></span> Mamma (Kate): Lun, Mar, Ven
        </span>
        <span class="badge badge-amber">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span> Papà (Ricc): Mer, Gio
        </span>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-grow max-w-[1440px] mx-auto px-4 py-4 w-full">
    <slot />
  </main>

  <!-- Sticky Emergency & Contacts Footer -->
  <footer class="bg-slate-950/90 border-t border-slate-800/80 mt-auto py-3 text-xs text-slate-400">
    <div class="max-w-[1440px] mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-2.5 text-center md:text-left">
      <div class="flex items-center space-x-2">
        <span class="text-amber-400 text-base">🚛</span>
        <span><strong>Er Piotta</strong> per Riccardo, Kate, Ale e Sebi · Creato da <strong>Ermete Bottazzi</strong></span>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="tel:0435001030" class="text-slate-300 hover:text-amber-400 flex items-center gap-1.5 no-underline transition">
          <i class="fa-solid fa-phone text-amber-500"></i> Segreteria: 043 500 10 30
        </a>
        <span class="text-slate-700">|</span>
        <a href="tel:0435001099" class="text-slate-300 hover:text-amber-400 flex items-center gap-1.5 no-underline transition">
          <i class="fa-solid fa-bus text-amber-500"></i> Bus Hotline: 043 500 10 99
        </a>
      </div>
    </div>
  </footer>

</body>
</html>
