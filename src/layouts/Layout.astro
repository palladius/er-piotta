---
interface Props {
  title: string;
  activeTab?: 'ale' | 'sebi' | 'famiglia';
}

const { title, activeTab = 'ale' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="it" class="bg-slate-900 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} · Er Piotta Tandem IMS</title>
  <!-- Tailwind CSS via CDN for fast zero-overhead builds -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              purple: '#9333ea',
              amber: '#f59e0b',
              navy: '#0f172a'
            }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    @keyframes pulse-subtle {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.92; transform: scale(1.02); }
    }
    .pulse-urgent {
      animation: pulse-subtle 2s infinite ease-in-out;
    }
  </style>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans selection:bg-amber-400 selection:text-slate-900 pb-20">

  <!-- Top App Navigation -->
  <header class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50 shadow-xl">
    <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href={`${baseUrl}/`} class="flex items-center space-x-3 group">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-amber-400 to-amber-600 text-slate-950 flex items-center justify-center text-2xl font-black shadow-lg shadow-amber-500/20 group-hover:scale-105 transition">
          🪽
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="font-extrabold text-lg text-white tracking-tight">Er Piotta</h1>
            <span class="text-[10px] uppercase font-mono font-bold bg-amber-400/20 text-amber-300 px-2 py-0.5 rounded-md border border-amber-400/30">Tandem IMS</span>
          </div>
          <p class="text-xs text-slate-400">Guida & Orari Settimanali Carlesso Family</p>
        </div>
      </a>

      <!-- Quick Parent Duty Legend Pill -->
      <div class="hidden sm:flex items-center space-x-2 text-xs font-semibold">
        <span class="px-2.5 py-1 rounded-full bg-purple-950/80 text-purple-300 border border-purple-800 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-purple-400"></span> Mamma: Lun, Mar, Ven
        </span>
        <span class="px-2.5 py-1 rounded-full bg-amber-950/80 text-amber-300 border border-amber-800 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span> Papà: Mer, Gio
        </span>
      </div>
    </div>

    <!-- Multi-Child & Aggregated Switcher Bar -->
    <div class="max-w-5xl mx-auto px-4 border-t border-slate-800/80 flex items-center justify-center sm:justify-start gap-2 py-2 overflow-x-auto">
      <a href={`${baseUrl}/ale`} class={`flex items-center space-x-2 px-4 py-2 rounded-xl text-sm font-bold transition ${activeTab === 'ale' ? 'bg-blue-600 text-white shadow-lg shadow-blue-500/30 ring-2 ring-blue-400' : 'bg-slate-800/60 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-700'}`}>
        <span class="text-lg">👦</span>
        <span>Alessandro (P3)</span>
      </a>

      <a href={`${baseUrl}/sebi`} class={`flex items-center space-x-2 px-4 py-2 rounded-xl text-sm font-bold transition ${activeTab === 'sebi' ? 'bg-emerald-600 text-white shadow-lg shadow-emerald-500/30 ring-2 ring-emerald-400' : 'bg-slate-800/60 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-700'}`}>
        <span class="text-lg">🧒</span>
        <span>Sebastian (P1)</span>
      </a>

      <a href={`${baseUrl}/famiglia`} class={`flex items-center space-x-2 px-4 py-2 rounded-xl text-sm font-bold transition ${activeTab === 'famiglia' ? 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow-lg shadow-purple-500/30 ring-2 ring-purple-400' : 'bg-slate-800/60 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-700'}`}>
        <span class="text-lg">👥</span>
        <span>Vista Aggregata (Entrambi)</span>
      </a>
    </div>
  </header>

  <!-- Content Slot -->
  <main class="flex-grow max-w-5xl mx-auto px-4 py-6 w-full">
    <slot />
  </main>

  <!-- Sticky Emergency & Quick Contacts Footer -->
  <footer class="bg-slate-900 border-t border-slate-800 mt-auto py-4 text-xs text-slate-400">
    <div class="max-w-5xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-3 text-center md:text-left">
      <div class="flex items-center space-x-2">
        <span class="text-amber-400 text-base">🚛</span>
        <span><strong>Er Piotta</strong> per Riccardo, Kate, Ale e Sebi · Creato da <strong>Ermete Bottazzi</strong></span>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="tel:0435001030" class="text-slate-300 hover:text-amber-400 flex items-center gap-1">
          <i class="fa-solid fa-phone text-amber-500"></i> Segreteria: 043 500 10 30
        </a>
        <span class="text-slate-600">|</span>
        <a href="tel:0435001099" class="text-slate-300 hover:text-amber-400 flex items-center gap-1">
          <i class="fa-solid fa-bus text-amber-500"></i> Bus: 043 500 10 99
        </a>
      </div>
    </div>
  </footer>

</body>
</html>
