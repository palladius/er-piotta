---
import '../styles/global.css';

interface Props {
  title: string;
  activeTab?: 'ale' | 'sebi' | 'famiglia';
}

const { title, activeTab = 'ale' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="it" data-lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} · Er Piotta Tandem IMS</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  
  <!-- Instant Lang Initialization to prevent layout flash -->
  <script is:inline>
    (function() {
      const savedLang = localStorage.getItem('er_piotta_lang');
      if (savedLang === 'en' || (!savedLang && navigator.language.startsWith('en'))) {
        document.documentElement.setAttribute('data-lang', 'en');
      } else {
        document.documentElement.setAttribute('data-lang', 'it');
      }
    })();
  </script>
</head>
<body class="min-h-screen flex flex-col antialiased">

  <!-- Top App Navigation Header -->
  <header class="bg-slate-950/95 backdrop-blur-xl border-b border-slate-800/80 sticky top-0 z-50 shadow-2xl">
    <div class="max-w-[1440px] mx-auto px-4 py-2.5 flex flex-wrap items-center justify-between gap-3">
      
      <!-- Brand & Subtitle -->
      <a href={`${baseUrl}/`} class="flex items-center space-x-3 group no-underline">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 via-amber-500 to-amber-600 text-slate-950 flex items-center justify-center text-xl font-black shadow-lg shadow-amber-500/20 group-hover:scale-105 transition">
          🪽
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <span class="font-extrabold text-lg text-white tracking-tight group-hover:text-amber-400 transition">Er Piotta</span>
            <span class="text-[10px] uppercase font-mono font-bold bg-amber-400/20 text-amber-300 px-1.5 py-0.5 rounded border border-amber-400/30">Tandem IMS</span>
          </div>
          <p class="text-[11px] text-slate-400">
            <span class="lang-it">Guida & Orari Settimanali Carlesso</span>
            <span class="lang-en">Carlesso Family Weekly Schedule</span>
          </p>
        </div>
      </a>

      <!-- Quick Switcher Tabs -->
      <div class="flex items-center gap-2">
        <a href={`${baseUrl}/ale`} class={`flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-extrabold transition no-underline ${activeTab === 'ale' ? 'bg-blue-600 text-white shadow-md shadow-blue-500/30 ring-2 ring-blue-400' : 'bg-slate-900 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-800'}`}>
          <span class="text-sm">👦</span>
          <span>Alessandro (P3)</span>
        </a>

        <a href={`${baseUrl}/sebi`} class={`flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-extrabold transition no-underline ${activeTab === 'sebi' ? 'bg-emerald-600 text-white shadow-md shadow-emerald-500/30 ring-2 ring-emerald-400' : 'bg-slate-900 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-800'}`}>
          <span class="text-sm">🧒</span>
          <span>Sebastian (P1)</span>
        </a>

        <a href={`${baseUrl}/famiglia`} class={`flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-extrabold transition no-underline ${activeTab === 'famiglia' ? 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow-md shadow-purple-500/30 ring-2 ring-purple-400' : 'bg-slate-900 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-800'}`}>
          <span class="text-sm">👥</span>
          <span>
            <span class="lang-it">Famiglia</span>
            <span class="lang-en">Family</span>
          </span>
        </a>
      </div>

      <!-- Right Controls: Parent Duty Legend + Language Switcher -->
      <div class="flex items-center gap-3">
        <!-- Quick Parent Duty Legend Pill -->
        <div class="hidden xl:flex items-center space-x-2 text-xs font-bold">
          <span class="badge badge-purple">
            <span class="w-2 h-2 rounded-full bg-purple-400"></span>
            <span class="lang-it">Mamma (Kate): Lun, Mar, Ven</span>
            <span class="lang-en">Mum (Kate): Mon, Tue, Fri</span>
          </span>
          <span class="badge badge-amber">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            <span class="lang-it">Papà (Ricc): Mer, Gio</span>
            <span class="lang-en">Dad (Ricc): Wed, Thu</span>
          </span>
        </div>

        <!-- Language Switcher Pill Toggle -->
        <div class="bg-slate-900 p-1 rounded-xl border border-slate-800 flex items-center gap-1 shadow-inner" id="lang-switcher">
          <button type="button" class="lang-toggle-btn active" data-set-lang="it" title="Italiano">
            <span>🇮🇹</span>
            <span>IT</span>
          </button>
          <button type="button" class="lang-toggle-btn" data-set-lang="en" title="English">
            <span>🇬🇧</span>
            <span>EN</span>
          </button>
        </div>
      </div>

    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-grow max-w-[1440px] mx-auto px-4 py-4 w-full">
    <slot />
  </main>

  <!-- Sticky Emergency, Door Code & Contacts Footer -->
  <footer class="bg-slate-950/95 border-t border-slate-800/80 mt-auto py-3 text-xs text-slate-400 shadow-2xl">
    <div class="max-w-[1440px] mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-3 text-center md:text-left">
      
      <!-- Creator Signature -->
      <div class="flex items-center space-x-2">
        <span class="text-amber-400 text-base">🚛</span>
        <span>
          <strong>Er Piotta</strong> 
          <span class="lang-it">per Riccardo, Kate, Ale e Sebi · Creato da <strong>Ermete Bottazzi</strong></span>
          <span class="lang-en">for Riccardo, Kate, Ale & Sebi · Crafted by <strong>Ermete Bottazzi</strong></span>
        </span>
      </div>

      <!-- Essential Quick Access Badges (Door Code & Phones) -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        
        <!-- Door Keypad Code -->
        <div class="bg-amber-500/15 border border-amber-500/40 text-amber-300 px-3 py-1 rounded-lg flex items-center gap-1.5 font-bold shadow-sm">
          <span>🚪</span>
          <span class="lang-it">Codice Porta:</span>
          <span class="lang-en">Door Code:</span>
          <code class="bg-slate-950 text-white px-2 py-0.5 rounded border border-amber-400/50 font-mono tracking-wider font-extrabold text-xs">157412 + OK</code>
        </div>

        <!-- School Office Phone -->
        <a href="tel:0435001030" class="text-slate-300 hover:text-amber-400 flex items-center gap-1.5 no-underline transition bg-slate-900/80 px-2.5 py-1 rounded-lg border border-slate-800">
          <i class="fa-solid fa-phone text-amber-500"></i>
          <span class="lang-it">Segreteria: 043 500 10 30</span>
          <span class="lang-en">Office: 043 500 10 30</span>
        </a>

        <!-- Bus Hotline -->
        <a href="tel:0435001099" class="text-slate-300 hover:text-amber-400 flex items-center gap-1.5 no-underline transition bg-slate-900/80 px-2.5 py-1 rounded-lg border border-slate-800">
          <i class="fa-solid fa-bus text-amber-500"></i>
          <span class="lang-it">Bus Hotline: 043 500 10 99</span>
          <span class="lang-en">Bus Hotline: 043 500 10 99</span>
        </a>

      </div>
    </div>
  </footer>

  <!-- Language Switcher Script -->
  <script is:inline>
    function updateLangButtons(lang) {
      const itBtn = document.querySelector('[data-set-lang="it"]');
      const enBtn = document.querySelector('[data-set-lang="en"]');
      if (itBtn && enBtn) {
        if (lang === 'en') {
          itBtn.classList.remove('active');
          enBtn.classList.add('active');
        } else {
          enBtn.classList.remove('active');
          itBtn.classList.add('active');
        }
      }
    }

    function setLanguage(lang) {
      document.documentElement.setAttribute('data-lang', lang);
      localStorage.setItem('er_piotta_lang', lang);
      updateLangButtons(lang);
    }

    document.addEventListener('DOMContentLoaded', () => {
      const current = document.documentElement.getAttribute('data-lang') || 'it';
      updateLangButtons(current);

      document.querySelectorAll('[data-set-lang]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const targetLang = btn.getAttribute('data-set-lang');
          if (targetLang) setLanguage(targetLang);
        });
      });
    });
  </script>

</body>
</html>
