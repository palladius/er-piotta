---
import '../styles/global.css';

interface Props {
  title: string;
  activeTab?: 'ale' | 'sebi' | 'famiglia';
}

const { title, activeTab = 'ale' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} · Er Piotta Tandem IMS</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex flex-col antialiased">

  <!-- Top App Navigation Header -->
  <header class="bg-slate-900/90 backdrop-blur-xl border-b border-slate-800/80 sticky top-0 z-50 shadow-2xl">
    <div class="max-w-5xl mx-auto px-4 py-3.5 flex items-center justify-between">
      <a href={`${baseUrl}/`} class="flex items-center space-x-3.5 group no-underline">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-amber-400 via-amber-500 to-amber-600 text-slate-950 flex items-center justify-center text-2xl font-black shadow-lg shadow-amber-500/20 group-hover:scale-105 group-hover:rotate-3 transition duration-200">
          🪽
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="font-extrabold text-xl text-white tracking-tight group-hover:text-amber-400 transition">Er Piotta</h1>
            <span class="text-[10px] uppercase font-mono font-bold bg-amber-400/20 text-amber-300 px-2 py-0.5 rounded-md border border-amber-400/30">Tandem IMS</span>
          </div>
          <p class="text-xs text-slate-400">Guida & Orari Settimanali Carlesso Family</p>
        </div>
      </a>

      <!-- Quick Parent Duty Legend Pill -->
      <div class="hidden sm:flex items-center space-x-2 text-xs font-semibold">
        <span class="px-3 py-1 rounded-full bg-purple-950/80 text-purple-300 border border-purple-800 flex items-center gap-1.5 shadow-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-purple-400 shadow-sm shadow-purple-400"></span> Mamma: Lun, Mar, Ven
        </span>
        <span class="px-3 py-1 rounded-full bg-amber-950/80 text-amber-300 border border-amber-800 flex items-center gap-1.5 shadow-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-sm shadow-amber-400"></span> Papà: Mer, Gio
        </span>
      </div>
    </div>

    <!-- Multi-Child & Aggregated Switcher Bar -->
    <div class="max-w-5xl mx-auto px-4 border-t border-slate-800/80 flex items-center justify-start gap-2.5 py-2.5 overflow-x-auto">
      <a href={`${baseUrl}/ale`} class={`flex items-center space-x-2 px-4 py-2 rounded-xl text-sm font-bold transition no-underline ${activeTab === 'ale' ? 'bg-blue-600 text-white shadow-lg shadow-blue-500/30 ring-2 ring-blue-400 scale-[1.02]' : 'bg-slate-800/70 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-700/80'}`}>
        <span class="text-lg">👦</span>
        <span>Alessandro (P3)</span>
      </a>

      <a href={`${baseUrl}/sebi`} class={`flex items-center space-x-2 px-4 py-2 rounded-xl text-sm font-bold transition no-underline ${activeTab === 'sebi' ? 'bg-emerald-600 text-white shadow-lg shadow-emerald-500/30 ring-2 ring-emerald-400 scale-[1.02]' : 'bg-slate-800/70 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-700/80'}`}>
        <span class="text-lg">🧒</span>
        <span>Sebastian (P1)</span>
      </a>

      <a href={`${baseUrl}/famiglia`} class={`flex items-center space-x-2 px-4 py-2 rounded-xl text-sm font-bold transition no-underline ${activeTab === 'famiglia' ? 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow-lg shadow-purple-500/30 ring-2 ring-purple-400 scale-[1.02]' : 'bg-slate-800/70 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-700/80'}`}>
        <span class="text-lg">👥</span>
        <span>Vista Aggregata (Entrambi)</span>
      </a>
    </div>
  </header>

  <!-- Content Slot -->
  <main class="flex-grow max-w-5xl mx-auto px-4 py-8 w-full">
    <slot />
  </main>

  <!-- Sticky Emergency & Quick Contacts Footer -->
  <footer class="bg-slate-900/90 border-t border-slate-800/80 mt-auto py-5 text-xs text-slate-400">
    <div class="max-w-5xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-3.5 text-center md:text-left">
      <div class="flex items-center space-x-2">
        <span class="text-amber-400 text-lg">🚛</span>
        <span><strong>Er Piotta</strong> per Riccardo, Kate, Ale e Sebi · Creato con cura da <strong>Ermete Bottazzi</strong></span>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3.5">
        <a href="tel:0435001030" class="text-slate-300 hover:text-amber-400 flex items-center gap-1.5 no-underline transition">
          <i class="fa-solid fa-phone text-amber-500"></i> Segreteria: 043 500 10 30
        </a>
        <span class="text-slate-700">|</span>
        <a href="tel:0435001099" class="text-slate-300 hover:text-amber-400 flex items-center gap-1.5 no-underline transition">
          <i class="fa-solid fa-bus text-amber-500"></i> Bus Hotline: 043 500 10 99
        </a>
      </div>
    </div>
  </footer>

</body>
</html>
