---
import type { ChildData, ChecklistItem } from '../data/schoolData';

interface Props {
  child: ChildData;
}

const { child } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const daysKeys = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday'];
const dayIndex = new Date().getDay();
const todayKey = dayIndex >= 1 && dayIndex <= 5 ? daysKeys[dayIndex - 1] : 'monday';

function isDoublePeriod(timeStr: string) {
  return timeStr.includes('10:05') || timeStr.includes('12:25') || timeStr.includes('15:35');
}

function getSlotClass(slot: any) {
  if (slot.type === 'dismissal') return 'slot-dismissal';
  if (slot.type === 'afternoon_home') return 'slot-afternoon-silvana-large';

  const s = (slot.subjectIt || '').toLowerCase();
  if (s.includes('sport') || s.includes('movimento')) return 'subject-sport';
  if (s.includes('tedesco') || s.includes('german')) return 'subject-deutsch';
  if (s.includes('matematica') || s.includes('maths') || s.includes('numeri')) return 'subject-math';
  if (s.includes('inglese') || s.includes('fonetica')) return 'subject-english';
  if (s.includes('francese') || s.includes('french')) return 'subject-french';
  if (s.includes('arte') || s.includes('disegno') || s.includes('lavoretti')) return 'subject-art';
  if (s.includes('musica') || s.includes('canto')) return 'subject-music';
  if (s.includes('scienze') || s.includes('enquiry') || s.includes('natura')) return 'subject-enquiry';
  return 'subject-default';
}

function getBackpackItems(checklist: ChecklistItem[]) {
  return checklist.filter(c => c.type === 'backpack');
}

function getEveningItems(checklist: ChecklistItem[]) {
  return checklist.filter(c => c.type === 'homework' || c.type === 'deadline');
}
---

<div class="table-scroll-wrapper">
  <div class="table-2d-matrix">

    <!-- ========================================================
         ROW 1: DAY HEADERS (Lunedì - Venerdì)
         ======================================================== -->
    <div class="axis-cell">
      <span style="font-size: 0.6rem; text-transform: uppercase; color: #475569;">Giorno</span>
    </div>
    {daysKeys.map((key) => {
      const d = child.days[key];
      const isToday = key === todayKey;
      return (
        <div class={`row-header-cell ${isToday ? 'row-header-today' : ''}`}>
          <div style="display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 2px;">
            <span style="font-size: 1.2rem;">{d.emoji}</span>
            <strong style="font-size: 0.95rem; color: #ffffff; text-transform: capitalize;">
              <span class="lang-it">{d.dayNameIt.split(' ')[0]}</span>
              <span class="lang-en">{d.dayNameEn.split(' ')[0]}</span>
            </strong>
          </div>
          {isToday && (
            <span style="display: inline-block; font-size: 0.6rem; font-weight: 900; text-transform: uppercase; background: #f59e0b; color: #000000; padding: 1px 7px; border-radius: 9999px; margin-bottom: 2px;">
              <span class="lang-it">Oggi</span>
              <span class="lang-en">Today</span>
            </span>
          )}
          <div style="font-size: 0.7rem; color: #94a3b8; font-family: 'JetBrains Mono', monospace;">
            {d.dropOff.split('–')[0].trim()} ➔ {d.pickUpIt.split(' ')[0]}
          </div>
        </div>
      );
    })}

    <!-- ========================================================
         ROW 2: PARENT DUTY STRIPS (With Large Avatars)
         ======================================================== -->
    <div class="axis-cell">
      <span style="font-size: 0.58rem; text-transform: uppercase; color: #475569;">Turno</span>
    </div>
    {daysKeys.map((key) => {
      const d = child.days[key];
      return (
        <div class="row-duty-cell">
          <div style="display: flex; align-items: center; justify-content: center; gap: 6px;">
            {d.duty.avatarImg && (
              <img src={`${baseUrl}${d.duty.avatarImg}`} alt="Duty" class="w-5 h-5 rounded-full object-cover ring-1.5 ring-amber-400/70" />
            )}
            <span class={`badge ${d.duty.parent === 'mamma' ? 'badge-purple' : 'badge-amber'}`} style="font-size: 0.7rem; padding: 2px 8px;">
              <span class="lang-it">{d.duty.parentNameIt.split(' ')[1]} ({d.duty.parent === 'mamma' ? 'Kate' : 'Ricc'})</span>
              <span class="lang-en">{d.duty.parentNameEn.split(' ')[1]} ({d.duty.parent === 'mamma' ? 'Kate' : 'Ricc'})</span>
            </span>
          </div>
          {d.duty.afternoonCareIt && (
            <div style="display: flex; align-items: center; gap: 6px; margin-top: 1px;">
              {d.duty.afternoonCareAvatar && (
                <img src={`${baseUrl}${d.duty.afternoonCareAvatar}`} alt="Silvana" class="w-8 h-8 rounded-full object-cover ring-2 ring-purple-400 shadow-md bg-slate-950" />
              )}
              <span class="badge badge-emerald" style="font-size: 0.68rem; padding: 2px 8px; font-weight: 800;">
                <span class="lang-it">{d.duty.afternoonCareIt}</span>
                <span class="lang-en">{d.duty.afternoonCareEn}</span>
              </span>
            </div>
          )}
        </div>
      );
    })}

    <!-- ========================================================
         ROW 3: 🎒 ZAINO MATTINO (Ghost Card Row)
         ======================================================== -->
    <div class="axis-cell">
      <span style="font-size: 0.75rem;">🎒</span>
      <span style="font-size: 0.58rem; color: #38bdf8; font-weight: 800;">ZAINO</span>
    </div>
    {daysKeys.map((key) => {
      const d = child.days[key];
      const backpackItems = getBackpackItems(d.checklist);
      return (
        <div class="row-ghost-checklist">
          <div style="font-size: 0.6rem; font-weight: 900; text-transform: uppercase; color: #38bdf8; letter-spacing: 0.03em; margin-bottom: 2px; display: flex; align-items: center; gap: 4px;">
            <span>🎒</span>
            <span class="lang-it">Zaino Mattina:</span>
            <span class="lang-en">Morning Bag:</span>
          </div>
          {backpackItems.map((item) => (
            <div class="ghost-checklist-row">
              <span style="font-size: 0.75rem; flex-shrink: 0;">{item.icon}</span>
              <span style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <span class="lang-it">{item.textIt}</span>
                <span class="lang-en">{item.textEn}</span>
              </span>
            </div>
          ))}
        </div>
      );
    })}

    <!-- ========================================================
         ROW 4: ☀️ SOLID MATTINO (4-Row Fixed Period Subgrid)
         ======================================================== -->
    <div class="axis-cell">
      <span style="color: #93c5fd; font-weight: 900; font-size: 0.72rem;">08:30</span>
      <span style="color: #93c5fd; font-weight: 900; font-size: 0.72rem; margin-top: 140px;">12:25</span>
    </div>
    {daysKeys.map((key) => {
      const d = child.days[key];
      const b = d.blocks;
      return (
        <div class="row-solid-morning">
          <div class="solid-header solid-header-morning">
            <span>
              <span class="lang-it">☀️ MATTINO</span>
              <span class="lang-en">☀️ MORNING</span>
            </span>
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; opacity: 0.85;">08:30–12:25</span>
          </div>
          
          <!-- Exact 4-Period Grid Subgrid: Double periods span 2 rows, single periods span 1 row -->
          <div class="morning-grid-slots">
            {b.morning.map((s) => (
              <div 
                class={`slot-card ${getSlotClass(s)} ${isDoublePeriod(s.time) ? 'slot-span-2' : 'slot-span-1'}`}
                title={`${s.time} · ${s.location ? s.location + ' · ' : ''}${s.teacher ? 'Prof: ' + s.teacher + ' · ' : ''}${s.notesIt || ''}`}
              >
                <div class="minimal-slot-line">
                  <span class="slot-time-bold">{s.startTime}</span>
                  <span class="slot-icon">{s.icon}</span>
                  <span class="slot-subject-title">
                    <span class="lang-it">{s.subjectIt}</span>
                    <span class="lang-en">{s.subjectEn}</span>
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    })}

    <!-- ========================================================
         ROW 5: 🍽️ PAUSA PRANZO (12:25 – 13:50)
         ======================================================== -->
    <div class="axis-cell">
      <span style="color: #f59e0b; font-weight: 900; font-size: 0.72rem;">12:25</span>
      <span style="font-size: 0.75rem;">🍽️</span>
    </div>
    {daysKeys.map((key) => {
      const d = child.days[key];
      const b = d.blocks;
      return (
        <div class={`row-lunch-ribbon ${b.lunch.isSpecial ? 'lunch-home-papino' : 'lunch-school-transparent'}`} title={`${b.lunch.time} · ${b.lunch.notesIt}`}>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; font-weight: 900; color: #fef08a;">
              {b.lunch.startTime}
            </span>
            <span style="font-size: 0.58rem; font-weight: 800; text-transform: uppercase; opacity: 0.85; color: #cbd5e1;">
              <span class="lang-it">PRANZO</span>
              <span class="lang-en">LUNCH</span>
            </span>
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            {b.lunch.avatarImg ? (
              <img src={`${baseUrl}${b.lunch.avatarImg}`} alt="Papino" class="w-8 h-8 rounded-full object-cover ring-2 ring-amber-300 shadow shrink-0 bg-slate-950" />
            ) : (
              <span style="font-size: 1rem;">🍽️</span>
            )}
            <div style="overflow: hidden;">
              <div style="font-size: 0.74rem; font-weight: 900; line-height: 1.2; color: #ffffff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                <span class="lang-it">{b.lunch.subjectIt}</span>
                <span class="lang-en">{b.lunch.subjectEn}</span>
              </div>
            </div>
          </div>
        </div>
      );
    })}

    <!-- ========================================================
         ROW 6: 🌤️ SOLID POMERIGGIO (With 3x Silvana Avatar)
         ======================================================== -->
    <div class="axis-cell">
      <span style="color: #d8b4fe; font-weight: 900; font-size: 0.72rem;">13:50</span>
      <span style="color: #38bdf8; font-weight: 900; font-size: 0.72rem; margin-top: 80px;">15:55 🔔</span>
    </div>
    {daysKeys.map((key) => {
      const d = child.days[key];
      const b = d.blocks;
      return (
        <div class="row-solid-afternoon">
          <div class="solid-header solid-header-afternoon">
            <span>
              <span class="lang-it">🌤️ POMERIGGIO</span>
              <span class="lang-en">🌤️ AFTERNOON</span>
            </span>
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; opacity: 0.85;">13:50–15:55</span>
          </div>
          
          <div class="afternoon-grid-slots">
            {b.afternoon.map((s) => (
              s.type === 'afternoon_home' ? (
                <!-- Wednesday Silvana Large 3x Avatar Highlight -->
                <div class="slot-afternoon-silvana-large" title={`${s.time} · ${s.notesIt || ''}`}>
                  {s.avatarImg && (
                    <img src={`${baseUrl}${s.avatarImg}`} alt="Silvana" class="w-12 h-12 rounded-full object-cover ring-2 ring-purple-300 shadow-xl shrink-0 bg-slate-950" />
                  )}
                  <div style="overflow: hidden;">
                    <div style="font-size: 0.82rem; font-weight: 900; color: #ffffff; line-height: 1.2;">
                      <span class="lang-it">{s.subjectIt}</span>
                      <span class="lang-en">{s.subjectEn}</span>
                    </div>
                    <div style="font-size: 0.65rem; color: #e9d5ff; opacity: 0.9; margin-top: 2px;">
                      <span class="lang-it">Tata Silvana a casa</span>
                      <span class="lang-en">Nanny Silvana at home</span>
                    </div>
                  </div>
                </div>
              ) : (
                <div 
                  class={`slot-card ${getSlotClass(s)}`}
                  title={`${s.time} · ${s.location ? s.location + ' · ' : ''}${s.teacher ? 'Prof: ' + s.teacher + ' · ' : ''}${s.notesIt || ''}`}
                >
                  <div class="minimal-slot-line">
                    <span class="slot-time-bold">{s.startTime}</span>
                    <span class="slot-icon">{s.icon}</span>
                    <span class="slot-subject-title">
                      <span class="lang-it">{s.subjectIt}</span>
                      <span class="lang-en">{s.subjectEn}</span>
                    </span>
                  </div>
                </div>
              )
            ))}
          </div>
        </div>
      );
    })}

    <!-- ========================================================
         ROW 7: ⭐ EXTRA-CURRICULARI & DOPO SCUOLA
         ======================================================== -->
    <div class="axis-cell">
      <span style="color: #a5b4fc; font-weight: 900; font-size: 0.72rem;">16:00+</span>
      <span style="font-size: 0.75rem;">🎭</span>
    </div>
    {daysKeys.map((key) => {
      const d = child.days[key];
      const b = d.blocks;
      const eveningHomework = getEveningItems(d.checklist);
      return (
        <div class="row-ghost-extra">
          <div class="solid-header solid-header-extra">
            <span>
              <span class="lang-it">⭐ DOPO SCUOLA</span>
              <span class="lang-en">⭐ AFTER SCHOOL</span>
            </span>
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; opacity: 0.85;">{b.extra.time}</span>
          </div>
          <div class="extra-inner-content">
            <div class={b.extra.hasActivity ? 'extra-active-card' : 'extra-relax-card'} title={`${b.extra.time} · Gestione: ${b.extra.managedByIt} · ${b.extra.notesIt || ''}`}>
              <div style="font-size: 0.72rem; font-weight: 800; color: #ffffff; display: flex; align-items: center; gap: 4px;">
                <span>{b.extra.icon}</span>
                <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  <span class="lang-it">{b.extra.titleIt}</span>
                  <span class="lang-en">{b.extra.titleEn}</span>
                </span>
              </div>
              {eveningHomework.length > 0 && (
                <div style="font-size: 0.58rem; color: #fef08a; margin-top: 2px; display: flex; align-items: center; gap: 3px;">
                  <span>🌙</span>
                  <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    {eveningHomework.map(h => h.textIt).join(' · ')}
                  </span>
                </div>
              )}
            </div>
          </div>
        </div>
      );
    })}

  </div>
</div>
