---
import type { ChildData, ChecklistItem } from '../data/schoolData';

interface Props {
  child: ChildData;
}

const { child } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const daysKeys = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday'];
const dayIndex = new Date().getDay();
const todayKey = dayIndex >= 1 && dayIndex <= 5 ? daysKeys[dayIndex - 1] : 'monday';

function isDoublePeriod(timeStr: string) {
  return timeStr.includes('10:05') || timeStr.includes('12:25') || timeStr.includes('15:35');
}

function getSubjectClass(slot: any) {
  if (slot.type === 'break') return 'slot-break-dashed';
  if (slot.type === 'dismissal') return 'slot-dismissal-solid';
  if (slot.type === 'afternoon_home') return 'slot-silvana-home';

  const s = (slot.subjectIt || '').toLowerCase();
  if (s.includes('sport') || s.includes('pe') || s.includes('movement')) return 'subject-sport';
  if (s.includes('deutsch') || s.includes('german')) return 'subject-deutsch';
  if (s.includes('math') || s.includes('mathe') || s.includes('wochenplan')) return 'subject-math';
  if (s.includes('english') || s.includes('phonic')) return 'subject-english';
  if (s.includes('french') || s.includes('français')) return 'subject-french';
  if (s.includes('art') || s.includes('tessile') || s.includes('craft')) return 'subject-art';
  if (s.includes('music') || s.includes('singing')) return 'subject-music';
  if (s.includes('enquiry')) return 'subject-enquiry';
  return 'subject-default';
}

function getBackpackItems(checklist: ChecklistItem[]) {
  return checklist.filter(c => c.type === 'backpack');
}

function getEveningHomeworkItems(checklist: ChecklistItem[]) {
  return checklist.filter(c => c.type === 'homework' || c.type === 'deadline');
}
---

<div class="calendar-wrapper">
  <div class="calendar-container">

    <!-- Left Time Axis (Google Calendar Style) -->
    <div class="time-axis hidden md:flex">
      <!-- Morning Markers -->
      <div style="height: 290px; display: flex; flex-direction: column; justify-content: space-between; padding: 20px 0 4px 0;">
        <span class="time-axis-label">08:30</span>
        <span class="time-axis-label" style="color: #94a3b8;">10:05 ☕</span>
        <span class="time-axis-label">10:50</span>
        <span class="time-axis-label">12:25</span>
      </div>

      <!-- Lunch Marker -->
      <div style="height: 48px; display: flex; flex-direction: column; justify-content: center;">
        <span class="time-axis-label" style="color: #f59e0b; font-weight: 900;">12:25 🍽️</span>
      </div>

      <!-- Afternoon Markers -->
      <div style="height: 180px; display: flex; flex-direction: column; justify-content: space-between; padding: 20px 0 4px 0;">
        <span class="time-axis-label">13:50</span>
        <span class="time-axis-label">15:35</span>
        <span class="time-axis-label" style="color: #38bdf8; font-weight: 900;">15:55 🔔</span>
      </div>

      <!-- Evening Extra Marker -->
      <div style="height: 52px; display: flex; flex-direction: column; justify-content: center;">
        <span class="time-axis-label" style="color: #c084fc; font-weight: 900;">16:00+ 🌙</span>
      </div>
    </div>

    <!-- 5 Columns: Lunedì -> Venerdì -->
    {daysKeys.map((key) => {
      const d = child.days[key];
      const isToday = key === todayKey;
      const b = d.blocks;
      const backpackItems = getBackpackItems(d.checklist);
      const eveningItems = getEveningHomeworkItems(d.checklist);

      return (
        <div class={`day-column ${isToday ? 'day-column-today' : ''}`}>
          
          <!-- Column Header -->
          <div class={`day-column-header ${isToday ? 'day-column-header-today' : ''}`}>
            <div style="display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 2px;">
              <span style="font-size: 1.25rem;">{d.emoji}</span>
              <strong style="font-size: 1rem; color: #ffffff; text-transform: capitalize;">
                <span class="lang-it">{d.dayNameIt.split(' ')[0]}</span>
                <span class="lang-en">{d.dayNameEn.split(' ')[0]}</span>
              </strong>
            </div>
            
            {isToday && (
              <span style="display: inline-block; font-size: 0.65rem; font-weight: 900; text-transform: uppercase; background: #f59e0b; color: #000000; padding: 1px 8px; border-radius: 9999px; margin-bottom: 2px;">
                <span class="lang-it">Oggi</span>
                <span class="lang-en">Today</span>
              </span>
            )}

            <div style="font-size: 0.72rem; color: #94a3b8; font-family: 'JetBrains Mono', monospace;">
              {d.dropOff.split('–')[0].trim()} ➔ {d.pickUpIt.split(' ')[0]}
            </div>
          </div>

          <!-- Duty Strip -->
          <div class="duty-bar">
            <div style="display: flex; align-items: center; justify-content: center; gap: 6px;">
              {d.duty.avatarImg && (
                <img 
                  src={`${baseUrl}${d.duty.avatarImg}`} 
                  alt="Duty" 
                  class="w-5 h-5 rounded-full object-cover ring-1 ring-amber-400/50"
                />
              )}
              <span class={`badge ${d.duty.parent === 'mamma' ? 'badge-purple' : 'badge-amber'}`} style="font-size: 0.7rem; padding: 2px 8px;">
                <span class="lang-it">{d.duty.parentNameIt.split(' ')[1]} ({d.duty.parent === 'mamma' ? 'Kate' : 'Ricc'})</span>
                <span class="lang-en">{d.duty.parentNameEn.split(' ')[1]} ({d.duty.parent === 'mamma' ? 'Kate' : 'Ricc'})</span>
              </span>
            </div>
            {d.duty.afternoonCareIt && (
              <div style="display: flex; align-items: center; gap: 4px;">
                <img 
                  src={`${baseUrl}/avatars/avatar_silvana.png`} 
                  alt="Silvana" 
                  class="w-4 h-4 rounded-full object-cover ring-1 ring-emerald-400/50"
                />
                <span class="badge badge-emerald" style="font-size: 0.68rem; padding: 2px 8px;">
                  <span class="lang-it">{d.duty.afternoonCareIt}</span>
                  <span class="lang-en">{d.duty.afternoonCareEn}</span>
                </span>
              </div>
            )}
          </div>

          <!-- 1. GHOST / TRASPARENZA: ZAINO MATTINA (In Cima) -->
          <div class="ghost-backpack-card">
            <div class="ghost-header">
              <span>🎒</span>
              <span class="lang-it">ZAINO MATTINA</span>
              <span class="lang-en">MORNING BAG</span>
            </div>
            {backpackItems.map((item) => (
              <div class="ghost-row">
                <span style="font-size: 0.75rem; flex-shrink: 0;">{item.icon}</span>
                <span style="flex: 1;">
                  <span class="lang-it">{item.textIt}</span>
                  <span class="lang-en">{item.textEn}</span>
                </span>
              </div>
            ))}
          </div>

          <!-- 2. LOOK SOLIDO: MATTINO (08:30 – 12:25) -->
          <div class="solid-morning-container">
            <div class="solid-block-header solid-header-morning">
              <span>
                <span class="lang-it">☀️ MATTINO</span>
                <span class="lang-en">☀️ MORNING</span>
              </span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; opacity: 0.85;">08:30–12:25</span>
            </div>
            
            <div class="solid-slots-inner">
              {b.morning.map((s) => (
                <div class={`slot-solid-card ${getSubjectClass(s)} ${s.type === 'break' ? '' : (isDoublePeriod(s.time) ? 'slot-double-height' : 'slot-single-height')}`}>
                  <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                    <span class="slot-time">{s.time}</span>
                    {s.location && (
                      <span style="font-size: 0.62rem; opacity: 0.85; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        {s.location}
                      </span>
                    )}
                  </div>
                  <div class="slot-title">
                    <span class="lang-it">{s.subjectIt}</span>
                    <span class="lang-en">{s.subjectEn}</span>
                  </div>
                  {s.teacher && (
                    <div class="slot-meta">
                      <span class="lang-it">Prof: {s.teacher}</span>
                      <span class="lang-en">Teacher: {s.teacher}</span>
                    </div>
                  )}
                  {(s.notesIt || s.notesEn) && (
                    <div class="slot-meta" style="font-style: italic; opacity: 0.85;">
                      <span class="lang-it">{s.notesIt}</span>
                      <span class="lang-en">{s.notesEn}</span>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>

          <!-- 3. PAUSA PRANZO (12:25 – 13:50) TRASPARENZA vs PAPINO SOLIDO -->
          {b.lunch.isSpecial ? (
            <div class="solid-lunch-papino">
              <img 
                src={`${baseUrl}/avatars/avatar_riccardo.png`} 
                alt="Papino" 
                class="w-8 h-8 rounded-full object-cover ring-2 ring-amber-300 shadow shrink-0 bg-slate-950"
              />
              <div style="overflow: hidden;">
                <div style="font-size: 0.76rem; font-weight: 900; line-height: 1.15; color: #ffffff;">
                  <span class="lang-it">🏠 12:30 PRANZO CON PAPINO!</span>
                  <span class="lang-en">🏠 12:30 LUNCH WITH DAD!</span>
                </div>
                <div style="font-size: 0.62rem; opacity: 0.95; color: #fef08a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  <span class="lang-it">Uscita 12:30 · Pranzo insieme a casa</span>
                  <span class="lang-en">Early finish 12:30 · Home lunch</span>
                </div>
              </div>
            </div>
          ) : (
            <div class="ghost-lunch-strip">
              <span style="font-size: 0.65rem; color: #94a3b8; display: flex; items-center; gap: 4px;">
                <span>🍽️</span>
                <span class="lang-it">12:25–13:50 Mensa a Scuola</span>
                <span class="lang-en">12:25–13:50 School Lunch</span>
              </span>
              <span style="font-size: 0.58rem; color: #64748b; font-family: 'JetBrains Mono', monospace;">85m</span>
            </div>
          )}

          <!-- 4. LOOK SOLIDO: POMERIGGIO (13:50 – 15:55) -->
          <div class="solid-afternoon-container">
            <div class="solid-block-header solid-header-afternoon">
              <span>
                <span class="lang-it">🌤️ POMERIGGIO</span>
                <span class="lang-en">🌤️ AFTERNOON</span>
              </span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; opacity: 0.85;">13:50–15:55</span>
            </div>
            
            <div class="solid-slots-inner">
              {b.afternoon.map((s) => (
                <div class={`slot-solid-card ${getSubjectClass(s)} ${s.type === 'afternoon_home' ? '' : (isDoublePeriod(s.time) ? 'slot-double-height' : 'slot-single-height')}`}>
                  <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                    <span class="slot-time">{s.time}</span>
                    {s.location && (
                      <span style="font-size: 0.62rem; opacity: 0.85; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        {s.location}
                      </span>
                    )}
                  </div>
                  
                  <div style="display: flex; align-items: center; gap: 6px;">
                    {s.avatarImg && (
                      <img 
                        src={`${baseUrl}${s.avatarImg}`} 
                        alt="Silvana" 
                        class="w-6 h-6 rounded-full object-cover ring-1 ring-purple-300 shadow shrink-0 bg-slate-950"
                      />
                    )}
                    <div class="slot-title">
                      <span class="lang-it">{s.subjectIt}</span>
                      <span class="lang-en">{s.subjectEn}</span>
                    </div>
                  </div>

                  {s.teacher && (
                    <div class="slot-meta">
                      <span class="lang-it">Prof: {s.teacher}</span>
                      <span class="lang-en">Teacher: {s.teacher}</span>
                    </div>
                  )}
                  {(s.notesIt || s.notesEn) && (
                    <div class="slot-meta" style="font-style: italic; opacity: 0.85;">
                      <span class="lang-it">{s.notesIt}</span>
                      <span class="lang-en">{s.notesEn}</span>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>

          <!-- 5. GHOST / TRASPARENZA: COMPITI SERA & EXTRA (In Fondo) -->
          <div class="ghost-evening-card">
            <div class="ghost-evening-header">
              <span>🌙</span>
              <span class="lang-it">COMPITI & EXTRA ({b.extra.time})</span>
              <span class="lang-en">HOMEWORK & EXTRA ({b.extra.time})</span>
            </div>

            {eveningItems.map((item) => (
              <div class="ghost-row">
                <span style="font-size: 0.75rem; flex-shrink: 0;">{item.icon}</span>
                <span style={`flex: 1; ${item.urgent ? 'color: #fef08a; font-weight: 700;' : ''}`}>
                  <span class="lang-it">{item.textIt}</span>
                  <span class="lang-en">{item.textEn}</span>
                </span>
              </div>
            ))}

            {b.extra.hasActivity && (
              <div class="ghost-row" style="color: #a5b4fc; font-weight: 700; border-top: 1px dashed rgba(255, 255, 255, 0.08); padding-top: 2px; margin-top: 1px;">
                <span style="font-size: 0.75rem; flex-shrink: 0;">{b.extra.icon}</span>
                <span style="flex: 1;">
                  <span class="lang-it">{b.extra.titleIt}</span>
                  <span class="lang-en">{b.extra.titleEn}</span>
                </span>
              </div>
            )}
          </div>

        </div>
      );
    })}
  </div>
</div>
