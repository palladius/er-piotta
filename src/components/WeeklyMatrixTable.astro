---
import type { ChildData, ChecklistItem } from '../data/schoolData';

interface Props {
  child: ChildData;
}

const { child } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const daysKeys = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday'];
const dayIndex = new Date().getDay();
const todayKey = dayIndex >= 1 && dayIndex <= 5 ? daysKeys[dayIndex - 1] : 'monday';

function isDoublePeriod(timeStr: string) {
  return timeStr.includes('10:05') || timeStr.includes('12:25') || timeStr.includes('15:35');
}

function getSlotClass(slot: any) {
  if (slot.type === 'break') return 'slot-break';
  if (slot.type === 'dismissal') return 'slot-dismissal';
  if (slot.type === 'afternoon_home') return 'slot-afternoon-silvana';

  const s = (slot.subjectIt || '').toLowerCase();
  if (s.includes('sport') || s.includes('pe') || s.includes('movement')) return 'subject-sport';
  if (s.includes('deutsch') || s.includes('german')) return 'subject-deutsch';
  if (s.includes('math') || s.includes('mathe') || s.includes('wochenplan')) return 'subject-math';
  if (s.includes('english') || s.includes('phonic')) return 'subject-english';
  if (s.includes('french') || s.includes('français')) return 'subject-french';
  if (s.includes('art') || s.includes('tessile') || s.includes('craft')) return 'subject-art';
  if (s.includes('music') || s.includes('singing')) return 'subject-music';
  if (s.includes('enquiry')) return 'subject-enquiry';
  return 'subject-default';
}

function getTagClass(type: string) {
  if (type === 'backpack') return 'tag-backpack';
  if (type === 'homework') return 'tag-homework';
  return 'tag-deadline';
}

// Group checklist items by category / type
function groupChecklist(items: ChecklistItem[]) {
  const groups: { [key: string]: { type: string; categoryLabelIt: string; categoryLabelEn: string; items: ChecklistItem[]; urgent: boolean } } = {};
  
  for (const item of items) {
    const key = item.type;
    if (!groups[key]) {
      groups[key] = {
        type: item.type,
        categoryLabelIt: item.categoryLabelIt,
        categoryLabelEn: item.categoryLabelEn,
        items: [],
        urgent: false
      };
    }
    groups[key].items.push(item);
    if (item.urgent) groups[key].urgent = true;
  }
  return Object.values(groups);
}
---

<div class="calendar-wrapper">
  <div class="calendar-container">

    <!-- 0. Left Time Axis (Google Calendar Style) -->
    <div class="time-axis hidden md:flex">
      <!-- Morning Markers -->
      <div style="height: 295px; display: flex; flex-direction: column; justify-content: space-between; padding: 22px 0 6px 0;">
        <span class="time-axis-label">08:30</span>
        <span class="time-axis-label" style="color: #94a3b8;">10:05 ☕</span>
        <span class="time-axis-label">10:50</span>
        <span class="time-axis-label">12:25</span>
      </div>

      <!-- Lunch Marker -->
      <div style="height: 72px; display: flex; flex-direction: column; justify-content: center;">
        <span class="time-axis-label" style="color: #f59e0b; font-weight: 900;">12:25 🍽️</span>
        <span class="time-axis-label" style="color: #64748b; font-size: 0.58rem;">13:50</span>
      </div>

      <!-- Afternoon Markers -->
      <div style="height: 185px; display: flex; flex-direction: column; justify-content: space-between; padding: 22px 0 6px 0;">
        <span class="time-axis-label">13:50</span>
        <span class="time-axis-label">15:35</span>
        <span class="time-axis-label" style="color: #38bdf8; font-weight: 900;">15:55 🔔</span>
      </div>

      <!-- Extra-Curricular Marker -->
      <div style="height: 82px; display: flex; flex-direction: column; justify-content: center;">
        <span class="time-axis-label" style="color: #a5b4fc; font-weight: 900;">16:00+ 🎭</span>
        <span class="time-axis-label" style="color: #64748b; font-size: 0.58rem;">18:30</span>
      </div>
    </div>

    <!-- 1-5. Mon to Fri 5 Columns -->
    {daysKeys.map((key) => {
      const d = child.days[key];
      const isToday = key === todayKey;
      const b = d.blocks;
      const groupedChecklist = groupChecklist(d.checklist);

      return (
        <div class={`day-column ${isToday ? 'day-column-today' : ''}`}>
          
          <!-- Column Day Header -->
          <div class={`day-column-header ${isToday ? 'day-column-header-today' : ''}`}>
            <div style="display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 2px;">
              <span style="font-size: 1.25rem;">{d.emoji}</span>
              <strong style="font-size: 1rem; color: #ffffff; text-transform: capitalize;">
                <span class="lang-it">{d.dayNameIt.split(' ')[0]}</span>
                <span class="lang-en">{d.dayNameEn.split(' ')[0]}</span>
              </strong>
            </div>
            
            {isToday && (
              <span style="display: inline-block; font-size: 0.65rem; font-weight: 900; text-transform: uppercase; background: #f59e0b; color: #000000; padding: 1px 8px; border-radius: 9999px; margin-bottom: 2px;">
                <span class="lang-it">Oggi</span>
                <span class="lang-en">Today</span>
              </span>
            )}

            <div style="font-size: 0.72rem; color: #94a3b8; font-family: 'JetBrains Mono', monospace;">
              {d.dropOff.split('–')[0].trim()} ➔ {d.pickUpIt.split(' ')[0]}
            </div>
          </div>

          <!-- Duty Strip -->
          <div class="duty-bar">
            <div style="display: flex; align-items: center; justify-content: center; gap: 6px;">
              {d.duty.avatarImg && (
                <img 
                  src={`${baseUrl}${d.duty.avatarImg}`} 
                  alt="Duty" 
                  class="w-5 h-5 rounded-full object-cover ring-1 ring-amber-400/50"
                />
              )}
              <span class={`badge ${d.duty.parent === 'mamma' ? 'badge-purple' : 'badge-amber'}`} style="font-size: 0.7rem; padding: 2px 8px;">
                <span class="lang-it">{d.duty.parentNameIt.split(' ')[1]} ({d.duty.parent === 'mamma' ? 'Kate' : 'Ricc'})</span>
                <span class="lang-en">{d.duty.parentNameEn.split(' ')[1]} ({d.duty.parent === 'mamma' ? 'Kate' : 'Ricc'})</span>
              </span>
            </div>
            {d.duty.afternoonCareIt && (
              <div style="display: flex; align-items: center; gap: 4px;">
                <img 
                  src={`${baseUrl}/avatars/avatar_silvana.png`} 
                  alt="Silvana" 
                  class="w-4 h-4 rounded-full object-cover ring-1 ring-emerald-400/50"
                />
                <span class="badge badge-emerald" style="font-size: 0.68rem; padding: 2px 8px;">
                  <span class="lang-it">{d.duty.afternoonCareIt}</span>
                  <span class="lang-en">{d.duty.afternoonCareEn}</span>
                </span>
              </div>
            )}
          </div>

          <!-- RIGA 1: ZAINO & COMPITI (Aggregated Single Card per Category) -->
          <div class="row-checklist-box">
            {groupedChecklist.map((group) => (
              <div class={`checklist-group-card ${group.urgent ? 'checklist-group-urgent' : ''}`}>
                <div class={`checklist-group-header ${getTagClass(group.type)}`}>
                  <span>
                    <span class="lang-it">{group.categoryLabelIt}</span>
                    <span class="lang-en">{group.categoryLabelEn}</span>
                  </span>
                  {group.urgent && <span style="color: #f59e0b; font-size: 0.6rem;">⚠️</span>}
                </div>
                
                <div class="checklist-group-items">
                  {group.items.map((item) => (
                    <div class="checklist-group-row">
                      <span class="checklist-row-icon">{item.icon}</span>
                      <span class="checklist-row-text">
                        <span class="lang-it">{item.textIt}</span>
                        <span class="lang-en">{item.textEn}</span>
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <!-- RIGA 2: RETTANGOLONE MATTINA (08:30 - 12:25) -->
          <div class="row-morning-container">
            <div class="block-header block-header-morning">
              <span>
                <span class="lang-it">☀️ MATTINO</span>
                <span class="lang-en">☀️ MORNING</span>
              </span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; opacity: 0.8;">08:30–12:25</span>
            </div>
            
            <div class="slots-inner-morning">
              {b.morning.map((s) => (
                <div class={`slot-card ${getSlotClass(s)} ${isDoublePeriod(s.time) ? 'slot-double-period' : 'slot-single-period'}`}>
                  <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                    <span class="slot-time">{s.time}</span>
                    {s.location && (
                      <span style="font-size: 0.62rem; opacity: 0.8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        {s.location}
                      </span>
                    )}
                  </div>
                  <div class="slot-title">
                    <span class="lang-it">{s.subjectIt}</span>
                    <span class="lang-en">{s.subjectEn}</span>
                  </div>
                  {s.teacher && (
                    <div class="slot-meta">
                      <span class="lang-it">Prof: {s.teacher}</span>
                      <span class="lang-en">Teacher: {s.teacher}</span>
                    </div>
                  )}
                  {(s.notesIt || s.notesEn) && (
                    <div class="slot-meta" style="font-style: italic; opacity: 0.85;">
                      <span class="lang-it">{s.notesIt}</span>
                      <span class="lang-en">{s.notesEn}</span>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>

          <!-- RIGA 3: RETTANGOLINO PAUSA PRANZO (12:25 - 13:50) TRASPARENZA vs PAPÀ -->
          <div class={`row-lunch-ribbon ${b.lunch.isSpecial ? 'lunch-home-dad' : 'lunch-school-transparent'}`}>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px;">
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; font-weight: 800; color: #fef08a;">
                {b.lunch.time}
              </span>
              <span style="font-size: 0.62rem; font-weight: 800; text-transform: uppercase; opacity: 0.85; color: #cbd5e1;">
                <span class="lang-it">PRANZO</span>
                <span class="lang-en">LUNCH</span>
              </span>
            </div>

            <div style="display: flex; align-items: center; gap: 6px;">
              {b.lunch.avatarImg ? (
                <img 
                  src={`${baseUrl}${b.lunch.avatarImg}`} 
                  alt="Papino" 
                  class="w-7 h-7 rounded-full object-cover ring-2 ring-amber-400 shadow shrink-0 bg-slate-950"
                />
              ) : (
                <span style="font-size: 1.1rem;">🍽️</span>
              )}
              <div>
                <div style="font-size: 0.74rem; font-weight: 900; line-height: 1.2; color: #ffffff;">
                  <span class="lang-it">{b.lunch.subjectIt}</span>
                  <span class="lang-en">{b.lunch.subjectEn}</span>
                </div>
                {(b.lunch.notesIt || b.lunch.notesEn) && (
                  <div style="font-size: 0.62rem; opacity: 0.85; margin-top: 1px; color: #cbd5e1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 170px;">
                    <span class="lang-it">{b.lunch.notesIt}</span>
                    <span class="lang-en">{b.lunch.notesEn}</span>
                  </div>
                )}
              </div>
            </div>
          </div>

          <!-- RIGA 4: RETTANGOLONE POMERIGGIO (13:50 - 15:55) -->
          <div class="row-afternoon-container">
            <div class="block-header block-header-afternoon">
              <span>
                <span class="lang-it">🌤️ POMERIGGIO</span>
                <span class="lang-en">🌤️ AFTERNOON</span>
              </span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; opacity: 0.8;">13:50–15:55</span>
            </div>
            
            <div class="slots-inner-afternoon">
              {b.afternoon.map((s) => (
                <div class={`slot-card ${getSlotClass(s)} ${s.type === 'afternoon_home' ? '' : (isDoublePeriod(s.time) ? 'slot-double-period' : 'slot-single-period')}`}>
                  <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                    <span class="slot-time">{s.time}</span>
                    {s.location && (
                      <span style="font-size: 0.62rem; opacity: 0.8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        {s.location}
                      </span>
                    )}
                  </div>
                  
                  <div style="display: flex; align-items: center; gap: 6px;">
                    {s.avatarImg && (
                      <img 
                        src={`${baseUrl}${s.avatarImg}`} 
                        alt="Silvana" 
                        class="w-6 h-6 rounded-full object-cover ring-1 ring-purple-400 shadow shrink-0 bg-slate-950"
                      />
                    )}
                    <div class="slot-title">
                      <span class="lang-it">{s.subjectIt}</span>
                      <span class="lang-en">{s.subjectEn}</span>
                    </div>
                  </div>

                  {s.teacher && (
                    <div class="slot-meta">
                      <span class="lang-it">Prof: {s.teacher}</span>
                      <span class="lang-en">Teacher: {s.teacher}</span>
                    </div>
                  )}
                  {(s.notesIt || s.notesEn) && (
                    <div class="slot-meta" style="font-style: italic; opacity: 0.85;">
                      <span class="lang-it">{s.notesIt}</span>
                      <span class="lang-en">{s.notesEn}</span>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>

          <!-- RIGA 5: EXTRA-CURRICULARI & DOPO SCUOLA (16:00+) -->
          <div class="row-extra-container">
            <div class="block-header block-header-extra">
              <span>
                <span class="lang-it">⭐ DOPO SCUOLA & EXTRA</span>
                <span class="lang-en">⭐ AFTER SCHOOL & EXTRA</span>
              </span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; opacity: 0.8;">{b.extra.time}</span>
            </div>

            <div class="extra-card-content">
              <div class={b.extra.hasActivity ? 'extra-has-activity' : 'extra-relax'}>
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                  <span style="font-size: 0.76rem; font-weight: 800; color: #ffffff; display: flex; align-items: center; gap: 5px;">
                    <span>{b.extra.icon}</span>
                    <span>
                      <span class="lang-it">{b.extra.titleIt}</span>
                      <span class="lang-en">{b.extra.titleEn}</span>
                    </span>
                  </span>
                </div>
                
                <div style="font-size: 0.65rem; color: #cbd5e1; opacity: 0.9; margin-top: 2px;">
                  <span class="lang-it">{b.extra.notesIt}</span>
                  <span class="lang-en">{b.extra.notesEn}</span>
                </div>

                <div style="font-size: 0.6rem; color: #a5b4fc; font-weight: 700; margin-top: 1px;">
                  <span class="lang-it">Gestione: {b.extra.managedByIt}</span>
                  <span class="lang-en">Manager: {b.extra.managedByEn}</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      );
    })}
  </div>
</div>
