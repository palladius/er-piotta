---
import type { ChildData } from '../data/schoolData';

interface Props {
  child: ChildData;
}

const { child } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullPdfUrl = `${baseUrl}${child.pdfUrl}`;
---

<div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-5 md:p-6 shadow-2xl mb-8 relative overflow-hidden">
  <!-- Subtle Background Glow -->
  <div class={`absolute top-0 right-0 w-64 h-64 ${child.id === 'ale' ? 'bg-blue-600/10' : 'bg-emerald-600/10'} rounded-full blur-3xl -mr-20 -mt-20 pointer-events-none`}></div>

  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 relative z-10">
    <!-- Circular Avatar with Animated Border -->
    <div class="relative group">
      <div class={`w-20 h-20 md:w-24 md:h-24 rounded-full ${child.avatarBg} flex items-center justify-center text-4xl md:text-5xl shadow-xl ring-4 ${child.id === 'ale' ? 'ring-blue-500/40' : 'ring-emerald-500/40'} group-hover:scale-105 transition-transform`}>
        {child.avatarEmoji}
      </div>
      <div class="absolute -bottom-1 -right-1 bg-slate-950 px-2 py-0.5 rounded-full text-[10px] font-black tracking-wider text-amber-400 border border-slate-700 uppercase shadow">
        {child.id === 'ale' ? 'P3' : 'P1'}
      </div>
    </div>

    <!-- Details -->
    <div class="text-center sm:text-left flex-1">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-1">
        <h2 class="text-2xl md:text-3xl font-black text-white">{child.name}</h2>
        <span class={`text-xs px-2.5 py-1 rounded-full font-bold ${child.id === 'ale' ? 'bg-blue-500/20 text-blue-300 border border-blue-500/30' : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'}`}>
          {child.grade}
        </span>
      </div>

      <p class="text-sm text-slate-300 font-medium mb-3">
        👩‍🏫 Insegnanti: <span class="text-amber-300">{child.classTeacher}</span>
      </p>

      <!-- Standard Times & Download Button Row -->
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 text-xs">
        <div class="bg-slate-800/80 px-3 py-1.5 rounded-xl border border-slate-700 flex items-center gap-1.5 text-slate-200">
          <i class="fa-solid fa-bell text-amber-400"></i>
          <span>Portare a scuola: <strong class="text-white">08:15 – 08:30</strong></span>
        </div>
        <div class="bg-slate-800/80 px-3 py-1.5 rounded-xl border border-slate-700 flex items-center gap-1.5 text-slate-200">
          <i class="fa-solid fa-clock text-amber-400"></i>
          <span>Uscita: <strong class="text-white">15:55</strong> (Mercoledì: <strong class="text-emerald-400">12:30</strong>)</span>
        </div>

        <!-- Downloadable PDF Button -->
        <a href={fullPdfUrl} download target="_blank" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 px-3.5 py-1.5 rounded-xl font-bold border border-amber-400 flex items-center gap-2 shadow-lg shadow-amber-500/20 hover:scale-105 transition">
          <i class="fa-solid fa-file-pdf text-slate-950"></i>
          <span>{child.pdfLabel}</span>
        </a>
      </div>
    </div>
  </div>
</div>
