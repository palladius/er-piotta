---
import type { ChildData } from '../data/schoolData';

interface Props {
  child: ChildData;
}

const { child } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullPdfUrl = `${baseUrl}${child.pdfUrl}`;
---

<div class="glass-panel p-3.5 md:p-4 mb-4 flex flex-wrap items-center justify-between gap-3">
  <!-- Left: Child Info & Teachers -->
  <div class="flex items-center space-x-3">
    <div class={`w-12 h-12 rounded-xl ${child.avatarBg} flex items-center justify-center text-2xl shadow-md ring-2 ${child.id === 'ale' ? 'ring-blue-500/40' : 'ring-emerald-500/40'} shrink-0`}>
      {child.avatarEmoji}
    </div>
    <div>
      <div class="flex items-center gap-2">
        <h2 class="text-lg md:text-xl font-black text-white">{child.name}</h2>
        <span class={`badge ${child.id === 'ale' ? 'badge-blue' : 'badge-emerald'}`}>
          {child.grade}
        </span>
      </div>
      <p class="text-xs text-slate-300">
        👩‍🏫 Insegnanti: <strong class="text-amber-300">{child.classTeacher}</strong>
      </p>
    </div>
  </div>

  <!-- Right: Times & PDF Download -->
  <div class="flex flex-wrap items-center gap-2.5">
    <div class="bg-slate-950/80 px-3 py-1.5 rounded-lg border border-slate-800 text-xs text-slate-300 flex items-center gap-1.5">
      <i class="fa-solid fa-bell text-amber-400"></i>
      <span>Entrata: <strong class="text-white font-mono">08:15–08:30</strong></span>
    </div>
    <div class="bg-slate-950/80 px-3 py-1.5 rounded-lg border border-slate-800 text-xs text-slate-300 flex items-center gap-1.5">
      <i class="fa-solid fa-clock text-amber-400"></i>
      <span>Uscita: <strong class="text-white font-mono">15:55</strong> (Mer: <strong class="text-emerald-400 font-mono">12:30</strong>)</span>
    </div>
    <a href={fullPdfUrl} download target="_blank" class="btn-download">
      <i class="fa-solid fa-file-pdf"></i>
      <span>{child.pdfLabel}</span>
    </a>
  </div>
</div>
