---
import type { ChildData } from '../data/schoolData';

interface Props {
  child: ChildData;
}

const { child } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullPdfUrl = `${baseUrl}${child.pdfUrl}`;
---

<div class="glass-panel p-6 md:p-8 mb-8 relative overflow-hidden">
  <!-- Dynamic Gradient Accent Ring -->
  <div class={`absolute top-0 right-0 w-80 h-80 ${child.id === 'ale' ? 'bg-blue-600/15' : 'bg-emerald-600/15'} rounded-full blur-3xl -mr-20 -mt-20 pointer-events-none`}></div>

  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 relative z-10">
    <!-- Big Tactile Avatar Badge -->
    <div class="relative group shrink-0">
      <div class={`w-24 h-24 md:w-28 md:h-28 rounded-3xl ${child.avatarBg} flex items-center justify-center text-5xl md:text-6xl shadow-2xl ring-4 ${child.id === 'ale' ? 'ring-blue-500/40' : 'ring-emerald-500/40'} group-hover:scale-105 transition-transform duration-300`}>
        {child.avatarEmoji}
      </div>
      <div class="absolute -bottom-2 -right-2 bg-slate-950 px-2.5 py-1 rounded-xl text-xs font-black tracking-wider text-amber-400 border border-slate-700 uppercase shadow-lg">
        {child.id === 'ale' ? 'P3' : 'P1'}
      </div>
    </div>

    <!-- Child Details & Quick Actions -->
    <div class="text-center sm:text-left flex-1 space-y-3">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5">
        <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">{child.name}</h2>
        <span class={`badge ${child.id === 'ale' ? 'badge-blue' : 'badge-emerald'}`}>
          {child.grade}
        </span>
      </div>

      <p class="text-sm text-slate-300 font-medium leading-relaxed">
        👩‍🏫 Insegnanti: <strong class="text-amber-300">{child.classTeacher}</strong>
      </p>

      <!-- Standard Times & Download Button Row -->
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 pt-1">
        <div class="bg-slate-900/90 px-3.5 py-2 rounded-xl border border-slate-700/80 flex items-center gap-2 text-xs text-slate-200 shadow-sm">
          <i class="fa-solid fa-bell text-amber-400"></i>
          <span>Entrata: <strong class="text-white font-mono">08:15 – 08:30</strong></span>
        </div>
        <div class="bg-slate-900/90 px-3.5 py-2 rounded-xl border border-slate-700/80 flex items-center gap-2 text-xs text-slate-200 shadow-sm">
          <i class="fa-solid fa-clock text-amber-400"></i>
          <span>Uscita: <strong class="text-white font-mono">15:55</strong> (Mercoledì: <strong class="text-emerald-400 font-mono">12:30</strong>)</span>
        </div>

        <!-- Downloadable PDF Button -->
        <a href={fullPdfUrl} download target="_blank" class="btn-download">
          <i class="fa-solid fa-file-pdf"></i>
          <span>{child.pdfLabel}</span>
        </a>
      </div>
    </div>
  </div>
</div>
