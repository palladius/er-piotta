---
import type { DaySchedule } from '../data/schoolData';

interface Props {
  day: DaySchedule;
  isToday?: boolean;
}

const { day, isToday = false } = Astro.props;
---

<div class={`bg-slate-900 border ${isToday ? 'border-amber-400/80 ring-2 ring-amber-400/30' : 'border-slate-800'} rounded-3xl p-5 shadow-xl transition hover:border-slate-700 space-y-4`}>

  <!-- Header: Day Name + Times + Parent Duty -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-800">
    <div class="flex items-center space-x-3">
      <span class="text-3xl">{day.emoji}</span>
      <div>
        <div class="flex items-center gap-2">
          <h3 class="text-xl font-bold text-white">{day.dayName}</h3>
          {isToday && (
            <span class="text-[10px] uppercase font-black tracking-wider bg-amber-400 text-slate-950 px-2 py-0.5 rounded-full">
              Oggi
            </span>
          )}
        </div>
        <p class="text-xs text-slate-400 font-mono">
          Entrata: <span class="text-slate-200">{day.dropOff}</span> · Uscita: <span class="text-slate-200">{day.pickUp}</span>
        </p>
      </div>
    </div>

    <!-- Parent Duty Badge -->
    <div class="flex flex-col sm:items-end gap-1">
      <span class={`text-xs px-3 py-1 rounded-full font-bold shadow-sm ${day.duty.badgeColor}`}>
        {day.duty.parentName}
      </span>
      {day.duty.afternoonCare && (
        <span class="text-[11px] font-bold text-amber-300 bg-amber-950/60 border border-amber-800/80 px-2.5 py-0.5 rounded-full">
          {day.duty.afternoonCare}
        </span>
      )}
    </div>
  </div>

  <!-- SECTION IN CIMA: Cose da Portare & Scadenze Necessarie -->
  <div class="bg-slate-950/70 border border-slate-800/90 rounded-2xl p-3.5 space-y-2">
    <div class="flex items-center justify-between">
      <span class="text-[11px] font-black uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
        <i class="fa-solid fa-backpack"></i> Cose da Portare & Scadenze del Giorno
      </span>
      <span class="text-[10px] text-slate-500 font-mono">Check prima di uscire</span>
    </div>

    <div class="space-y-1.5">
      {day.gearAndDeadlines.map((item) => (
        <div class={`flex items-start space-x-2.5 p-2 rounded-xl text-xs md:text-sm font-medium ${item.urgent ? 'bg-amber-500/15 border border-amber-500/30 text-amber-200 font-bold pulse-urgent' : 'bg-slate-900/80 border border-slate-800 text-slate-300'}`}>
          <span class="text-base leading-none">{item.icon}</span>
          <span class="flex-1 leading-snug">{item.text}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Lezioni Pulite (Senza Pause né Welcome Time) -->
  <div class="space-y-2">
    <span class="text-[11px] font-black uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
      <i class="fa-solid fa-graduation-cap"></i> Materie & Orario Lezioni
    </span>

    <div class="space-y-1.5">
      {day.schedule.map((slot) => (
        <div class="bg-slate-800/60 border border-slate-800 rounded-xl p-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-slate-800/90 transition">
          <div class="flex items-start sm:items-center space-x-3">
            <span class="font-mono text-xs font-bold text-amber-400 bg-slate-900/90 px-2.5 py-1 rounded-lg border border-slate-700 whitespace-nowrap">
              {slot.time}
            </span>
            <div>
              <div class="font-bold text-white text-sm md:text-base flex items-center gap-2">
                <span>{slot.subject}</span>
              </div>
              {slot.teacher && (
                <p class="text-xs text-slate-400">
                  Prof: <span class="text-slate-300 font-medium">{slot.teacher}</span> {slot.location && <span>· Aula: {slot.location}</span>}
                </p>
              )}
            </div>
          </div>

          {slot.notes && (
            <div class="text-xs text-slate-300 bg-slate-900/80 px-2.5 py-1 rounded-lg border border-slate-700/60 sm:text-right font-medium">
              {slot.notes}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

</div>
