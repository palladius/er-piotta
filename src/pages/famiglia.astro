---
import Layout from '../layouts/Layout.astro';
import FamilyMatrixTable from '../components/FamilyMatrixTable.astro';
import { ALESSANDRO_DATA, SEBASTIAN_DATA } from '../data/schoolData';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Vista Famiglia (Ale & Sebi)" activeTab="famiglia">
  <!-- Family Header Bar -->
  <div class="glass-panel p-3.5 md:p-4 mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center space-x-3">
      <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-indigo-700 flex items-center justify-center text-2xl shadow-md ring-2 ring-purple-500/40">
        👥
      </div>
      <div>
        <h2 class="text-lg md:text-xl font-black text-white">Carlesso Family Weekly Matrix</h2>
        <p class="text-xs text-slate-300">
          Confronto parallelo di Alessandro (P3) e Sebastian (P1) per tutta la settimana
        </p>
      </div>
    </div>

    <!-- Direct PDF Downloads -->
    <div class="flex flex-wrap items-center gap-2">
      <a href={`${baseUrl}${ALESSANDRO_DATA.pdfUrl}`} download target="_blank" class="btn-download">
        <i class="fa-solid fa-file-pdf"></i>
        <span>PDF Ale (P3)</span>
      </a>
      <a href={`${baseUrl}${SEBASTIAN_DATA.pdfUrl}`} download target="_blank" class="btn-download">
        <i class="fa-solid fa-file-pdf"></i>
        <span>PDF Sebi (P1)</span>
      </a>
    </div>
  </div>

  <!-- Full 5-Day Comparison Table -->
  <FamilyMatrixTable />
</Layout>
