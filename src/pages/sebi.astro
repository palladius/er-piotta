---
import Layout from '../layouts/Layout.astro';
import ChildHero from '../components/ChildHero.astro';
import DayScheduleCard from '../components/DayScheduleCard.astro';
import { SEBASTIAN_DATA } from '../data/schoolData';

const daysOrder = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday'];
const dayIndex = new Date().getDay();
const currentDayKey = dayIndex >= 1 && dayIndex <= 5 ? daysOrder[dayIndex - 1] : 'monday';
---

<Layout title="Sebastian (Primary 1)" activeTab="sebi">
  <!-- Child Hero Header -->
  <ChildHero child={SEBASTIAN_DATA} />

  <!-- Quick Day Selector Pills -->
  <div class="flex items-center justify-between gap-2 overflow-x-auto pb-4 mb-2">
    {daysOrder.map((key) => {
      const d = SEBASTIAN_DATA.days[key];
      return (
        <a href={`#${key}`} class="flex-1 min-w-[100px] p-2.5 bg-slate-900 border border-slate-800 hover:border-emerald-500 rounded-2xl text-center transition flex flex-col items-center justify-center group">
          <span class="text-xl group-hover:scale-110 transition">{d.emoji}</span>
          <span class="text-xs font-bold text-slate-300 mt-1">{d.dayName.split(' ')[0]}</span>
          <span class="text-[10px] text-slate-500 font-mono">{d.dropOff.split('–')[0].trim()}</span>
        </a>
      );
    })}
  </div>

  <!-- Weekly Matrix Cards -->
  <div class="space-y-6">
    {daysOrder.map((key) => {
      const d = SEBASTIAN_DATA.days[key];
      return (
        <div id={key} class="scroll-mt-24">
          <DayScheduleCard day={d} isToday={key === currentDayKey} />
        </div>
      );
    })}
  </div>
</Layout>
