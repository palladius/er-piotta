function renderSimpleMarkdown(md: string): string {
  if (!md) return '';
  const escaped = md
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  const inlined = escaped
    .replace(
      /\[\[AUTO_TRANSLATED_DE_EN_V1\.2\.3\]\]/g,
      '<div class="de-trans-banner">auto-translated from DE to EN from Er Piotta v1.2.3</div>'
    )
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/(^|\n)\*([^*\n]+)\*(?=\n|$)/g, '$1<em class="de-italic-line">$2</em>')
    .replace(/\*([^*\n]+)\*/g, '<em>$1</em>')
    .replace(/\[([^\]]+)\]\(#item:([^\s)]+)\)/g, '<a href="#item:$2" data-open-item="$2" class="magic-item-link">$1</a>')
    .replace(
      /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)|(?<!["'=])(https?:\/\/[^\s<*)]+)/g,
      (_match, label, mdUrl, bareUrl) => {
        const url = (mdUrl || bareUrl || '').replace(/[.,;]+$/, '');
        const text = (label || url).trim();
        const isPhoto = url.includes('photos.app.goo.gl') || url.includes('photos.google.com') || url.includes('drive.google.com/drive/folders');
        const cls = isPhoto ? 'ext-photo-link' : 'ext-normal-link';
        const prefix = isPhoto && !text.includes('📸') ? '📸 ' : '';
        return `<a href="${url}" target="_blank" rel="noopener noreferrer" class="${cls}">${prefix}${text} ↗</a>`;
      }
    )
    .replace(/(^|\n)---(?=\n|$)/g, '$1<hr class="de-trans-divider" />');

  return inlined
    .split(/\n{2,}/)
    .map((block) => {
      const lines = block.split('\n').filter(l => l.trim().length > 0);
      if (lines.length > 0 && lines.every(l => l.trim().startsWith('- '))) {
        const lis = lines.map(l => `<li>${l.trim().slice(2)}</li>`).join('');
        return `<ul class="md-bullet-list">${lis}</ul>`;
      }
      return `<p>${block.replace(/\n/g, '<br/>')}</p>`;
    })
    .join('');
}

