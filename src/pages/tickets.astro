<Layout title="Inbox & Action Tickets — Tandem IMS (Ale & Seby)" activeTab="tickets">
  <div class="gmail-shell">
    <!-- Top Header with Parent Identity & Sync Info -->
    <header class="inbox-topbar">
      <div class="inbox-brand">
        <div class="brand-title-row">
          <span class="gmail-logo-icon" aria-hidden="true">📬</span>
          <h1>Piota Gmail View</h1>
          <span class="version-pill">Post-Piota v0.5 · Auto-Archive +7g</span>
        </div>
        <p class="brand-subtitle">
          Inbox unificata <code>tandemims30@gmail.com</code> + Calendari Classi <strong>🐉 Ale (P3)</strong> &amp; <strong>🚗 Seb (P1)</strong>
        </p>
      </div>

      <!-- Active Parent Switcher -->
      <div class="parent-identity-bar">
        <fieldset class="identity-fieldset">
          <legend class="sr-only">Seleziona chi sta usando l'app</legend>
          <span class="identity-label">Sono:</span>
          <label class="identity-radio-label" id="lbl-user-riccardo">
            <input type="radio" name="active-parent-user" value="riccardo" checked />
            <img src="/er-piotta/images/family/riccardo.jpg" alt="" class="parent-mini-avatar" />
            <span>Ricc</span>
          </label>
          <label class="identity-radio-label" id="lbl-user-kate">
            <input type="radio" name="active-parent-user" value="kate" />
            <img src="/er-piotta/images/family/kate.jpg" alt="" class="parent-mini-avatar" />
            <span>Kate</span>
          </label>
        </fieldset>
      </div>
    </header>

    <!-- Teacher Legend Strip -->
    <section class="teacher-legend" aria-label="Insegnanti e Filtri Rapidi Mittente">
      <button type="button" class="teacher-chip active" data-sender-filter="all">
        <span>✨ Tutti i Mittenti</span>
      </button>
      <button type="button" class="teacher-chip" data-sender-filter="biehl">
        <span class="t-avatar" style="background: linear-gradient(135deg, #1e293b, #dc2626);">MB</span>
        <span>🇩🇪🧮 Herr Biehl <small>(🐉 Ale P3)</small></span>
      </button>
      <button type="button" class="teacher-chip" data-sender-filter="penrose">
        <span class="t-avatar" style="background: linear-gradient(135deg, #1d4ed8, #7c3aed);">JP</span>
        <span>🇬🇧🎵 Miss Penrose <small>(🐉 Ale P3)</small></span>
      </button>
      <button type="button" class="teacher-chip" data-sender-filter="rayment">
        <span class="t-avatar" style="background: linear-gradient(135deg, #0369a1, #ec4899);">GR</span>
        <span>🇬🇧📚 Miss Rayment <small>(🚗 Seb P1)</small></span>
      </button>
      <button type="button" class="teacher-chip" data-sender-filter="faux">
        <span class="t-avatar" style="background: linear-gradient(135deg, #b91c1c, #d97706);">XF</span>
        <span>🇩🇪🎨 Frau Faux <small>(🚗 Seb P1)</small></span>
      </button>
      <button type="button" class="teacher-chip" data-sender-filter="tandem">
        <span class="t-avatar" style="background: linear-gradient(135deg, #dc2626, #991b1b);">TI</span>
        <span>🇨🇭🏫 Tandem Admin <small>(🐉🚗 A+S)</small></span>
      </button>
    </section>

    <!-- Semantic <search> landmark per Modern Web Guidance -->
    <search class="gmail-toolbar" aria-label="Filtra e cerca comunicazioni scolastiche">
      <div class="tab-strip" role="tablist" aria-label="Viste Inbox">
        <button type="button" class="inbox-tab active" data-tab="inbox">
          📥 Attivi <span class="tab-badge" id="count-inbox">0</span>
        </button>
        <button type="button" class="inbox-tab" data-tab="action">
          ⚡ Richiede Azione <span class="tab-badge badge-urgent" id="count-action">0</span>
        </button>
        <button type="button" class="inbox-tab" data-tab="notes">
          📝 Con Nota <span class="tab-badge badge-note" id="count-notes">0</span>
        </button>
        <button type="button" class="inbox-tab" data-tab="mine">
          🙋🏻‍♂️ Miei Ticket <span class="tab-badge" id="count-mine">0</span>
        </button>
        <button type="button" class="inbox-tab" data-tab="archived">
          🗄️ Auto-Archiviati (+7g) <span class="tab-badge" id="count-archived">0</span>
        </button>
      </div>

      <div class="toolbar-right">
        <!-- Category Filter Strip (Homework vs Test vs Biblio vs Trip vs Foto vs Admin) -->
        <div class="cat-filter-group" role="group" aria-label="Filtra per categoria">
          <button type="button" class="cat-pill-btn active" data-cat="all">Tutte</button>
          <button type="button" class="cat-pill-btn" data-cat="homework" title="Compiti a casa">📝 HW</button>
          <button type="button" class="cat-pill-btn" data-cat="test" title="Test e Verifiche">🎯 Test</button>
          <button type="button" class="cat-pill-btn" data-cat="library" title="Biblioteca">📚 Biblio</button>
          <button type="button" class="cat-pill-btn" data-cat="trip" title="Gite, Sport ed Eventi">🎒 Eventi</button>
          <button type="button" class="cat-pill-btn" data-cat="photos" title="Album Foto">📸 Foto</button>
          <button type="button" class="cat-pill-btn" data-cat="admin" title="Orari, Calendari e Admin">📅 Admin</button>
        </div>

        <!-- 3-char Kid Filter with 🐉 (Ale) and 🚗 (Seby) -->
        <div class="kid-filter-group" role="group" aria-label="Filtra per figlio">
          <button type="button" class="kid-pill-btn active" data-kid="all">Tutti</button>
          <button type="button" class="kid-pill-btn kid-ale" data-kid="Ale">🐉 Ale</button>
          <button type="button" class="kid-pill-btn kid-seb" data-kid="Seb">🚗 Seb</button>
          <button type="button" class="kid-pill-btn kid-both" data-kid="A+S">🐉🚗 A+S</button>
        </div>

        <div class="search-input-wrap">
          <label for="gmail-search-input" class="sr-only">Cerca per titolo, nota o insegnante</label>
          <input
            type="search"
            id="gmail-search-input"
            placeholder="🔍 Cerca email, compiti, note..."
            autocomplete="off"
          />
        </div>
      </div>
    </search>

    <!-- Column Header Legend (Fixed-width style matching piota-cli) -->
    <div class="gmail-list-header" aria-hidden="true">
      <div class="col-hdr-sender">MITTENTE &amp; MATERIA</div>
      <div class="col-hdr-kid">KID</div>
      <div class="col-hdr-dates">CREATO/DATA · AUTO-ARCHIVE</div>
      <div class="col-hdr-subject">NATURA · CAT · OGGETTO, DETTAGLIO &amp; NOTE</div>
      <div class="col-hdr-right">OWNER (RICC / KATE / —) &amp; NOTA</div>
    </div>

    <!-- Gmail Rows Container -->
    <div class="gmail-list" id="gmail-list-container" role="list">
      {enrichedItems.map((item: any) => {
        const initOwner = String(item.ticket?.owner || 'unassigned').toLowerCase();
        const normOwner = initOwner.startsWith('ric') ? 'riccardo' : (initOwner.startsWith('kat') ? 'kate' : 'unassigned');
        const initNote = String(item.ticket?.note || '').trim();
        const isAction = item.nature === 'action_required';

        return (
          <article
            class={`gmail-row ${isAction ? 'row-action' : ''} ${initNote ? 'has-note' : ''}`}
            role="listitem"
            data-id={item.id}
            data-type={item.type}
            data-kid={item.kidCode}
            data-sender={item.sender.key}
            data-nature={item.nature}
            data-cat={item.cat.catKey}
            data-owner={normOwner}
            data-note={initNote}
            data-auto-expired={item.isAutoExpired ? 'true' : 'false'}
            data-archived={item.isManuallyArchived ? 'true' : 'false'}
            data-read-riccardo={item.consumption?.read_by_riccardo ? 'true' : 'false'}
            data-read-kate={item.consumption?.read_by_kate ? 'true' : 'false'}
            data-title={item.cleanTitle}
            data-sender-label={`${item.sender.emoji} ${item.sender.name} (${item.sender.role})`}
            data-dates-label={`${item.cat.natureEmoji} ${item.cat.natureCode} · ${item.cat.catEmoji} ${item.cat.catLabel} · Data: ${item.ymdCreated} · Auto-Archive: ${item.ymdAutoArchive}`}
            data-source-url={item.source_url || ''}
          >
            <!-- 1. Sender Avatar + Country/Subject Emoji + Name -->
            <div class="cell-sender">
              <button
                type="button"
                class="read-dot-btn"
                data-action="toggle-read"
                title="Segna come letto / da leggere"
                aria-label={`Segna ${item.cleanTitle} come letto o non letto`}
              >
                <span class="unread-dot"></span>
              </button>

              <div class="sender-avatar-wrap" title={`${item.sender.name} (${item.sender.email}) — ${item.sender.role}`}>
                <div class="sender-avatar" style={`background: ${item.sender.bgGradient};`}>
                  <span class="sender-initials">{item.sender.initials}</span>
                </div>
                <span class="sender-emoji-badge" aria-hidden="true">{item.sender.emoji}</span>
              </div>

              <div class="sender-text-meta">
                <span class="sender-name-line">{item.sender.shortName}</span>
                <span class="sender-role-line">{item.sender.emoji} {item.sender.role}</span>
              </div>
            </div>

            <!-- 2. Kid Badge with 🐉 (Ale) / 🚗 (Seb) / 🐉🚗 (A+S) -->
            <div class="cell-kid">
              <span class={`kid-badge3 kid-badge-${item.kidCode === 'Ale' ? 'ale' : (item.kidCode === 'Seb' ? 'seb' : 'both')}`}>
                {item.kidCode === 'Ale' ? '🐉 Ale' : (item.kidCode === 'Seb' ? '🚗 Seb' : '🐉🚗 A+S')}
              </span>
            </div>

            <!-- 3. Fixed-Width Dates: YYYYMMDD(Ven) + Auto-Archive YYYYMMDD(+Ng) -->
            <div class="cell-dates">
              <span class="date-created" title="Data creazione / evento">{item.ymdCreated}</span>
              <span
                class={`date-archive ${item.daysUntilArchive <= 2 ? 'archive-soon' : ''}`}
                title="Scadenza Auto-Archive (+7 giorni dopo il compito/evento)"
              >
                ⏳ {item.ymdAutoArchive}
              </span>
            </div>

            <!-- 4. Subject + Snippet + Inline Yellow Note Pill (Click opens full reader modal) -->
            <div class="cell-content" data-action="open-detail" tabindex="0" role="button" aria-label={`Leggi ${item.cleanTitle}`}>
              <div class="subject-line">
                <span
                  class={`nat-badge ${isAction ? 'nat-act' : 'nat-fyi'}`}
                  title={isAction ? 'Action Required: richiede azione' : 'FYI: solo informativo'}
                >
                  {item.cat.natureEmoji} {item.cat.natureCode}
                </span>
                <span
                  class={`cat-badge cat-${item.cat.catKey}`}
                  title={`Categoria: ${item.cat.catLabel}`}
                >
                  {item.cat.catEmoji} {item.cat.catCode}
                </span>
                <span class="subject-title">{item.cleanTitle}</span>
                {item.snippet && <span class="subject-snippet">— {item.snippet}</span>}
              </div>

              <!-- Sticky Note Pill (visible whenever a note is attached) -->
              <div class={`note-inline-pill ${initNote ? '' : 'hidden'}`} data-role="note-pill">
                <span class="note-pill-icon">📝</span>
                <span class="note-pill-text" data-role="note-text">{initNote}</span>
              </div>

              <!-- Hidden rendered HTML for modal reader -->
              <template class="item-body-template">
                <div class="rendered-markdown" set:html={item.renderedBody} />
              </template>
            </div>

            <!-- 5. Right-side Controls: Owner 3-way Radio (Ricc / Kate / —) + Note Button + Archive -->
            <div class="cell-controls">
              <fieldset class="owner-segmented" aria-label={`Owner per ${item.cleanTitle}`}>
                <legend class="sr-only">Owner</legend>
                <label class={`owner-opt opt-ricc ${normOwner === 'riccardo' ? 'selected' : ''}`} title="Assegna a Riccardo">
                  <input
                    type="radio"
                    name={`owner-${item.id}`}
                    value="riccardo"
                    checked={normOwner === 'riccardo'}
                    data-action="change-owner"
                  />
                  <img src="/er-piotta/images/family/riccardo.jpg" alt="" class="owner-mini-pic" />
                  <span>Ricc</span>
                </label>

                <label class={`owner-opt opt-kate ${normOwner === 'kate' ? 'selected' : ''}`} title="Assegna a Kate">
                  <input
                    type="radio"
                    name={`owner-${item.id}`}
                    value="kate"
                    checked={normOwner === 'kate'}
                    data-action="change-owner"
                  />
                  <img src="/er-piotta/images/family/kate.jpg" alt="" class="owner-mini-pic" />
                  <span>Kate</span>
                </label>

                <label class={`owner-opt opt-none ${normOwner === 'unassigned' ? 'selected' : ''}`} title="Nessun owner">
                  <input
                    type="radio"
                    name={`owner-${item.id}`}
                    value="unassigned"
                    checked={normOwner === 'unassigned'}
                    data-action="change-owner"
                  />
                  <span>—</span>
                </label>
              </fieldset>

              <button
                type="button"
                class={`btn-note ${initNote ? 'has-note-btn' : ''}`}
                data-action="open-note"
                title={initNote ? `Modifica nota: ${initNote}` : 'Aggiungi una nota'}
                aria-label={`Nota per ${item.cleanTitle}`}
              >
                📝 <span class="btn-note-label">{initNote ? 'Nota' : '+Nota'}</span>
              </button>

              <button
                type="button"
                class="btn-archive-row"
                data-action="toggle-archive"
                title="Archivia / Ripristina"
                aria-label={`Archivia ${item.cleanTitle}`}
              >
                🗄️
              </button>
            </div>
          </article>
        );
      })}
    </div>

    <div id="empty-inbox-banner" class="empty-inbox hidden">
      <p>🎉 Nessun messaggio o compito in questa vista!</p>
    </div>
  </div>

  <!-- Native <dialog> for Reading Full Email / Event & Editing Note -->
  <dialog id="detail-dialog" class="piota-dialog" closedby="any" aria-labelledby="dialog-title">
    <div class="dialog-header">
      <div class="dialog-meta-top">
        <span id="dialog-sender-badge" class="dialog-sender-pill"></span>
        <span id="dialog-dates-badge" class="dialog-dates-pill"></span>
      </div>
      <h2 id="dialog-title">Dettaglio Comunicazione</h2>
      <form method="dialog">
        <button type="submit" class="dialog-close-btn" aria-label="Chiudi finestra">✕</button>
      </form>
    </div>

    <div class="dialog-body" id="dialog-body-content"></div>

    <div class="dialog-note-box">
      <label for="dialog-note-input" class="dialog-note-label">📝 Nota di Famiglia (Ricc &amp; Kate — salvata su Cloud Firestore):</label>
      <div class="dialog-note-row">
        <input
          type="text"
          id="dialog-note-input"
          placeholder="Es. Firmato e messo nello zaino blu, oppure studiare p. 11..."
        />
        <button type="button" id="dialog-save-note-btn" class="btn-primary-save">Salva Nota</button>
      </div>
    </div>

    <div class="dialog-footer">
      <a id="dialog-source-link" href="#" target="_blank" rel="noopener noreferrer" class="source-ext-link hidden">
        🔗 Apri in Gmail originale
      </a>
      <form method="dialog">
        <button type="submit" class="btn-secondary-close">Chiudi (Esc)</button>
      </form>
    </div>
  </dialog>

  <!-- Quick Note Editor <dialog> when clicking 📝 +Nota directly on a row -->
  <dialog id="quick-note-dialog" class="piota-dialog note-only-dialog" closedby="any" aria-labelledby="quick-note-heading">
    <form id="quick-note-form">
      <div class="dialog-header">
        <h2 id="quick-note-heading">📝 Nota per questo elemento</h2>
        <button type="button" id="quick-note-cancel" class="dialog-close-btn" aria-label="Chiudi">✕</button>
      </div>
      <p id="quick-note-subtitle" class="quick-note-sub"></p>
      <div class="dialog-note-box">
        <label for="quick-note-textarea" class="dialog-note-label">Testo della nota (visibile nella riga Gmail e in <code>piota-cli list</code>):</label>
        <textarea id="quick-note-textarea" rows="3" placeholder="Scrivi qui un promemoria per Ricc o Kate..."></textarea>
      </div>
      <div class="dialog-footer">
        <button type="button" id="quick-note-clear-btn" class="btn-danger-clear">🗑️ Rimuovi Nota</button>
        <div class="footer-right-btns">
          <button type="button" id="quick-note-close-btn" class="btn-secondary-close">Annulla</button>
          <button type="submit" class="btn-primary-save">💾 Salva Nota</button>
        </div>
      </div>
    </form>
  </dialog>
</Layout>

