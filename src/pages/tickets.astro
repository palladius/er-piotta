  .gmail-row:last-child {
    border-bottom: none;
  }

  .gmail-row:hover {
    background: #f8fafc;
  }

  .gmail-row.is-unread {
    background: #ffffff;
  }

  .gmail-row.is-read {
    background: #f8fafc;
    opacity: 0.86;
  }

  .gmail-row.is-read .subject-title {
    font-weight: 500;
    color: #475569;
  }

  .gmail-row.has-note {
    background: #fffdf5;
  }

  .gmail-row.hidden {
    display: none !important;
  }

  /* Cell 1: Sender Avatar + Emoji */
  .cell-sender {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .read-dot-btn {
