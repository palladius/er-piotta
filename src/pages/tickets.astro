const topOfMindKateMd = [
  `- 🇬🇧🇫🇷 **🐉 Ale · English, SATs & French (Mon 23 & Thu 26 Nov)**: **Mon 23 Nov** **French Test Leçon 4** (4 speaking questions + blue/orange nationalities) → ${magicLink('FR Test Leçon 4 (Mon 23)', '0goelbv3', 'Ale')}. **Thu 26 Nov** **English GPS pp. 90–91** + **Reading ("Bill\'s New Frock") pp. 26–27** + French p. 47 ex. 2 & *"Mon emploi du temps"* → ${magicLink('HW FR & EN (Thu 26)', '5cocuufs', 'Ale')} + **Library books** → ${magicLink('P3 Library (Thu 26)', '05pgkjtc', 'Ale')} + **GPS SATs (Mon 30)** → ${magicLink('SATs Dates', '1a1e8ff3e3', 'Ale')}.`,
