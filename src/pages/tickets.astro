---
import Layout from '../layouts/Layout.astro';
import feedData from '../data/piota_feed.json';

function renderSimpleMarkdown(md: string): string {
  if (!md) return '';
  const escaped = md
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return escaped
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
    .replace(/(^|\s)(https?:\/\/[^\s<]+)/g, '$1<a href="$2" target="_blank" rel="noopener noreferrer">$2</a>')
    .split(/\n{2,}/)
    .map(p => `<p>${p.replace(/\n/g, '<br/>')}</p>`)
    .join('');
}

// Filter out Küsnacht / school bus noise and other parents' booked PTC slots
const cleanFeed = feedData.filter((item: any) => {
  const text = `${item.title || ''} ${item.body || ''}`.toLowerCase();
  const isBusOrKusnacht = text.includes('küsnacht') || text.includes('kusnacht') || text.includes('school bus') || text.includes('bus service');
  if (isBusOrKusnacht) return false;
  const titleL = (item.title || '').toLowerCase();
  if (titleL.includes('ptc') && titleL.includes('(') && titleL.includes(')')) {
    if (!['carlesso', 'riccardo', 'kate', 'knight', 'palladius'].some(f => text.includes(f))) {
      return false;
    }
  }
  // Skip manual Fwd duplicates if original email is present
  if (String(item.id || '').startsWith('alert_gmail_') && String(item.title || '').startsWith('Fwd: [')) {
    return false;
  }
  // Skip legacy Piota SQLite events since Google Classroom iCal events (event_gcal_) are canonical
  if (item.type === 'event' && String(item.id || '').startsWith('event_') && !String(item.id || '').startsWith('event_gcal_')) {
    return false;
  }
  return true;
});

const todayIso = new Date().toISOString().slice(0, 10);
const maxFutureDate = new Date(Date.now() + 21 * 86400000).toISOString().slice(0, 10);
const weekdaysIt = ['Dom', 'Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab'];

function formatYmdDay(isoStr: string): string {
  if (!isoStr || isoStr.length < 10) return '--------(---)';
  const dStr = isoStr.slice(0, 10);
  const ymd = dStr.replace(/-/g, '');
  const dObj = new Date(dStr + 'T12:00:00Z');
  if (isNaN(dObj.getTime())) return `${ymd}(---)`;
  const wd = weekdaysIt[dObj.getUTCDay()];
  return `${ymd}(${wd})`;
}

function formatYmdRel(isoStr: string): { text: string; daysLeft: number } {
  if (!isoStr || isoStr.length < 10) return { text: '--------(---)', daysLeft: 7 };
  const dStr = isoStr.slice(0, 10);
  const ymd = dStr.replace(/-/g, '');
  const dObj = new Date(dStr + 'T12:00:00Z');
  const tObj = new Date(todayIso + 'T12:00:00Z');
  const diffDays = Math.round((dObj.getTime() - tObj.getTime()) / 86400000);
  const rel = diffDays >= 0 ? `+${diffDays}g` : `${diffDays}g`;
  return { text: `${ymd}(${rel})`, daysLeft: diffDays };
}

function inferSender(item: any) {
  const text = `${item.sender_name || ''} ${item.sender_email || ''} ${item.title || ''} ${item.body || ''}`.toLowerCase();
  const kids = (item.target_kids || []).map((k: string) => k.toLowerCase());
  const hasAle = kids.some((k: string) => ['ale', 'alessandro', 'p3'].includes(k));
  const hasSeb = kids.some((k: string) => ['seby', 'sebastian', 'seb', 'p1'].includes(k));
  const kidCode = (hasAle && hasSeb) || kids.includes('all') || kids.length === 0 ? 'A+S' : (hasAle ? 'Ale' : 'Seb');

  if (text.includes('mbiehl') || text.includes('biehl') || (kidCode === 'Ale' && ['deutsch', 'mathe', 'schreibheft', 'lzk'].some(w => text.includes(w)))) {
    return {
      key: 'biehl',
      name: 'Herr Marvin Biehl',
      shortName: 'M. Biehl',
      email: 'mbiehl@tandem-ims.ch',
      emoji: '🇩🇪🧮',
      flag: '🇩🇪',
      subjectEmoji: '🧮',
      role: 'Deutsch & Mathe · P3',
      initials: 'MB',
      bgGradient: 'linear-gradient(135deg, #1e293b 0%, #dc2626 55%, #f59e0b 100%)',
      kidCode: 'Ale',
    };
  }
  if (text.includes('jpenrose') || text.includes('penrose') || (kidCode === 'Ale' && ['english', 'spelling', 'music', 'diwali', 'french'].some(w => text.includes(w)))) {
    return {
      key: 'penrose',
      name: 'Miss Jessica Penrose',
      shortName: 'J. Penrose',
      email: 'jpenrose@tandem-ims.ch',
      emoji: '🇬🇧🎵',
      flag: '🇬🇧',
      subjectEmoji: '🎵',
      role: 'English & Music · P3',
      initials: 'JP',
      bgGradient: 'linear-gradient(135deg, #1d4ed8 0%, #7c3aed 100%)',
      kidCode: 'Ale',
    };
  }
  if (text.includes('grayment') || text.includes('rayment') || (kidCode === 'Seb' && ['english', 'reading', 'raz kids', 'phonics'].some(w => text.includes(w)))) {
    return {
      key: 'rayment',
      name: 'Miss Gaby Rayment',
      shortName: 'G. Rayment',
      email: 'grayment@tandem-ims.ch',
      emoji: '🇬🇧📚',
      flag: '🇬🇧',
      subjectEmoji: '📚',
      role: 'English · P1',
      initials: 'GR',
      bgGradient: 'linear-gradient(135deg, #0369a1 0%, #ec4899 100%)',
      kidCode: 'Seb',
    };
  }
  if (text.includes('xfaux') || text.includes('faux') || (kidCode === 'Seb' && ['deutsch', 'ziffern', 'schreibheft', 'bibliothek', 'räbeliechtli', 'turnhalle'].some(w => text.includes(w)))) {
    return {
      key: 'faux',
      name: 'Frau Xenia Faux',
      shortName: 'X. Faux',
      email: 'xfaux@tandem-ims.ch',
      emoji: '🇩🇪🎨',
      flag: '🇩🇪',
      subjectEmoji: '🎨',
      role: 'Deutsch & Mathe · P1',
      initials: 'XF',
      bgGradient: 'linear-gradient(135deg, #b91c1c 0%, #d97706 100%)',
      kidCode: 'Seb',
    };
  }
  return {
    key: 'tandem',
    name: 'Tandem IMS Seefeld',
    shortName: 'Tandem IMS',
    email: 'zurich@tandem-ims.ch',
    emoji: '🇨🇭🏫',
    flag: '🇨🇭',
    subjectEmoji: '🏫',
    role: 'Scuola & Admin',
    initials: 'TI',
    bgGradient: 'linear-gradient(135deg, #dc2626 0%, #991b1b 100%)',
    kidCode,
  };
}

function inferCategory(item: any) {
  const titleL = String(item.title || '').toLowerCase();
  const text = `${titleL} ${String(item.body || '').toLowerCase()}`;

  if (['test', 'lzk', 'lernzielkontrolle', 'diktat', 'exam', 'prüfung'].some(k => titleL.includes(k))) {
    return {
      nature: 'action_required',
      natureEmoji: '⚡',
      natureCode: 'ACT',
      catKey: 'test',
      catEmoji: '🎯',
      catCode: 'TST',
      catLabel: 'Test / Verifica',
    };
  }
  if (['homework', 'hausaufgabe', 'hausaufgaben', 'raz kids', 'matheplan', 'schreibheft', 'ziffern'].some(k => titleL.includes(k))) {
    return {
      nature: 'action_required',
      natureEmoji: '⚡',
      natureCode: 'ACT',
      catKey: 'homework',
      catEmoji: '📝',
      catCode: 'HW',
      catLabel: 'Homework',
    };
  }
  if (['bibliothek', 'library', 'bücher', 'reading book'].some(k => titleL.includes(k))) {
    return {
      nature: 'action_required',
      natureEmoji: '⚡',
      natureCode: 'ACT',
      catKey: 'library',
      catEmoji: '📚',
      catCode: 'LIB',
      catLabel: 'Biblioteca',
    };
  }
  if (['photo', 'photos', 'album', 'pictures', 'tawanga', 'behind the scenes'].some(k => titleL.includes(k))) {
    return {
      nature: 'info',
      natureEmoji: '💡',
      natureCode: 'FYI',
      catKey: 'photos',
      catEmoji: '📸',
      catCode: 'PIC',
      catLabel: 'Foto & Album',
    };
  }
  if (['timetable', 'kalender', 'calendar', 'stundenplan'].some(k => titleL.includes(k))) {
    return {
      nature: 'info',
      natureEmoji: '💡',
      natureCode: 'FYI',
      catKey: 'admin',
      catEmoji: '📅',
      catCode: 'ADM',
      catLabel: 'Orari & Admin',
    };
  }
  if (['umzug', 'räbeliechtli', 'excursion', 'ausflug', 'trip', 'wald', 'forest', 'swimming', 'schwimmbad', 'turnhalle', 'diwali', 'concert', 'christmas', 'bäckerei', 'museum'].some(k => text.includes(k))) {
    const isAct = item.nature === 'action_required' || ['bring', 'mitnehmen', 'permission', 'sign', 'anmeldung'].some(w => text.includes(w));
    return {
      nature: isAct ? 'action_required' : 'info',
      natureEmoji: isAct ? '⚡' : '💡',
      natureCode: isAct ? 'ACT' : 'FYI',
      catKey: 'trip',
      catEmoji: '🎒',
      catCode: 'TRP',
      catLabel: 'Gita / Evento',
    };
  }
  const isAct = item.nature === 'action_required' && !['timetable', 'kalender link', 'class calendar'].some(k => titleL.includes(k));
  return {
    nature: isAct ? 'action_required' : 'info',
    natureEmoji: isAct ? '⚡' : '💡',
    natureCode: isAct ? 'ACT' : 'FYI',
    catKey: 'admin',
    catEmoji: '📅',
    catCode: 'ADM',
    catLabel: 'Orari & Admin',
  };
}

// Enrich and deduplicate items
const seenDedup = new Set<string>();
const enrichedItems = cleanFeed
  .map((item: any) => {
    const rawCreated = String(item.created_date || item.created_at || item.crawled_at || item.datestart || todayIso).slice(0, 10);
    const rawEvent = String(item.event_date || item.datestart || item.ticket?.due_date || rawCreated).slice(0, 10);
    let autoArchiveIso = String(item.auto_archive_at || '').slice(0, 10);
    if (!autoArchiveIso) {
      const ttlDays = item.type === 'event' || item.ticket?.due_date ? 7 : 14;
      const baseD = new Date((item.type === 'event' ? rawEvent : rawCreated) + 'T12:00:00Z');
      autoArchiveIso = isNaN(baseD.getTime())
        ? new Date(Date.now() + 7 * 86400000).toISOString().slice(0, 10)
        : new Date(baseD.getTime() + ttlDays * 86400000).toISOString().slice(0, 10);
    }
    const primaryDate = item.type === 'event' ? rawEvent : rawCreated;
    const ymdCreated = formatYmdDay(primaryDate);
    const aaInfo = formatYmdRel(autoArchiveIso);
    const isAutoExpired = autoArchiveIso < todayIso;
    const isManuallyArchived = Boolean(item.consumption?.archived);
    const sender = inferSender(item);
    const cat = inferCategory(item);

    // Clean title prefix
    let cleanTitle = String(item.title || 'Untitled').trim();
    for (const pref of ['[P1 Seby] ', '[P3 Ale] ', '[P1] ', '[P3] ']) {
      if (cleanTitle.startsWith(pref)) cleanTitle = cleanTitle.slice(pref.length);
    }

    // Build snippet
    const rawBody = String(item.body || '')
      .replace(/^\*\*From:\*\*.*$/gm, '')
      .replace(/^\*\*Date:\*\*.*$/gm, '')
      .replace(/^Class calendar event.*$/gm, '')
      .trim();
    const snippet = rawBody.replace(/\s+/g, ' ').slice(0, 140);

    return {
      ...item,
      nature: cat.nature,
      cat,
      cleanTitle,
      snippet,
      primaryDate,
      autoArchiveIso,
      ymdCreated,
      ymdAutoArchive: aaInfo.text,
      daysUntilArchive: aaInfo.daysLeft,
      isAutoExpired,
      isManuallyArchived,
      isArchivedDefault: isAutoExpired || isManuallyArchived,
      sender,
      kidCode: item.kid_code || sender.kidCode,
      renderedBody: renderSimpleMarkdown(item.body || ''),
    };
  })
  .filter((item: any) => {
    // Hide far-future recurring events > 21 days out so the inbox stays crisp
    if (item.type === 'event' && item.primaryDate > maxFutureDate) return false;
    const dedupKey = `${item.primaryDate}|${item.kidCode}|${item.cleanTitle.toLowerCase()}`;
    if (seenDedup.has(dedupKey)) return false;
    seenDedup.add(dedupKey);
    return true;
  })
  .sort((a: any, b: any) => {
    // Alerts/Emails first (newest first), then upcoming events (chronological)
    const aAlert = a.type === 'alert' ? 0 : 1;
    const bAlert = b.type === 'alert' ? 0 : 1;
    if (aAlert !== bAlert) return aAlert - bAlert;
    if (aAlert === 0) return b.primaryDate.localeCompare(a.primaryDate);
    return a.primaryDate.localeCompare(b.primaryDate);
  });
