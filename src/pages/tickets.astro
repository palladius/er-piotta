    border-radius: 50%;
    object-fit: cover;
  }

  .btn-note {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.28rem 0.55rem;
    border-radius: 7px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #334155;
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .btn-note:hover {
    background: #fef9c3;
    border-color: #facc15;
    color: #713f12;
  }

  .btn-note.has-note-btn {
    background: #fef08a;
    border-color: #eab308;
    color: #713f12;
  }

  .btn-archive-row {
    border: 1px solid transparent;
    background: transparent;
    padding: 0.25rem 0.35rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.82rem;
    opacity: 0.55;
  }

  .btn-archive-row:hover {
    opacity: 1;
    background: #f1f5f9;
    border-color: #cbd5e1;
  }

  .empty-inbox {
    text-align: center;
    padding: 3rem 1rem;
    background: #ffffff;
    border-radius: 12px;
    border: 1px dashed #cbd5e1;
    color: #64748b;
    font-weight: 600;
  }

  .empty-inbox.hidden {
    display: none;
  }

  /* Native <dialog> Modals */
  .piota-dialog {
    max-width: 680px;
    width: 92vw;
    border: none;
    border-radius: 16px;
    padding: 0;
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.25);
    background: #ffffff;
    color: #0f172a;
  }

  .piota-dialog::backdrop {
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(3px);
  }

  .note-only-dialog {
    max-width: 480px;
  }

  .dialog-header {
    padding: 1.1rem 1.35rem;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .dialog-meta-top {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
  }

  .dialog-sender-pill,
  .dialog-dates-pill {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: #f1f5f9;
    color: #334155;
  }

  .dialog-header h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .dialog-close-btn {
    border: none;
    background: #f1f5f9;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    cursor: pointer;
    font-weight: 800;
    color: #475569;
  }

  .dialog-body {
    padding: 1.25rem 1.35rem;
    max-height: 52vh;
    overflow-y: auto;
    line-height: 1.6;
    font-size: 0.92rem;
  }

  .dialog-note-box {
    padding: 0.9rem 1.35rem;
    background: #fefce8;
    border-top: 1px solid #fef08a;
    border-bottom: 1px solid #fef08a;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .dialog-note-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: #854d0e;
  }

  .dialog-note-row {
    display: flex;
    gap: 0.5rem;
  }

  #dialog-note-input,
  #quick-note-textarea {
    flex: 1;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    border: 1px solid #fde047;
    background: #ffffff;
    font-size: 0.88rem;
    font-family: inherit;
  }

  .quick-note-sub {
    margin: 0;
    padding: 0.5rem 1.35rem 0;
    font-size: 0.84rem;
    font-weight: 600;
    color: #475569;
  }

  .dialog-footer {
    padding: 0.85rem 1.35rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-right-btns {
    display: flex;
    gap: 0.5rem;
  }

  .btn-primary-save {
    background: #1d4ed8;
    color: #ffffff;
    border: none;
    padding: 0.48rem 0.95rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.84rem;
    cursor: pointer;
  }

  .btn-secondary-close {
    background: #f1f5f9;
    color: #334155;
    border: 1px solid #cbd5e1;
    padding: 0.48rem 0.9rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.84rem;
    cursor: pointer;
  }

  .btn-danger-clear {
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
    padding: 0.45rem 0.8rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .source-ext-link {
    font-size: 0.82rem;
    font-weight: 700;
    color: #2563eb;
    text-decoration: none;
  }

  .source-ext-link.hidden {
    display: none;
  }

  @media (max-width: 1024px) {
    .gmail-list-header {
      display: none;
    }
    .gmail-row {
      grid-template-columns: 1fr auto;
      gap: 0.45rem;
      padding: 0.75rem;
    }
    .cell-content {
      grid-column: 1 / -1;
    }
    .cell-controls {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }
</style>

<script>
  // State management: localStorage + live sync with /api/ticket -> Firestore (palladius-genai)
  const STORAGE_KEY = 'piota_gmail_state_v5';
  const USER_KEY = 'piota_active_parent_v5';

  interface ItemLocalState {
    owner?: string;
    note?: string;
    archived?: boolean;
    read_by_riccardo?: boolean;
    read_by_kate?: boolean;
  }

  let localStates: Record<string, ItemLocalState> = {};
  try {
    localStates = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
  } catch {
    localStates = {};
  }

  let activeUser = localStorage.getItem(USER_KEY) || 'riccardo';
  let activeTab = 'inbox';
  let activeKid = 'all';
  let activeCat = 'all';
  let activeSender = 'all';
  let searchQuery = '';
  let currentModalItemId: string | null = null;

  const rows = Array.from(document.querySelectorAll<HTMLElement>('.gmail-row'));
  const detailDialog = document.getElementById('detail-dialog') as HTMLDialogElement | null;
  const quickNoteDialog = document.getElementById('quick-note-dialog') as HTMLDialogElement | null;

  function saveLocalStates() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(localStates));
  }

  async function persistToBackend(itemId: string, patch: ItemLocalState) {
    localStates[itemId] = { ...(localStates[itemId] || {}), ...patch };
    saveLocalStates();
    try {
      await fetch('/api/ticket', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: itemId, user: activeUser, ...patch }),
      });
    } catch {
      // Offline / static fallback: localStorage already has it
    }
  }

  function applyRowState(row: HTMLElement) {
    const id = row.dataset.id || '';
    const st = localStates[id] || {};

    const owner = st.owner !== undefined ? st.owner : (row.dataset.owner || 'unassigned');
    const note = st.note !== undefined ? st.note : (row.dataset.note || '');
    const archived = st.archived !== undefined ? st.archived : (row.dataset.archived === 'true');
    const readR = st.read_by_riccardo !== undefined ? st.read_by_riccardo : (row.dataset.readRiccardo === 'true');
    const readK = st.read_by_kate !== undefined ? st.read_by_kate : (row.dataset.readKate === 'true');

    row.dataset.owner = owner;
    row.dataset.note = note;
    row.dataset.archived = archived ? 'true' : 'false';
    row.dataset.readRiccardo = readR ? 'true' : 'false';
    row.dataset.readKate = readK ? 'true' : 'false';

    const isReadForCurrent = activeUser === 'riccardo' ? readR : readK;
    row.classList.toggle('is-read', isReadForCurrent);
    row.classList.toggle('is-unread', !isReadForCurrent);
    row.classList.toggle('has-note', Boolean(note));

    // Sync radio buttons
    const radios = row.querySelectorAll<HTMLInputElement>('input[type="radio"][data-action="change-owner"]');
    radios.forEach((r) => {
      const checked = r.value === owner;
      r.checked = checked;
      r.closest('.owner-opt')?.classList.toggle('selected', checked);
    });

    // Sync inline note pill & button
    const notePill = row.querySelector<HTMLElement>('[data-role="note-pill"]');
    const noteText = row.querySelector<HTMLElement>('[data-role="note-text"]');
    const noteBtn = row.querySelector<HTMLElement>('[data-action="open-note"]');
    const noteBtnLabel = row.querySelector<HTMLElement>('.btn-note-label');
    if (notePill && noteText) {
      noteText.textContent = note;
      notePill.classList.toggle('hidden', !note);
    }
    if (noteBtn && noteBtnLabel) {
      noteBtn.classList.toggle('has-note-btn', Boolean(note));
      noteBtnLabel.textContent = note ? 'Nota' : '+Nota';
      noteBtn.title = note ? `Modifica nota: ${note}` : 'Aggiungi una nota';
    }
  }

  function refreshAllAndFilter() {
    let cInbox = 0;
    let cAction = 0;
    let cNotes = 0;
    let cMine = 0;
    let cArchived = 0;
    let visibleCount = 0;

    rows.forEach((row) => {
      applyRowState(row);
      const isAutoExpired = row.dataset.autoExpired === 'true';
      const isManuallyArchived = row.dataset.archived === 'true';
      const isArchived = isAutoExpired || isManuallyArchived;
      const isAction = row.dataset.nature === 'action_required';
      const hasNote = Boolean(row.dataset.note);
      const owner = row.dataset.owner || 'unassigned';
      const kid = row.dataset.kid || 'A+S';
      const sender = row.dataset.sender || 'tandem';

      if (isArchived) {
        cArchived++;
      } else {
        cInbox++;
        if (isAction) cAction++;
        if (hasNote) cNotes++;
        if (owner === activeUser) cMine++;
      }

      // Tab filter
      let matchTab = false;
      if (activeTab === 'archived') matchTab = isArchived;
      else if (activeTab === 'inbox') matchTab = !isArchived;
      else if (activeTab === 'action') matchTab = !isArchived && isAction;
      else if (activeTab === 'notes') matchTab = !isArchived && hasNote;
      else if (activeTab === 'mine') matchTab = !isArchived && owner === activeUser;

      // Kid filter
      const matchKid = activeKid === 'all' || kid === activeKid || (activeKid !== 'A+S' && kid === 'A+S');
      // Category filter
      const cat = row.dataset.cat || 'admin';
      const matchCat = activeCat === 'all' || cat === activeCat;
      // Sender filter
      const matchSender = activeSender === 'all' || sender === activeSender;
      // Search query
      const searchable = `${row.dataset.title || ''} ${row.dataset.note || ''} ${row.dataset.senderLabel || ''}`.toLowerCase();
      const matchSearch = !searchQuery || searchable.includes(searchQuery);

      const show = matchTab && matchKid && matchCat && matchSender && matchSearch;
      row.classList.toggle('hidden', !show);
      if (show) visibleCount++;
    });

    const setBadge = (id: string, n: number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(n);
    };
    setBadge('count-inbox', cInbox);
    setBadge('count-action', cAction);
    setBadge('count-notes', cNotes);
    setBadge('count-mine', cMine);
    setBadge('count-archived', cArchived);

    const emptyBanner = document.getElementById('empty-inbox-banner');
    if (emptyBanner) emptyBanner.classList.toggle('hidden', visibleCount > 0);
  }

  // Pull fresh state from /api/tickets-state on load
  async function syncFromServer() {
    try {
      const res = await fetch('/api/tickets-state');
      if (!res.ok) return;
      const data = await res.json();
      if (data && data.states) {
        for (const [id, s] of Object.entries<any>(data.states)) {
          const t = s.ticket || {};
          const c = s.consumption || {};
          const rawOwner = String(t.owner || 'unassigned').toLowerCase();
          const normOwner = rawOwner.startsWith('ric') ? 'riccardo' : (rawOwner.startsWith('kat') ? 'kate' : 'unassigned');
          localStates[id] = {
            ...(localStates[id] || {}),
            owner: normOwner,
            note: t.note ?? localStates[id]?.note ?? '',
            archived: Boolean(c.archived),
            read_by_riccardo: Boolean(c.read_by_riccardo),
            read_by_kate: Boolean(c.read_by_kate),
          };
        }
        saveLocalStates();
        refreshAllAndFilter();
      }
    } catch {
      // Ignore if offline
    }
  }

  // Wire up Active Parent User radio buttons
  document.querySelectorAll<HTMLInputElement>('input[name="active-parent-user"]').forEach((radio) => {
    radio.checked = radio.value === activeUser;
    radio.addEventListener('change', () => {
      if (radio.checked) {
        activeUser = radio.value;
        localStorage.setItem(USER_KEY, activeUser);
        refreshAllAndFilter();
      }
    });
  });

  // Wire up Teacher filter chips
  document.querySelectorAll<HTMLButtonElement>('.teacher-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.teacher-chip').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeSender = btn.dataset.senderFilter || 'all';
      refreshAllAndFilter();
    });
  });

  // Wire up Inbox Tabs
  document.querySelectorAll<HTMLButtonElement>('.inbox-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.inbox-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeTab = btn.dataset.tab || 'inbox';
      refreshAllAndFilter();
    });
  });

  // Wire up 3-char Kid filter buttons
  document.querySelectorAll<HTMLButtonElement>('.kid-pill-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.kid-pill-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeKid = btn.dataset.kid || 'all';
      refreshAllAndFilter();
    });
  });

  // Wire up Category filter buttons
  document.querySelectorAll<HTMLButtonElement>('.cat-pill-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.cat-pill-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeCat = btn.dataset.cat || 'all';
      refreshAllAndFilter();
    });
  });

  // Wire up Search input
  const searchInput = document.getElementById('gmail-search-input') as HTMLInputElement | null;
  searchInput?.addEventListener('input', () => {
    searchQuery = searchInput.value.trim().toLowerCase();
    refreshAllAndFilter();
  });

  // Open Detail Modal
  function openDetailModal(row: HTMLElement) {
    const id = row.dataset.id || '';
    currentModalItemId = id;

    // Mark as read for active user
    const readPatch = activeUser === 'riccardo' ? { read_by_riccardo: true } : { read_by_kate: true };
    persistToBackend(id, readPatch);
    refreshAllAndFilter();

    const titleEl = document.getElementById('dialog-title');
    const senderBadge = document.getElementById('dialog-sender-badge');
    const datesBadge = document.getElementById('dialog-dates-badge');
    const bodyEl = document.getElementById('dialog-body-content');
    const noteInput = document.getElementById('dialog-note-input') as HTMLInputElement | null;
    const srcLink = document.getElementById('dialog-source-link') as HTMLAnchorElement | null;

    if (titleEl) titleEl.textContent = row.dataset.title || '';
    if (senderBadge) senderBadge.textContent = row.dataset.senderLabel || '';
    if (datesBadge) datesBadge.textContent = row.dataset.datesLabel || '';
    if (noteInput) noteInput.value = row.dataset.note || '';

    const tpl = row.querySelector<HTMLTemplateElement>('.item-body-template');
    if (bodyEl && tpl) {
      bodyEl.innerHTML = '';
      bodyEl.appendChild(tpl.content.cloneNode(true));
    }

    if (srcLink) {
      const url = row.dataset.sourceUrl || '';
      if (url) {
        srcLink.href = url;
        srcLink.classList.remove('hidden');
      } else {
        srcLink.classList.add('hidden');
      }
    }

    detailDialog?.showModal();
  }

  // Open Quick Note Modal
  function openQuickNoteModal(row: HTMLElement) {
    const id = row.dataset.id || '';
    currentModalItemId = id;
    const sub = document.getElementById('quick-note-subtitle');
    const ta = document.getElementById('quick-note-textarea') as HTMLTextAreaElement | null;
    if (sub) sub.textContent = `${row.dataset.senderLabel} — ${row.dataset.title}`;
    if (ta) ta.value = row.dataset.note || '';
    quickNoteDialog?.showModal();
    ta?.focus();
  }

  // Delegate Row Actions using addEventListener (zero inline onclick handlers)
  rows.forEach((row) => {
    const id = row.dataset.id || '';

    // 1. Toggle Read dot
    row.querySelector('[data-action="toggle-read"]')?.addEventListener('click', () => {
      const curRead = activeUser === 'riccardo' ? row.dataset.readRiccardo === 'true' : row.dataset.readKate === 'true';
      const patch = activeUser === 'riccardo' ? { read_by_riccardo: !curRead } : { read_by_kate: !curRead };
      persistToBackend(id, patch);
      refreshAllAndFilter();
    });

    // 2. Click Subject/Content to open reader modal
    const contentCell = row.querySelector<HTMLElement>('[data-action="open-detail"]');
    contentCell?.addEventListener('click', () => openDetailModal(row));
    contentCell?.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' || ev.key === ' ') {
        ev.preventDefault();
        openDetailModal(row);
      }
    });

    // 3. Owner Radio Buttons (Ricc / Kate / —)
    row.querySelectorAll<HTMLInputElement>('input[type="radio"][data-action="change-owner"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        if (radio.checked) {
          persistToBackend(id, { owner: radio.value });
          refreshAllAndFilter();
        }
      });
    });

    // 4. Open Quick Note Dialog
    row.querySelector('[data-action="open-note"]')?.addEventListener('click', () => {
      openQuickNoteModal(row);
    });

    // 5. Toggle Archive
    row.querySelector('[data-action="toggle-archive"]')?.addEventListener('click', () => {
      const curArch = row.dataset.archived === 'true';
      persistToBackend(id, { archived: !curArch });
      refreshAllAndFilter();
    });
  });

  // Save Note inside Detail Modal
  document.getElementById('dialog-save-note-btn')?.addEventListener('click', () => {
    if (!currentModalItemId) return;
    const noteInput = document.getElementById('dialog-note-input') as HTMLInputElement | null;
    const val = (noteInput?.value || '').trim();
    persistToBackend(currentModalItemId, { note: val });
    refreshAllAndFilter();
  });

  // Quick Note Form Submit / Clear / Close
  document.getElementById('quick-note-form')?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    if (!currentModalItemId) return;
    const ta = document.getElementById('quick-note-textarea') as HTMLTextAreaElement | null;
    const val = (ta?.value || '').trim();
    persistToBackend(currentModalItemId, { note: val });
    refreshAllAndFilter();
    quickNoteDialog?.close();
  });

  document.getElementById('quick-note-clear-btn')?.addEventListener('click', () => {
    if (!currentModalItemId) return;
    persistToBackend(currentModalItemId, { note: '' });
    refreshAllAndFilter();
    quickNoteDialog?.close();
  });

  document.getElementById('quick-note-cancel')?.addEventListener('click', () => quickNoteDialog?.close());
  document.getElementById('quick-note-close-btn')?.addEventListener('click', () => quickNoteDialog?.close());

  // Initial render + fetch server state
  refreshAllAndFilter();
  syncFromServer();
</script>
