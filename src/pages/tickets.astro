function classifyPhotoActivity(title: string, body: string, sender: any): { key: string; emoji: string; label: string; color: string; desc: string } {
  const t = `${title} ${body}`.toLowerCase();
  if (t.includes('sport') || t.includes('dodgeball') || t.includes('turnhalle') || t.includes('swimming') || t.includes('ice-skating')) {
    return {
      key: 'sport',
      emoji: '🤸',
      label: 'Sport & Educazione Fisica',
      color: 'act-sport',
      desc: 'Lezione di sport in palestra (partita di Dodgeball a squadre)',
    };
  }
  if (t.includes('tawanga') || t.includes('christmas card')) {
    return {
      key: 'natale',
      emoji: '🎄',
      label: 'Natale & Progetto Tawanga',
      color: 'act-natale',
      desc: 'Dietro le quinte: creazione delle cartoline di Natale personalizzate con Mrs Schmid',
    };
  }
  if (t.includes('diwali') || t.includes('räbeliechtli') || t.includes('celebration') || t.includes('festival')) {
    return {
      key: 'feste',
      emoji: '🪔',
      label: 'Feste, Tradizioni & Cultura',
      color: 'act-feste',
      desc: 'Festa di Diwali in classe con attività culturali e lanterne',
    };
  }
  if (t.includes('art') || sender.key === 'schmid') {
    return {
      key: 'arte',
      emoji: '🎨',
      label: 'Arte & Creatività (Art Class)',
      color: 'act-arte',
      desc: 'Album settimanale dei lavori artistici realizzati nel laboratorio di Mrs Schmid',
    };
  }
  if (t.includes('excursion') || t.includes('ausflug') || t.includes('museum') || t.includes('technorama') || t.includes('wald') || t.includes('forest')) {
    return {
      key: 'gita',
      emoji: '🎒',
      label: 'Gita Scolastica & Escursioni',
      color: 'act-gita',
      desc: 'Foto dell\'escursione / uscita didattica della classe',
    };
  }
  if (t.includes('music') || t.includes('concert') || t.includes('piano')) {
    return {
      key: 'musica',
      emoji: '🎵',
      label: 'Musica & Spettacoli',
      color: 'act-musica',
      desc: 'Attività musicale e prove di classe',
    };
  }
  return {
    key: 'classe',
    emoji: '📸',
    label: 'Vita di Classe Settimanale',
    color: 'act-classe',
    desc: 'Cartella Google Drive aggiornata ogni settimana con le foto delle attività in classe',
  };
}

function extractPhotoLinksForItem(item: any, sender: any, cleanTitle: string, ymdCreated: string, primaryDate: string, kidCode: string): PhotoAlbumEntry[] {
  const body = String(item.body || '');
  const regex = /https?:\/\/(?:photos\.app\.goo\.gl|photos\.google\.com|drive\.google\.com\/drive\/folders)\/[^\s)\]"'*>]+/gi;
  const matches = body.match(regex) || [];
  const uniqueUrls = Array.from(new Set(matches.map(u => u.replace(/[.,;*]+$/, ''))));
  if (uniqueUrls.length === 0) return [];

  const act = classifyPhotoActivity(cleanTitle, body, sender);
  const kidLabel = kidCode === 'Ale' ? '🐉 Ale (P3)' : (kidCode === 'Seb' ? '🚗 Seby (P1)' : '🐉🚗 Ale & Seby');

  const isDotW = (iso: string) => {
    const dObj = new Date(iso.slice(0, 10) + 'T12:00:00Z');
    return isNaN(dObj.getTime()) ? '---' : weekdaysIt[dObj.getUTCDay()];
  };

  return uniqueUrls.map((url) => {
    const isDrive = url.includes('drive.google.com');
    const shortUrl = url.replace(/^https?:\/\//, '').slice(0, 34) + (url.length > 42 ? '…' : '');
    return {
      url,
      shortUrl,
      provider: isDrive ? 'Google Drive' : 'Google Photos',
      providerIcon: isDrive ? '📁' : '📸',
      kidCode,
      kidLabel,
      activityKey: act.key,
      activityEmoji: act.emoji,
      activityLabel: act.label,
      activityColor: act.color,
      emailId: item.id,
      emailTitle: cleanTitle,
      ymdDate: ymdCreated,
      dow: isDotW(primaryDate),
      primaryDate,
      teacherName: sender.shortName,
      teacherEmoji: sender.emoji,
      description: act.desc,
    };
  });
}

// Filter out Küsnacht / school bus noise and other parents' booked PTC slots
const cleanFeed = feedData.filter((item: any) => {
  const text = `${item.title || ''} ${item.body || ''}`.toLowerCase();
  const isBusOrKusnacht = text.includes('küsnacht') || text.includes('kusnacht') || text.includes('school bus') || text.includes('bus service');
  if (isBusOrKusnacht) return false;
  const titleL = (item.title || '').toLowerCase();
  if (titleL.includes('ptc') && titleL.includes('(') && titleL.includes(')')) {
    if (!['carlesso', 'riccardo', 'kate', 'knight', 'palladius'].some(f => text.includes(f))) {
      return false;
    }
  }
  // Skip manual Fwd duplicates and outgoing automated Briefing emails if original email is present
  if (
    String(item.id || '').startsWith('alert_gmail_') &&
    (String(item.title || '').startsWith('Fwd: [') ||
      String(item.title || '').includes('Briefing Settimana') ||
      String(item.title || '').includes('Piota AI Agent: Weekly Digest'))
  ) {
    return false;
  }
  // Skip legacy Piota SQLite events since Google Classroom iCal events (event_gcal_) are canonical
  if (item.type === 'event' && String(item.id || '').startsWith('event_') && !String(item.id || '').startsWith('event_gcal_')) {
    return false;
  }
  return true;
});

const todayIso = new Date().toISOString().slice(0, 10);
const maxFutureDate = new Date(Date.now() + 21 * 86400000).toISOString().slice(0, 10);
const weekdaysIt = ['Dom', 'Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab'];
const monthsIt = ['Gen', 'Feb', 'Mar', 'Apr', 'Mag', 'Giu', 'Lug', 'Ago', 'Set', 'Ott', 'Nov', 'Dic'];

// Compute initial lastSyncedIso from feed items' crawled_at
const initialLastSyncedIso = (() => {
  let latest = '';
  for (const it of feedData as any[]) {
    const ca = String(it.crawled_at || '');
    if (ca && ca > latest) latest = ca;
  }
  return latest || new Date().toISOString();
})();

function formatYmdDay(isoStr: string): string {
  if (!isoStr || isoStr.length < 10) return '--- -- ---';
  const dStr = isoStr.slice(0, 10);
  const dObj = new Date(dStr + 'T12:00:00Z');
  if (isNaN(dObj.getTime())) return dStr;
  const wd = weekdaysIt[dObj.getUTCDay()];
  const dayNum = String(dObj.getUTCDate()).padStart(2, '0');
  const mon = monthsIt[dObj.getUTCMonth()];
  return `${wd} ${dayNum} ${mon}`;
}

function formatYmdRel(isoStr: string): { text: string; daysLeft: number } {
  if (!isoStr || isoStr.length < 10) return { text: '--- -- ---', daysLeft: 7 };
  const dStr = isoStr.slice(0, 10);
  const dObj = new Date(dStr + 'T12:00:00Z');
  const tObj = new Date(todayIso + 'T12:00:00Z');
  if (isNaN(dObj.getTime())) return { text: dStr, daysLeft: 7 };
  const diffDays = Math.round((dObj.getTime() - tObj.getTime()) / 86400000);
  const rel = diffDays >= 0 ? `+${diffDays}g` : `${diffDays}g`;
  const wd = weekdaysIt[dObj.getUTCDay()];
  const dayNum = String(dObj.getUTCDate()).padStart(2, '0');
  const mon = monthsIt[dObj.getUTCMonth()];
  return { text: `${wd} ${dayNum} ${mon} (${rel})`, daysLeft: diffDays };
}

