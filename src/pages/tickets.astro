            type="button"
            class="matrix-btn matrix-row-hdr row-hdr-ale"
            data-matrix-kid="Ale"
            data-matrix-subj="all"
            title="Tutti gli elementi di Alessandro (Primary 3)"
          >
            <span class="row-kid-title">🐉 Ale <small>P3</small></span>
            <span class="matrix-count" data-mcount="Ale:all">0</span>
          </button>
          <button type="button" class="matrix-btn matrix-cell cell-ale" data-matrix-kid="Ale" data-matrix-subj="en" title="Ale · English (Miss Penrose)">
            <span class="cell-main">🇬🇧 EN</span>
            <span class="cell-sub">Penrose</span>
            <span class="matrix-count" data-mcount="Ale:en">0</span>
          </button>
          <button type="button" class="matrix-btn matrix-cell cell-ale" data-matrix-kid="Ale" data-matrix-subj="de" title="Ale · Deutsch (Herr Biehl)">
            <span class="cell-main">🇩🇪 DE</span>
            <span class="cell-sub">Biehl</span>
            <span class="matrix-count" data-mcount="Ale:de">0</span>
          </button>
          <button type="button" class="matrix-btn matrix-cell cell-ale" data-matrix-kid="Ale" data-matrix-subj="fr" title="Ale · Français (Mme Conde)">
            <span class="cell-main">🇫🇷 FR</span>
            <span class="cell-sub">Conde</span>
            <span class="matrix-count" data-mcount="Ale:fr">0</span>
          </button>
          <button type="button" class="matrix-btn matrix-cell cell-ale" data-matrix-kid="Ale" data-matrix-subj="math" title="Ale · Mathe (Herr Biehl)">
            <span class="cell-main">🧮 Math</span>
            <span class="cell-sub">Biehl</span>
            <span class="matrix-count" data-mcount="Ale:math">0</span>
          </button>
          <button type="button" class="matrix-btn matrix-cell cell-ale" data-matrix-kid="Ale" data-matrix-subj="piano" title="Ale · Pianoforte (Lunedì)">
            <span class="cell-main">🎹 Piano</span>
            <span class="cell-sub">Lunedì</span>
            <span class="matrix-count" data-mcount="Ale:piano">0</span>
          </button>

          <!-- Row 2: 🚗 Seby (Primary 1) x 5 Subjects -->
          <button
            type="button"
            class="matrix-btn matrix-row-hdr row-hdr-seb"
            data-matrix-kid="Seb"
            data-matrix-subj="all"
            title="Tutti gli elementi di Sebastian (Primary 1)"
          >
            <span class="row-kid-title">🚗 Seby <small>P1</small></span>
            <span class="matrix-count" data-mcount="Seb:all">0</span>
          </button>
          <button type="button" class="matrix-btn matrix-cell cell-seb" data-matrix-kid="Seb" data-matrix-subj="en" title="Seby · English (Miss Rayment)">
            <span class="cell-main">🇬🇧 EN</span>
            <span class="cell-sub">Rayment</span>
            <span class="matrix-count" data-mcount="Seb:en">0</span>
          </button>
          <button type="button" class="matrix-btn matrix-cell cell-seb" data-matrix-kid="Seb" data-matrix-subj="de" title="Seby · Deutsch (Frau Faux)">
            <span class="cell-main">🇩🇪 DE</span>
            <span class="cell-sub">Faux</span>
            <span class="matrix-count" data-mcount="Seb:de">0</span>
          </button>
          <button type="button" class="matrix-btn matrix-cell cell-seb" data-matrix-kid="Seb" data-matrix-subj="fr" title="Seby · Français (Mme Conde)">
            <span class="cell-main">🇫🇷 FR</span>
            <span class="cell-sub">Conde</span>
            <span class="matrix-count" data-mcount="Seb:fr">0</span>
          </button>
          <button type="button" class="matrix-btn matrix-cell cell-seb" data-matrix-kid="Seb" data-matrix-subj="math" title="Seby · Mathematik (Frau Faux)">
            <span class="cell-main">🧮 Math</span>
            <span class="cell-sub">Faux</span>
            <span class="matrix-count" data-mcount="Seb:math">0</span>
          </button>
          <button type="button" class="matrix-btn matrix-cell cell-seb" data-matrix-kid="Seb" data-matrix-subj="piano" title="Seby · Pianoforte (Lunedì)">
            <span class="cell-main">🎹 Piano</span>
            <span class="cell-sub">Lunedì</span>
            <span class="matrix-count" data-mcount="Seb:piano">0</span>
          </button>
        </div>

        <!-- Side Extra Buttons: 📸 Photos & 📦 Misc -->
        <div class="matrix-extras" role="group" aria-label="Foto e Varie">
          <button
            type="button"
            class="matrix-btn matrix-extra-btn extra-photos"
            data-matrix-kid="all"
            data-matrix-subj="photos"
            title="Album Foto Settimanali, Arte, Diwali, Tawanga"
          >
            <div class="extra-label-wrap">
              <span class="extra-title">📸 Photos</span>
              <span class="extra-sub">Drive, Arte &amp; Album</span>
            </div>
            <span class="matrix-count" data-mcount="all:photos">0</span>
          </button>

          <button
            type="button"
            class="matrix-btn matrix-extra-btn extra-misc"
            data-matrix-kid="all"
            data-matrix-subj="misc"
            title="Gite, Biblioteca, Pattinaggio, Silvesterlauf, Orari & Admin"
          >
            <div class="extra-label-wrap">
              <span class="extra-title">📦 Misc</span>
              <span class="extra-sub">Gite, Biblio &amp; Scuola</span>
            </div>
            <span class="matrix-count" data-mcount="all:misc">0</span>
          </button>
        </div>
      </div>
    </search>

    <!-- 📸 TABELLA SINOTTICA L1 ALBUM FOTO (webapp-that-riccardo-likes: Chi · Cosa · Data · Link) -->
    <section id="photo-albums-map-view" class="photo-map-section hidden" aria-label="Album Foto">
      <div class="photo-map-header">
        <div class="photo-map-title-row">
          <h2>Album Foto</h2>
          <span class="photo-map-count-pill">{allPhotoAlbums.length}</span>
        </div>

        <!-- Joined Segmented Radio Control (Rule 8: 1-of-N mutually exclusive filter, zero polychrome clutter) -->
        <div class="photo-act-segmented" role="radiogroup" aria-label="Filtra album per attività">
          <button type="button" class="photo-act-btn active" data-photo-act="all" role="radio" aria-checked="true">Tutte ({allPhotoAlbums.length})</button>
          <button type="button" class="photo-act-btn" data-photo-act="arte" role="radio" aria-checked="false">Arte</button>
          <button type="button" class="photo-act-btn" data-photo-act="sport" role="radio" aria-checked="false">Sport</button>
          <button type="button" class="photo-act-btn" data-photo-act="feste" role="radio" aria-checked="false">Feste</button>
          <button type="button" class="photo-act-btn" data-photo-act="natale" role="radio" aria-checked="false">Natale</button>
          <button type="button" class="photo-act-btn" data-photo-act="classe" role="radio" aria-checked="false">Classe</button>
        </div>

        <button type="button" id="btn-close-photo-map" class="photo-map-close-btn" title="Chiudi tabella foto">✕</button>
      </div>

      <div class="photo-table-wrap">
        <table class="photo-synoptic-table">
          <thead>
            <tr>
              <th class="col-pt-who">CHI</th>
              <th class="col-pt-what">COSA (ATTIVITÀ &amp; OGGETTO)</th>
              <th class="col-pt-date">DATA</th>
              <th class="col-pt-link">LINK ALBUM &amp; EMAIL</th>
            </tr>
          </thead>
          <tbody>
            {allPhotoAlbums.map((pa) => (
              <tr
                class="photo-album-row"
                data-photo-kid={pa.kidCode}
                data-photo-activity={pa.activityKey}
                title={`${pa.description} — Inviato da ${pa.teacherName} (${pa.ymdDate})`}
              >
                <!-- 1. CHI: Stylized Cartoon Avatar with Red/Blue Carlesso Ring + Compact Kid Label -->
                <td class="cell-pt-who">
                  <div class="pt-who-wrap">
                    {pa.kidCode === 'Ale' && (
                      <>
                        <img src="/er-piotta/avatars/avatar_ale_circle_transparent.png" alt="Ale" class="pt-kid-avatar ring-ale" />
                        <span class="pt-kid-name">Ale <small>P3</small></span>
                      </>
                    )}
                    {pa.kidCode === 'Seb' && (
                      <>
                        <img src="/er-piotta/avatars/avatar_sebi_circle_transparent.png" alt="Seby" class="pt-kid-avatar ring-seb" />
                        <span class="pt-kid-name">Seby <small>P1</small></span>
                      </>
                    )}
                    {pa.kidCode !== 'Ale' && pa.kidCode !== 'Seb' && (
                      <>
                        <div class="pt-dual-avatars">
                          <img src="/er-piotta/avatars/avatar_ale_circle_transparent.png" alt="Ale" class="pt-kid-avatar ring-ale" />
                          <img src="/er-piotta/avatars/avatar_sebi_circle_transparent.png" alt="Seby" class="pt-kid-avatar ring-seb overlap" />
                        </div>
                        <span class="pt-kid-name">Ale + Seby</span>
                      </>
                    )}
                  </div>
                </td>

                <!-- 2. COSA: Soft-tinted Activity Micro-Badge + Concise Title + Muted Teacher -->
                <td class="cell-pt-what">
                  <span class={`pt-act-chip ${pa.activityColor}`}>{pa.activityLabel}</span>
                  <span class="pt-what-title">{pa.emailTitle}</span>
                  <span class="pt-what-teacher">· {pa.teacherName}</span>
                </td>

                <!-- 3. DATA: Engineering Date Sub-Grid (DoW + Bold YYYY-MM-DD with tabular-nums) -->
                <td class="cell-pt-date">
                  <span class="pt-date-grid">
                    <span class={`pt-dow ${pa.dow === 'Sab' || pa.dow === 'Dom' ? 'pt-dow-wknd' : ''}`}>{pa.dow}</span>
                    <strong class="pt-iso-date">{pa.primaryDate}</strong>
                  </span>
                </td>

                <!-- 4. LINK: Monochrome currentColor SVG + Direct Album Link + Local Magic Link to Email -->
                <td class="cell-pt-link">
                  <div class="pt-links-wrap">
                    <a
                      href={pa.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="pt-album-link"
                      title={`Apri su ${pa.provider}: ${pa.url}`}
                    >
                      <svg class="pt-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                        <circle cx="9" cy="9" r="2"/>
                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                      </svg>
                      <span>{pa.provider}</span>
                      <code class="pt-short-url">{pa.shortUrl}</code>
                      <svg class="pt-svg-ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
                      </svg>
                    </a>

                    <a
                      href={`#item:${pa.emailId}`}
                      data-open-item={pa.emailId}
                      class="pt-email-magic-link"
                      title="Apri l'email originale del docente nell'app"
                    >
                      <svg class="pt-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <rect width="20" height="16" x="2" y="4" rx="2"/>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                      </svg>
                      <span>Email</span>
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="photo-table-footnote">
        <em>Passa il mouse su una riga per i dettagli dell'attività; clicca su Google Photos/Drive per l'album o su Email per il messaggio originale.</em>
      </p>
    </section>

    <!-- Column Header Legend (Col 1 = KID, Col 2 = MITTENTE, Col 3 = DATA Lun 16 Nov) -->
    <div class="gmail-list-header" aria-hidden="true">
      <div class="col-hdr-kid">FIGLIO</div>
      <div class="col-hdr-sender">MITTENTE &amp; MATERIA</div>
      <div class="col-hdr-dates">DATA · AUTO-ARCHIVE</div>
      <div class="col-hdr-subject">NATURA · CAT · OGGETTO, DETTAGLIO &amp; NOTE</div>
      <div class="col-hdr-right">AZIONI (ARCHIVIA · SNOOZE 7G · NOTA)</div>
    </div>

    <!-- Gmail Rows Container -->
    <div class="gmail-list" id="gmail-list-container" role="list">
      {enrichedItems.map((item: any) => {
        const initNote = String(item.ticket?.note || '').trim();
        const initSnooze = String(item.consumption?.snoozed_until || '');
        const isAction = item.nature === 'action_required';

        return (
          <article
            class={`gmail-row ${isAction ? 'row-action' : ''} ${initNote ? 'has-note' : ''}`}
            role="listitem"
            data-id={item.id}
            data-type={item.type}
            data-kid={item.kidCode}
            data-sender={item.sender.key}
            data-subjects={(item.subjects || ['misc']).join(',')}
            data-nature={item.nature}
            data-cat={item.cat.catKey}
            data-note={initNote}
            data-snoozed-until={initSnooze}
            data-auto-expired={item.isAutoExpired ? 'true' : 'false'}
            data-archived={item.isManuallyArchived ? 'true' : 'false'}
            data-read-riccardo={item.consumption?.read_by_riccardo ? 'true' : 'false'}
            data-title={item.cleanTitle}
            data-snippet={item.snippet || ''}
            data-ymd={item.ymdCreated}
            data-sender-label={`${item.sender.emoji} ${item.sender.name} (${item.sender.role})`}
            data-dates-label={`${item.cat.natureCode} · ${item.cat.catLabel} · ${item.ymdCreated}`}
            data-source-url={item.provenance.extUrl || ''}
            data-source-label={item.provenance.extLabel || ''}
            data-prov-kind={item.provenance.kind}
            data-prov-tag={item.provenance.shortTag}
            data-prov-badge={item.provenance.badgeLabel}
            data-prov-origin={item.provenance.originDesc}
            data-prov-from={item.provenance.fromLine}
            data-prov-subject={item.provenance.subjectLine}
            data-prov-ts={item.provenance.timestampYmdHm}
          >
            <!-- 1. COL 1 (Leftmost!): Kid Badge with 🐉 (Ale) / 🚗 (Seb) / 🐉🚗 (A+S) + Unread Dot -->
            <div class="cell-kid">
              <button
                type="button"
                class="read-dot-btn"
                data-action="toggle-read"
                title="Segna come letto / da leggere"
                aria-label={`Segna ${item.cleanTitle} come letto o non letto`}
              >
                <span class="unread-dot"></span>
              </button>
              <span class={`kid-badge3 kid-badge-${item.kidCode === 'Ale' ? 'ale' : (item.kidCode === 'Seb' ? 'seb' : 'both')}`}>
                {item.kidCode === 'Ale' ? '🐉 Ale' : (item.kidCode === 'Seb' ? '🚗 Seb' : '🐉🚗 A+S')}
              </span>
            </div>

            <!-- 2. COL 2: Sender Avatar + Country/Subject Emoji + Name -->
            <div class="cell-sender">
              <div class="sender-avatar-wrap" title={`${item.sender.name} (${item.sender.email}) — ${item.sender.role}`}>
                <div class="sender-avatar" style={`background: ${item.sender.bgGradient};`}>
                  <span class="sender-initials">{item.sender.initials}</span>
                </div>
                <span class="sender-emoji-badge" aria-hidden="true">{item.sender.emoji}</span>
              </div>

              <div class="sender-text-meta">
                <span class="sender-name-line">{item.sender.shortName}</span>
                <span class="sender-role-line">{item.sender.emoji} {item.sender.role}</span>
              </div>
            </div>

            <!-- 3. COL 3: Readable Dates: Lun 16 Nov + Auto-Archive -->
            <div class="cell-dates">
              <span class="date-created" title="Data creazione / evento">{item.ymdCreated}</span>
              <span
                class={`date-archive ${item.daysUntilArchive <= 2 ? 'archive-soon' : ''}`}
                title="Scadenza Auto-Archive (+7 giorni dopo il compito/evento)"
              >
                ⏳ {item.ymdAutoArchive}
              </span>
            </div>

            <!-- 4. Subject + Snippet + Inline Yellow Note Pill (Click opens full reader modal) -->
            <div class="cell-content" data-action="open-detail" tabindex="0" role="button" aria-label={`Leggi ${item.cleanTitle}`}>
              <div class="subject-line">
                <span
                  class={`prov-chip prov-${item.provenance.kind}`}
                  title={`${item.provenance.badgeLabel} — ${item.provenance.originDesc} (${item.provenance.timestampYmdHm})`}
                >
                  {item.provenance.shortTag}
                </span>
                <span
                  class={`nat-badge ${isAction ? 'nat-act' : 'nat-fyi'}`}
                  title={isAction ? 'Action Required: richiede azione' : 'FYI: solo informativo'}
                >
                  {item.cat.natureEmoji} {item.cat.natureCode}
                </span>
                <span
                  class={`cat-badge cat-${item.cat.catKey}`}
                  title={`Categoria: ${item.cat.catLabel}`}
                >
                  {item.cat.catEmoji} {item.cat.catCode}
                </span>
                <span class="subject-title">{item.cleanTitle}</span>
                {item.snippet && <span class="subject-snippet">— {item.snippet}</span>}
              </div>

              <!-- Auto-Parsed Google Photos / Drive Direct Chips right on the row! -->
              {item.photoAlbums && item.photoAlbums.length > 0 && (
                <div class="row-photo-chips">
                  {item.photoAlbums.map((pa: PhotoAlbumEntry) => (
                    <a
                      href={pa.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="row-gphoto-pill"
                      title={`Apri direttamente l'album su ${pa.provider}: ${pa.activityLabel}`}
                    >
                      {pa.providerIcon} {pa.provider} · {pa.activityEmoji} {pa.activityLabel} ↗
                    </a>
                  ))}
                </div>
              )}

              <!-- Sticky Note Pill (visible whenever a note is attached) -->
              <div class={`note-inline-pill ${initNote ? '' : 'hidden'}`} data-role="note-pill">
                <span class="note-pill-icon">📝</span>
                <span class="note-pill-text" data-role="note-text">{initNote}</span>
              </div>

              <!-- Hidden rendered HTML for modal reader (/show/) -->
              <template class="item-body-template">
                {item.photoAlbums && item.photoAlbums.length > 0 && (
                  <div class="modal-extracted-photos-box">
                    <div class="modal-extracted-photos-hdr">
                      📸 <strong>Album Foto Estratti Automaticamente da questa Email:</strong>
                    </div>
                    <div class="modal-extracted-photos-list">
                      {item.photoAlbums.map((pa: PhotoAlbumEntry) => (
                        <a
                          href={pa.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-open-gphotos"
                        >
                          {pa.providerIcon} Apri su {pa.provider} ({pa.activityEmoji} {pa.activityLabel}) ↗
                        </a>
                      ))}
                    </div>
                  </div>
                )}
                <div class="rendered-markdown" set:html={item.renderedBody} />
              </template>
            </div>

            <!-- 5. Right-side Controls: Clean monochrome Archivia · Snooze 7g · Nota -->
            <div class="cell-controls">
              <button
                type="button"
                class="btn-row-archive"
                data-action="archive-read"
                title="Marca come letta e rimuovi dalla Inbox (Archivia)"
                aria-label={`Archivia ${item.cleanTitle}`}
              >
                <span class="btn-archive-label">✓ Archivia</span>
              </button>

              <button
                type="button"
                class="btn-row-snooze"
                data-action="snooze-7d"
                title="Snooze per 7 giorni (scompare dalla Inbox e torna tra 7 giorni)"
                aria-label={`Snooze 7 giorni per ${item.cleanTitle}`}
              >
                <span class="btn-snooze-label">Snooze 7g</span>
              </button>

              <button
                type="button"
                class={`btn-note ${initNote ? 'has-note-btn' : ''}`}
                data-action="open-note"
                title={initNote ? `Modifica nota: ${initNote}` : 'Aggiungi una nota'}
                aria-label={`Nota per ${item.cleanTitle}`}
              >
                <span class="btn-note-label">{initNote ? 'Nota' : '+Nota'}</span>
              </button>
            </div>
          </article>
        );
      })}
    </div>

    <div id="empty-inbox-banner" class="empty-inbox hidden">
      <p>🎉 Nessun messaggio o compito in questa vista!</p>
    </div>
  </div>

  <!-- Native <dialog> for Reading Full Email / Event (/show/) — Clean Provenance-First Design -->
  <dialog id="detail-dialog" class="piota-dialog" closedby="any" aria-labelledby="dialog-title">
    <div class="dialog-header">
      <div class="dialog-title-stack">
        <div class="dialog-meta-top">
          <span id="dialog-prov-badge" class="dialog-prov-pill"></span>
          <span id="dialog-dates-badge" class="dialog-dates-pill"></span>
        </div>
        <h2 id="dialog-title">Dettaglio</h2>
      </div>
      <form method="dialog">
        <button type="submit" class="dialog-close-btn" aria-label="Chiudi finestra">✕</button>
      </form>
    </div>

    <!-- Structured Provenance Header (Immediate distinction: Email vs Classroom Calendar vs AI/Auto) -->
    <div id="dialog-provenance-bar" class="dialog-provenance-bar">
      <div class="prov-grid">
        <span class="prov-k" id="dialog-prov-k-from">Mittente</span>
        <span class="prov-v" id="dialog-prov-v-from"></span>

        <span class="prov-k" id="dialog-prov-k-subj">Oggetto</span>
        <span class="prov-v prov-v-strong" id="dialog-prov-v-subj"></span>

        <span class="prov-k">Data</span>
        <span class="prov-v prov-v-mono" id="dialog-prov-v-ts"></span>

        <span class="prov-k">Origine</span>
        <span class="prov-v prov-v-origin" id="dialog-prov-v-origin"></span>
      </div>
    </div>

    <div class="dialog-body" id="dialog-body-content"></div>

    <!-- Subtle Neutral Inline Note Bar -->
    <div class="dialog-note-box">
      <label for="dialog-note-input" class="dialog-note-label">Nota</label>
      <div class="dialog-note-row">
        <input
          type="text"
          id="dialog-note-input"
          placeholder="Aggiungi una nota condivisa (es. firmato, nello zaino, ripassare p. 11)..."
        />
        <button type="button" id="dialog-save-note-btn" class="btn-note-save-subtle">Salva</button>
      </div>
    </div>

    <!-- Calm, Non-Pacchiano Single-Row Footer -->
    <div class="dialog-footer">
      <div class="dialog-footer-actions">
        <button type="button" id="dialog-ho-letto-btn" class="btn-modal-archive" title="Segna come letto e archivia dalla Inbox">
          <svg class="btn-svg-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
          <span>Archivia (letto)</span>
        </button>
        <button type="button" id="dialog-snooze-btn" class="btn-modal-ghost" title="Nascondi dalla Inbox per 7 giorni">
          <svg class="btn-svg-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
          </svg>
          <span>Snooze 7g</span>
        </button>
        <a id="dialog-source-link" href="#" target="_blank" rel="noopener noreferrer" class="btn-modal-link hidden">
          <span id="dialog-source-link-text">Apri in Gmail</span>
          <svg class="btn-svg-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
          </svg>
