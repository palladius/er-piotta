function inferSubjects(item: any, sender: any, cat: any): string[] {
  const titleL = String(item.title || '').toLowerCase();
  const bodyL = String(item.body || '').toLowerCase();
  const text = `${titleL} ${bodyL}`;
  const subjs = new Set<string>();

  // 1. Photos
  if (
    cat.catKey === 'photos' ||
    ['photo', 'photos', 'album', 'behind the scenes', 'photos.app.goo.gl', 'weekly photo'].some(k => text.includes(k))
  ) {
    subjs.add('photos');
  }

  // 2. Piano
  if (['pianoforte', 'lezione di piano', 'spartiti'].some(k => text.includes(k))) {
    subjs.add('piano');
  }

  // 3. French (FR)
  if (
    sender.key === 'conde' ||
    ['french', 'français', 'leçon', 'mon emploi du temps', 'aconde', 'amaia conde', 'matériel scolaire'].some(k => text.includes(k))
  ) {
    subjs.add('fr');
  }

  // 4. German (DE)
  if (
    ['deutsch', 'übungsheft', 'schreibheft', 'diktat', 'lesung'].some(k => text.includes(k))
  ) {
    subjs.add('de');
  }

  // 5. Math
  if (
    ['mathe', 'mathematik', 'lzk', 'lernzielkontrolle', 'ziffern schreiben', 'matheplan', 'arbeitsblatt', 'mathetest', 'ordnen / zerlegen'].some(k => text.includes(k))
  ) {
    subjs.add('math');
  }

  // 6. English (EN)
  if (
    ['english', 'gps', 'grammar', 'punctuation', 'spelling', 'reading comprehension', 'reading book', 'raz kids', 'raz-kids', 'sats', 'phonics', 'reading journals'].some(k => text.includes(k))
  ) {
    subjs.add('en');
  }

  // 7. Everything else (or admin/library/trips/billing) -> misc
  if (subjs.size === 0) {
    subjs.add('misc');
  }

  return Array.from(subjs);
}

interface ProvenanceInfo {
  kind: 'email' | 'gcal' | 'ai_auto' | 'piota_legacy';
  shortTag: string;
  badgeLabel: string;
  originDesc: string;
  fromLine: string;
  subjectLine: string;
  timestampYmdHm: string;
  extLabel: string;
  extUrl: string;
}

function formatYmdHmZurich(isoOrDate: string): string {
  const raw = String(isoOrDate || '').trim();
  if (!raw) return '—';
  // Date-only string YYYY-MM-DD -> YYYYMMDD
  if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) {
    return raw.replace(/-/g, '');
  }
  const d = new Date(raw);
  if (isNaN(d.getTime())) {
    return raw.slice(0, 10).replace(/-/g, '');
  }
  const parts = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Zurich',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(d);
  const get = (t: string) => parts.find(p => p.type === t)?.value || '00';
  return `${get('year')}${get('month')}${get('day')} ${get('hour')}:${get('minute')}`;
}

function inferProvenance(item: any, sender: any, cleanTitle: string, primaryDate: string, effKidCode: string): ProvenanceInfo {
  const id = String(item.id || '');
  const body = String(item.body || '');
  const srcUrl = String(item.source_url || '');
  const mFrom = body.match(/^\*\*From:\*\*\s*(.+)$/m);
  const rawFrom = mFrom ? mFrom[1].trim() : `${sender.name}${sender.email ? ` <${sender.email}>` : ''}`;
  const mDate = body.match(/^\*\*Date:\*\*\s*(.+)$/m);
  const rawTimestamp = mDate ? mDate[1].trim() : String(item.created_at || primaryDate || '');
  const ymdHm = formatYmdHmZurich(rawTimestamp);

  // 1. Auto-generated / AI synthetic messages
  const isPianoAuto = id.includes('piano');
  const isAiEvent = id.startsWith('event_ai_') || item.source === 'piotta_ai_gcal';
  const isAiBriefingEmail = id.startsWith('alert_gmail_') && (
    rawFrom.toLowerCase().includes('tandemims30@gmail.com') ||
    cleanTitle.toLowerCase().includes('briefing settimana')
  );

  if (isPianoAuto) {
    return {
      kind: 'ai_auto',
      shortTag: 'AUTO',
      badgeLabel: 'Auto-generato · Er Piotta',
      originDesc: 'Regola ricorrente locale (Pianoforte ogni lunedì) — non deriva da un\'email della scuola',
      fromLine: 'Er Piotta · Regola automatica',
      subjectLine: cleanTitle,
      timestampYmdHm: primaryDate.replace(/-/g, ''),
      extLabel: '',
      extUrl: '',
    };
  }

  if (isAiEvent) {
    return {
      kind: 'ai_auto',
      shortTag: 'AI',
      badgeLabel: 'AI · Piotta AI GCal',
      originDesc: 'Promemoria generato dall\'AI (Piotta AI GCal) a partire da email e calendario classe',
      fromLine: 'Er Piotta AI · Piotta AI GCal',
      subjectLine: cleanTitle,
      timestampYmdHm: primaryDate.replace(/-/g, ''),
      extLabel: srcUrl.startsWith('http') ? 'Apri su Piotta AI GCal' : '',
      extUrl: srcUrl.startsWith('http') ? srcUrl : '',
    };
  }

  if (isAiBriefingEmail) {
    return {
      kind: 'ai_auto',
      shortTag: 'AI',
      badgeLabel: 'AI Briefing · Er Piotta',
      originDesc: 'Riassunto settimanale generato automaticamente dall\'AI e inviato a tandemims30@gmail.com',
      fromLine: rawFrom,
      subjectLine: String(item.title || cleanTitle),
      timestampYmdHm: ymdHm,
      extLabel: srcUrl.startsWith('http') ? 'Apri in Gmail' : '',
      extUrl: srcUrl.startsWith('http') ? srcUrl : '',
    };
  }

  // 2. Real Gmail email
  if (id.startsWith('alert_gmail_') || srcUrl.includes('mail.google.com')) {
    return {
      kind: 'email',
      shortTag: 'EMAIL',
      badgeLabel: 'Email · Gmail',
      originDesc: 'Email reale ricevuta su tandemims30@gmail.com',
      fromLine: rawFrom,
      subjectLine: String(item.title || cleanTitle),
      timestampYmdHm: ymdHm,
      extLabel: srcUrl.startsWith('http') ? 'Apri in Gmail' : '',
      extUrl: srcUrl.startsWith('http') ? srcUrl : '',
    };
  }

  // 3. Google Classroom / School Calendar event
  if (item.type === 'event') {
    const isP3 = effKidCode === 'Ale' || id.includes('_p3_');
    const isP1 = effKidCode === 'Seb' || id.includes('_p1_');
    const calName = isP3
      ? 'Google Calendar Primary 3 (Ale)'
      : isP1
        ? 'Google Calendar Primary 1 (Seby)'
        : 'Calendario Scuola Tandem IMS';
    const calEmbed = isP3
      ? 'https://calendar.google.com/calendar/embed?src=c_classrooma99337a8%40group.calendar.google.com&ctz=Europe%2FZurich'
      : isP1
        ? 'https://calendar.google.com/calendar/embed?src=c_classroomc12e3a05%40group.calendar.google.com&ctz=Europe%2FZurich'
        : '';
    return {
      kind: 'gcal',
      shortTag: 'GCAL',
      badgeLabel: isP3 ? 'Calendario · P3' : isP1 ? 'Calendario · P1' : 'Calendario Scuola',
      originDesc: `Evento importato dal ${calName}`,
      fromLine: calName,
      subjectLine: cleanTitle,
      timestampYmdHm: primaryDate.replace(/-/g, ''),
      extLabel: (srcUrl.startsWith('http') || calEmbed) ? 'Apri Calendario' : '',
      extUrl: srcUrl.startsWith('http') ? srcUrl : calEmbed,
    };
  }

  // 4. Legacy Piota app alert
  return {
    kind: 'piota_legacy',
    shortTag: 'PIOTA',
    badgeLabel: 'Archivio · App Piota',
    originDesc: 'Comunicazione scolastica importata dalla vecchia app Piota (dismessa)',
    fromLine: rawFrom,
    subjectLine: String(item.title || cleanTitle),
    timestampYmdHm: ymdHm,
    extLabel: '',
    extUrl: '',
  };
}

// Enrich and deduplicate items
const seenDedup = new Set<string>();
const enrichedItems = cleanFeed
  .map((item: any) => {
    const rawCreated = String(item.created_date || item.created_at || item.crawled_at || item.datestart || todayIso).slice(0, 10);
    const rawEvent = String(item.event_date || item.datestart || item.ticket?.due_date || rawCreated).slice(0, 10);
    let autoArchiveIso = String(item.auto_archive_at || '').slice(0, 10);
    if (!autoArchiveIso) {
      const ttlDays = item.type === 'event' || item.ticket?.due_date ? 7 : 14;
      const baseD = new Date((item.type === 'event' ? rawEvent : rawCreated) + 'T12:00:00Z');
      autoArchiveIso = isNaN(baseD.getTime())
        ? new Date(Date.now() + 7 * 86400000).toISOString().slice(0, 10)
        : new Date(baseD.getTime() + ttlDays * 86400000).toISOString().slice(0, 10);
    }
    const primaryDate = item.type === 'event' ? rawEvent : rawCreated;
    const ymdCreated = formatYmdDay(primaryDate);
    const aaInfo = formatYmdRel(autoArchiveIso);
    const isAutoExpired = autoArchiveIso < todayIso;
    const isManuallyArchived = Boolean(item.consumption?.archived);
    const sender = inferSender(item);
    const cat = inferCategory(item);
    const subjects = inferSubjects(item, sender, cat);
    const effKidCode = sender.kidCode || item.kid_code || 'A+S';

    // Clean title prefix
    let cleanTitle = String(item.title || 'Untitled').trim();
    for (const pref of ['[P1 Seby] ', '[P3 Ale] ', '[P1] ', '[P3] ']) {
      if (cleanTitle.startsWith(pref)) cleanTitle = cleanTitle.slice(pref.length);
    }

    const photoAlbums = extractPhotoLinksForItem(item, sender, cleanTitle, ymdCreated, primaryDate, effKidCode);
    if (photoAlbums.length > 0 && !subjects.includes('photos')) {
      subjects.push('photos');
    }

    const provenance = inferProvenance(item, sender, cleanTitle, primaryDate, effKidCode);

    // Strip redundant leading **From:** / **Date:** lines from modal body since provenance bar displays them cleanly
    const modalRawBody = String(item.body || '')
      .replace(/^\*\*From:\*\*.*\n?/gm, '')
      .replace(/^\*\*Date:\*\*.*\n?/gm, '')
      .trim();

    // Build snippet (strip Dear Parents / Liebe Eltern / Piota transition boilerplate & DE->EN marker)
    const rawBody = String(item.body || '')
      .replace(/\[\[AUTO_TRANSLATED_DE_EN_V1\.2\.3\]\]/g, '')
      .replace(/\n---[\s\S]*$/m, '')
      .replace(/^\*\*From:\*\*.*$/gm, '')
      .replace(/^\*\*Date:\*\*.*$/gm, '')
      .replace(/^Class calendar event.*$/gm, '')
      .replace(/^(Dear Parents,|Liebe Eltern,)\s*/gim, '')
      .replace(/^(Kind regards,|Mit freundlichen Grüssen|Freundliche Grüsse|Warmly,)[\s\S]*$/gim, '')
      .replace(/Da Piota leider nicht mehr nutzbar ist,\s*teile ich Ihnen nun per Mail mit,\s*dass\s*/gi, '')
      .replace(/As you may be aware,\s*the Piota app is unfortunately no longer available\.\s*/gi, '')
      .replace(/\[([^\]]+)\]\(https?:\/\/[^\s)]+\)/g, '$1')
      .trim();
    const snippet = rawBody.replace(/\s+/g, ' ').slice(0, 150);

    return {
      ...item,
      nature: cat.nature,
      cat,
      provenance,
      cleanTitle,
      snippet,
      primaryDate,
      autoArchiveIso,
      ymdCreated,
      ymdAutoArchive: aaInfo.text,
      daysUntilArchive: aaInfo.daysLeft,
      isAutoExpired,
      isManuallyArchived,
      isArchivedDefault: isAutoExpired || isManuallyArchived,
      sender,
      subjects,
      photoAlbums,
      kidCode: effKidCode,
      renderedBody: renderSimpleMarkdown(modalRawBody),
    };
  })
  .filter((item: any) => {
    // Hide far-future recurring events > 21 days out so the inbox stays crisp
    if (item.type === 'event' && item.primaryDate > maxFutureDate) return false;
    const dedupKey = `${item.primaryDate}|${item.kidCode}|${item.cleanTitle.toLowerCase()}`;
    if (seenDedup.has(dedupKey)) return false;
    seenDedup.add(dedupKey);
    return true;
  })
  .sort((a: any, b: any) => {
    // Tier 0: Upcoming events (>= todayIso) in chronological order (next 7 days first!)
    // Tier 1: Action-required emails (newest first)
    // Tier 2: FYI emails (newest first)
    // Tier 3: Past events (< todayIso, not yet auto-archived)
    const tierOf = (x: any) => {
      if (x.type === 'event' && x.primaryDate >= todayIso && x.primaryDate <= new Date(Date.now() + 8 * 86400000).toISOString().slice(0, 10)) {
        return 0;
      }
      if (x.type === 'alert' && x.nature === 'action_required') return 1;
      if (x.type === 'event' && x.primaryDate >= todayIso) return 2;
      if (x.type === 'alert') return 3;
      return 4;
    };
    const ta = tierOf(a);
    const tb = tierOf(b);
    if (ta !== tb) return ta - tb;
    if (ta === 0 || ta === 2) return a.primaryDate.localeCompare(b.primaryDate);
    return b.primaryDate.localeCompare(a.primaryDate);
  });

// Collect and deduplicate all parsed Google Photos & Google Drive albums across all school emails
const seenAlbumUrls = new Set<string>();
const allPhotoAlbums: PhotoAlbumEntry[] = [];
for (const it of enrichedItems) {
  for (const pa of (it.photoAlbums || [])) {
    if (!seenAlbumUrls.has(pa.url)) {
      seenAlbumUrls.add(pa.url);
      allPhotoAlbums.push(pa);
    }
  }
}
allPhotoAlbums.sort((a, b) => b.primaryDate.localeCompare(a.primaryDate));

// Daily Mini-RAG: Build "Top of Mind" Next-Week Markdown Summary with Local Magic Links (#item:<id>)
function findItemIdByHint(hint: string, kidHint?: string): string {
  const h = hint.toLowerCase();
  const match = enrichedItems.find((it: any) => {
    if (kidHint && it.kidCode !== kidHint && it.kidCode !== 'A+S') return false;
    const t = `${it.id} ${it.cleanTitle} ${it.snippet}`.toLowerCase();
    return t.includes(h);
  });
  return match ? match.id : '';
}

function magicLink(label: string, hint: string, kidHint?: string): string {
  const id = findItemIdByHint(hint, kidHint);
  return id ? `[${label}](#item:${id})` : `**${label}**`;
}

// Also dynamically include any upcoming events in the next 8 days not covered by the main highlights
const nextWeekEndIso = new Date(Date.now() + 8 * 86400000).toISOString().slice(0, 10);
const upcomingEventsNextWeek = enrichedItems.filter(
  (it: any) => it.type === 'event' && !it.isArchivedDefault && it.primaryDate >= todayIso && it.primaryDate <= nextWeekEndIso
);

const topOfMindRiccardoMd = [
