---
import Layout from '../layouts/Layout.astro';
import rawFeed from '../data/piota_feed.json';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

function formatDisplayDate(dateText?: string | null, title?: string, createdAt?: string): string {
  if (dateText) {
    const m = dateText.match(/(\d{1,2}\s+[A-Za-z]{3})/i);
    if (m) return m[1];
  }
  if (title) {
    const mTitle = title.match(/(\d{1,2})[./](\d{1,2})(?:[./](\d{2,4}))?/);
    if (mTitle) {
      const day = parseInt(mTitle[1], 10);
      const mo = parseInt(mTitle[2], 10);
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      if (mo >= 1 && mo <= 12) {
        return `${day} ${months[mo - 1]}`;
      }
    }
  }
  if (createdAt) {
    try {
      const d = new Date(createdAt);
      if (!isNaN(d.getTime())) {
        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        return `${d.getDate()} ${months[d.getMonth()]}`;
      }
    } catch (e) {}
  }
  return '';
}

function extractLinks(body: string) {
  let photosUrl: string | null = null;
  let calendarUrl: string | null = null;

  const photosMatch = body.match(/https?:\/\/(?:photos\.app\.goo\.gl\/[a-zA-Z0-9_-]+|photos\.google\.com\/[^\s\)]+)/i);
  if (photosMatch) {
    photosUrl = photosMatch[0].replace(/[).,;]+$/, '');
  }

  const calMatch = body.match(/https?:\/\/(?:calendar\.app\.google\/[a-zA-Z0-9_-]+|calendar\.google\.com\/[^\s\)]+)/i);
  if (calMatch) {
    calendarUrl = calMatch[0].replace(/[).,;]+$/, '');
  }

  return { photosUrl, calendarUrl };
}

// Format feed items into unified cards (Filtered for Seefeld Tandem IMS, no Kusnacht, no bus)
const items = rawFeed
  .filter(it => {
    const text = `${it.title} ${it.body || ''}`.toLowerCase();
    if (text.includes('küsnacht') || text.includes('kusnacht')) return false;
    if (text.includes('school bus') || text.includes('bus service')) return false;
    return true;
  })
  .map(it => {
    const c = it.consumption || {};
    const tk = it.ticket || {};
    const owner = (tk.owner || 'unassigned').toLowerCase();
    
    const kids = it.target_kids || ['All'];
    const isAle = kids.some((k: string) => k.toLowerCase() === 'ale' || k.toLowerCase() === 'alessandro');
    const isSeby = kids.some((k: string) => k.toLowerCase() === 'seby' || k.toLowerCase() === 'sebastian');
    const isAll = kids.some((k: string) => k.toLowerCase() === 'all') || (!isAle && !isSeby);

    const bodyText = it.body || '';
    const fullText = `${it.title} ${bodyText}`.toLowerCase();

    // Auto-archive expired routine notices (older than 7 days mentioning tomorrow/morgen/lost&found)
    const isExpiredRoutine = (
      (fullText.includes('tomorrow') || fullText.includes('morgen') || fullText.includes('lost & found') || fullText.includes('bring the books') || fullText.includes('bücher mitbringen')) &&
      (it.date_text?.includes('Sep') || it.title?.includes('.09.') || it.title?.includes('.9.'))
    );

    const isArchived = Boolean(c.archived || c.archived_by_riccardo || isExpiredRoutine);
    const displayDate = formatDisplayDate(it.date_text, it.title, it.created_at);
    const { photosUrl, calendarUrl } = extractLinks(bodyText);

    return {
      id: it.id,
      title: it.title,
      body: bodyText,
      titleIt: it.title_it || it.title,
      bodyIt: it.body_it || it.body || '',
      titleEn: it.title_en || it.title,
      bodyEn: it.body_en || it.body || '',
      hasTranslation: !!it.has_translation,
      nature: it.nature || 'jfyi',
      urgency: it.urgency || 'normal',
      targetKids: kids,
      classes: it.classes || [],
      isAle,
      isSeby,
      isAll,
      readRiccardo: !!c.read_by_riccardo,
      readKate: !!c.read_by_kate,
      isArchived,
      owner: owner === 'riccardo' ? 'riccardo' : (owner === 'kate' ? 'kate' : 'unassigned'),
      status: tk.status || 'open',
      dateText: it.date_text || '',
      displayDate,
      photosUrl,
      calendarUrl
    };
  });

// Stats
const totalCount = items.length;
const riccCount = items.filter(t => t.owner === 'riccardo').length;
const kateCount = items.filter(t => t.owner === 'kate').length;
const unassignedCount = items.filter(t => t.owner === 'unassigned').length;
const actionCount = items.filter(t => t.nature === 'action_required' && !t.isArchived).length;
---

<Layout title="Tandem IMS Seefeld · Smart Agenda & OKF Feed" activeTab="tickets">
  
  <!-- Header Bar -->
  <div class="glass-panel p-4 md:p-5 mb-5">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center space-x-3.5">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-400 via-amber-500 to-amber-600 flex items-center justify-center text-2xl shadow-lg shadow-amber-500/30 ring-2 ring-amber-300/40 text-slate-950">
          🎒
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="text-lg md:text-xl font-black text-white">Tandem IMS Seefeld · Feed & Action Items</h1>
            <span class="text-[10px] uppercase font-mono font-bold bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded border border-emerald-500/30 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Live OKF
            </span>
          </div>
          <p class="text-xs text-slate-300 mt-0.5">
            Inbox per <b>Alessandro (P3)</b> e <b>Sebastian (P1)</b> · Tandem IMS Seefeld. Clicca su qualsiasi messaggio per aprirlo.
          </p>
        </div>
      </div>

      <!-- Quick Owner Distribution Legend -->
      <div class="flex flex-wrap items-center gap-2.5">
        <!-- Riccardo Pill -->
        <div class="flex items-center space-x-2 bg-slate-900/90 border border-amber-400/40 px-3 py-1 rounded-xl shadow-sm">
          <img 
            src={`${baseUrl}/avatars/avatar_riccardo.png`} 
            alt="Riccardo" 
            class="w-6 h-6 rounded-full object-cover ring-2 ring-amber-400"
          />
          <div class="text-xs">
            <span class="text-amber-400 font-extrabold">Papà (Riccardo):</span>
            <span class="text-white font-mono font-bold ml-1">{riccCount}</span>
          </div>
        </div>

        <!-- Kate Pill -->
        <div class="flex items-center space-x-2 bg-slate-900/90 border border-purple-500/40 px-3 py-1 rounded-xl shadow-sm">
          <img 
            src={`${baseUrl}/avatars/avatar_kate.png`} 
            alt="Kate" 
            class="w-6 h-6 rounded-full object-cover ring-2 ring-purple-500"
          />
          <div class="text-xs">
            <span class="text-purple-400 font-extrabold">Mamma (Kate):</span>
            <span class="text-white font-mono font-bold ml-1">{kateCount}</span>
          </div>
        </div>

        <!-- Unassigned Pill -->
        <div class="flex items-center space-x-1.5 bg-slate-900/60 border border-slate-700/50 px-2.5 py-1 rounded-xl text-xs text-slate-400">
          <span class="font-semibold">Da assegnare:</span>
          <span class="text-slate-200 font-mono font-bold">{unassignedCount}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Filter Controls (Client Side) -->
  <div class="glass-panel p-3 mb-5 flex flex-wrap items-center justify-between gap-3">
    <!-- Kid Selection Tabs -->
    <div class="flex items-center space-x-2" id="kid-filters">
      <button data-filter="all" class="filter-btn active px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-emerald-500 text-slate-950 shadow-md">
        🏫 Tutti
      </button>
      <button data-filter="seby" class="filter-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-slate-800/80 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700/60">
        <img src={`${baseUrl}/avatars/avatar_sebi_school.jpg`} alt="Seby" class="w-5 h-5 rounded-full object-cover ring-2 ring-emerald-400" />
        <span class="text-emerald-400">Sebastian (P1)</span>
      </button>
      <button data-filter="ale" class="filter-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-slate-800/80 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700/60">
        <img src={`${baseUrl}/avatars/avatar_ale_school.jpg`} alt="Ale" class="w-5 h-5 rounded-full object-cover ring-2 ring-blue-400" />
        <span class="text-blue-400">Alessandro (P3)</span>
      </button>
    </div>

    <!-- Nature & Archive Filters -->
    <div class="flex items-center space-x-2" id="type-filters">
      <button data-type="active" class="type-btn active px-3 py-1 rounded-md text-xs font-semibold bg-slate-700 text-white">
        Attivi
      </button>
      <button data-type="action" class="type-btn px-3 py-1 rounded-md text-xs font-semibold bg-slate-800/80 text-amber-300 hover:bg-slate-700 border border-amber-500/30">
        ⚡ Azioni ({actionCount})
      </button>
      <button data-type="unread-ricc" class="type-btn px-3 py-1 rounded-md text-xs font-semibold bg-slate-800/80 text-emerald-300 hover:bg-slate-700 border border-emerald-500/30">
        📬 Non letti Riccardo
      </button>
      <button data-type="archived" class="type-btn px-3 py-1 rounded-md text-xs font-semibold bg-slate-800/80 text-slate-400 hover:bg-slate-700 border border-slate-700">
        📁 Archiviati
      </button>
    </div>
  </div>

  <!-- Main Multi-Column Layout: Feed Stream (2-3 cards per row) + Sidebar -->
  <div class="grid grid-cols-1 xl:grid-cols-4 gap-5">
    
    <!-- LEFT 3 COLS: Feed Stream in Responsive Grid (2 to 3 cards per row) -->
    <div class="xl:col-span-3 space-y-3">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-sm font-black text-white flex items-center gap-2">
          <span>📬</span>
          <span>Feed Comunicazioni & Compiti</span>
          <span class="text-xs font-mono bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full border border-slate-700" id="visible-count">{totalCount}</span>
        </h2>
        <span class="text-[11px] text-slate-400">Clicca su una card per visualizzare il contenuto completo</span>
      </div>

      <!-- 2-3 Cards per Row Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5" id="items-container">
        {items.map(item => {
          const isRicc = item.owner === 'riccardo';
          const isKate = item.owner === 'kate';

          const cardBorder = isRicc 
            ? 'border-amber-400/40 hover:border-amber-400/80 bg-gradient-to-br from-amber-950/20 via-slate-900/85 to-slate-900/95 shadow-amber-950/20' 
            : (isKate 
                ? 'border-purple-500/40 hover:border-purple-500/80 bg-gradient-to-br from-purple-950/20 via-slate-900/85 to-slate-900/95 shadow-purple-950/20' 
                : (item.isAle && !item.isSeby
                    ? 'border-slate-800/90 hover:border-blue-500/50 bg-slate-900/75'
                    : (item.isSeby && !item.isAle
                        ? 'border-slate-800/90 hover:border-emerald-500/50 bg-slate-900/75'
                        : 'border-slate-800/90 hover:border-slate-700 bg-slate-900/75'
                      )
                  )
              );

          return (
            <div 
              class={`glass-panel p-3.5 rounded-xl border transition-all duration-150 shadow-md item-card hover:bg-slate-850 cursor-pointer flex flex-col justify-between ${cardBorder}`}
              id={`card-${item.id}`}
              data-id={item.id}
              data-title={item.title}
              data-body={item.body}
              data-title-it={item.titleIt}
              data-body-it={item.bodyIt}
              data-date={item.displayDate}
              data-date-full={item.dateText}
              data-kids={item.targetKids.join(', ')}
              data-nature={item.nature}
              data-owner={item.owner}
              data-is-ale={item.isAle || item.isAll ? "true" : "false"}
              data-is-seby={item.isSeby || item.isAll ? "true" : "false"}
              data-read-ricc={item.readRiccardo ? "true" : "false"}
              data-archived={item.isArchived ? "true" : "false"}
              data-photos-url={item.photosUrl || ''}
              data-calendar-url={item.calendarUrl || ''}
            >
              <div>
                <!-- Top Row: Kid Avatars on Left; Prominent Date (DD MMM) + Owner Avatar on Right -->
                <div class="flex items-center justify-between gap-2 mb-2 pb-1.5 border-b border-slate-800/60">
                  
                  <!-- Left: Avatars & Zen Nature -->
                  <div class="flex items-center gap-1.5 flex-wrap">
                    
                    {/* Ale only: Blue ring + P3 micro badge */}
                    {item.isAle && !item.isSeby && !item.isAll && (
                      <div class="relative inline-flex items-center shrink-0 group/kid" title="Alessandro · Primary 3">
                        <img 
                          src={`${baseUrl}/avatars/avatar_ale_school.jpg`} 
                          alt="Ale (P3)" 
                          class="w-7 h-7 rounded-full object-cover ring-2 ring-blue-500 shadow-md bg-blue-950"
                        />
                        <span class="absolute -bottom-1 -right-1 text-[8px] font-black font-mono bg-blue-600 text-white px-1 rounded-full border border-slate-900 shadow">
                          P3
                        </span>
                      </div>
                    )}

                    {/* Seby only: Emerald ring + P1 micro badge */}
                    {item.isSeby && !item.isAle && !item.isAll && (
                      <div class="relative inline-flex items-center shrink-0 group/kid" title="Sebastian · Primary 1">
                        <img 
                          src={`${baseUrl}/avatars/avatar_sebi_school.jpg`} 
                          alt="Seby (P1)" 
                          class="w-7 h-7 rounded-full object-cover ring-2 ring-emerald-500 shadow-md bg-emerald-950"
                        />
                        <span class="absolute -bottom-1 -right-1 text-[8px] font-black font-mono bg-emerald-600 text-white px-1 rounded-full border border-slate-900 shadow">
                          P1
                        </span>
                      </div>
                    )}

                    {/* Both / All: Both avatars with micro tags */}
                    {(item.isAll || (item.isAle && item.isSeby)) && (
                      <div class="flex items-center -space-x-1.5 shrink-0 group/kid" title="Alessandro (P3) & Sebastian (P1)">
                        <div class="relative inline-flex items-center">
                          <img 
                            src={`${baseUrl}/avatars/avatar_sebi_school.jpg`} 
                            alt="Seby (P1)" 
                            class="w-6 h-6 rounded-full object-cover ring-2 ring-emerald-500 shadow-md z-10 bg-emerald-950"
                          />
                          <span class="absolute -bottom-1 -right-1 text-[7px] font-black font-mono bg-emerald-600 text-white px-0.5 rounded-full border border-slate-900 shadow z-20">
                            P1
                          </span>
                        </div>
                        <div class="relative inline-flex items-center">
                          <img 
                            src={`${baseUrl}/avatars/avatar_ale_school.jpg`} 
                            alt="Ale (P3)" 
                            class="w-6 h-6 rounded-full object-cover ring-2 ring-blue-500 shadow-md z-0 bg-blue-950"
                          />
                          <span class="absolute -bottom-1 -right-1 text-[7px] font-black font-mono bg-blue-600 text-white px-0.5 rounded-full border border-slate-900 shadow z-10">
                            P3
                          </span>
                        </div>
                      </div>
                    )}

                    {/* Nature Zen Tag */}
                    {item.nature === 'action_required' && (
                      <span class="w-5 h-5 rounded-md bg-amber-500/20 border border-amber-500/40 text-amber-400 flex items-center justify-center text-[10px] font-bold shrink-0" title="Azione Richiesta">
                        ⚡
                      </span>
                    )}
                    {item.nature === 'jfyi' && (
                      <span class="w-5 h-5 rounded-md bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-[10px] font-bold shrink-0" title="Info / JFYI">
                        🌿
                      </span>
                    )}
                    {item.nature === 'menu' && (
                      <span class="w-5 h-5 rounded-md bg-blue-500/20 border border-blue-500/40 text-blue-400 flex items-center justify-center text-[10px] font-bold shrink-0" title="Menù">
                        🍱
                      </span>
                    )}

                    {item.isArchived && (
                      <span class="text-[9px] font-mono bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded border border-slate-700" title="Archiviato">
                        📁
                      </span>
                    )}

                    {item.hasTranslation && (
                      <span class="text-[9px] font-mono bg-blue-950/80 text-blue-300 border border-blue-500/30 px-1 py-0.5 rounded" title="Originale in Tedesco">
                        DE
                      </span>
                    )}
                  </div>

                  <!-- Right: Prominent Date (DD MMM) + Owner Avatar (Only if claimed!) -->
                  <div class="flex items-center gap-1.5 shrink-0">
                    {item.displayDate && (
                      <span class="text-[11px] font-black font-mono text-amber-300 bg-slate-950/90 px-2 py-0.5 rounded border border-slate-700/80 shadow-inner">
                        {item.displayDate}
                      </span>
                    )}

                    {/* Papà (Riccardo) - Yellow ring */}
                    {isRicc && (
                      <div class="relative group shrink-0" title="Assegnato a Papà (Riccardo)">
                        <img 
                          src={`${baseUrl}/avatars/avatar_riccardo.png`} 
                          alt="Papà" 
                          class="w-6 h-6 rounded-full object-cover ring-2 ring-amber-400 shadow-sm"
                        />
                      </div>
                    )}

                    {/* Mamma (Kate) - Purple ring */}
                    {isKate && (
                      <div class="relative group shrink-0" title="Assegnato a Mamma (Kate)">
                        <img 
                          src={`${baseUrl}/avatars/avatar_kate.png`} 
                          alt="Mamma" 
                          class="w-6 h-6 rounded-full object-cover ring-2 ring-purple-500 shadow-sm"
                        />
                      </div>
                    )}

                    {/* Unassigned ("Nessuno"): Completely omitted from view! */}
                  </div>

                </div>

                <!-- Title (Clickable) -->
                <h3 class="text-xs md:text-sm font-bold text-white hover:text-amber-300 transition line-clamp-2 leading-snug card-title-clickable">
                  {item.title}
                </h3>

                <!-- Excerpt (Truncated) -->
                <p class="text-[11px] text-slate-300/90 mt-1 line-clamp-2 leading-relaxed card-body-clickable">
                  {item.body}
                </p>

                <!-- Dedicated Action Button for Photos or Calendar -->
                {item.photosUrl && (
                  <div class="mt-2.5" onclick="event.stopPropagation()">
                    <a 
                      href={item.photosUrl} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-bold text-[10px] shadow transition active:scale-95"
                    >
                      <span>📸</span>
                      <span>Apri Foto Google</span>
                      <span>↗</span>
                    </a>
                  </div>
                )}

                {item.calendarUrl && (
                  <div class="mt-2.5" onclick="event.stopPropagation()">
                    <a 
                      href={item.calendarUrl} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-[10px] shadow transition active:scale-95"
                    >
                      <span>📅</span>
                      <span>Prenota Colloquio</span>
                      <span>↗</span>
                    </a>
                  </div>
                )}
              </div>

              <!-- Micro Footer: CLI helper + Quick Archive -->
              <div class="mt-3 pt-2 border-t border-slate-800/80 flex items-center justify-between gap-1 text-[9px]" onclick="event.stopPropagation()">
                <code class="font-mono bg-slate-950/90 px-1.5 py-0.5 rounded border border-slate-800 text-emerald-400 truncate max-w-[130px]" title={`piota-cli read ${item.id} --as riccardo`}>
                  piota-cli read {item.id}
                </code>

                <button 
                  class="archive-toggle-btn font-mono font-bold px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 hover:bg-rose-950 hover:text-rose-300 border border-slate-700 transition shrink-0"
                  data-id={item.id}
                >
                  {item.isArchived ? 'Ripristina' : 'Archivia'}
                </button>
              </div>

            </div>
          );
        })}
      </div>
    </div>

    <!-- RIGHT 1 COL: Zurich Menu & Tools -->
    <div class="xl:col-span-1 space-y-4">
      
      <!-- Weekly Menu Card (Clickable Modal Trigger!) -->
      <div 
        id="menu-card-trigger"
        class="glass-panel p-4 rounded-xl border border-amber-500/40 bg-gradient-to-br from-amber-950/30 via-slate-900/70 to-slate-900/90 shadow-xl cursor-pointer hover:border-amber-400 transition group"
      >
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center space-x-2.5">
            <div class="w-9 h-9 rounded-lg bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-lg text-amber-400">
              🍱
            </div>
            <div>
              <h3 class="text-xs font-bold text-white group-hover:text-amber-300 transition">Menù della Settimana</h3>
              <p class="text-[10px] text-amber-300/80">Tandem IMS · Seefeld (Zürich)</p>
            </div>
          </div>
          <span class="text-xs bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded border border-amber-500/30 font-mono font-bold">KW 43</span>
        </div>

        <!-- Menu Table Thumbnail Preview -->
        <div class="rounded-lg overflow-hidden border border-slate-700/80 bg-white/5 relative group-hover:ring-2 ring-amber-400/50 transition">
          <img 
            src={`${baseUrl}/menu/menu_zurich_kw43_table.png`} 
            alt="Menüplan Zürich KW43" 
            class="w-full object-cover hover:scale-105 transition duration-300"
          />
          <div class="absolute inset-0 bg-slate-950/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition backdrop-blur-[1px]">
            <span class="bg-amber-500 text-slate-950 font-black text-xs px-3 py-1.5 rounded-lg shadow-lg flex items-center gap-1.5">
              <span>🔍</span>
              <span>Ingrandisci Menù</span>
            </span>
          </div>
        </div>
        <p class="text-[10px] text-slate-400 mt-2 text-center italic">
          Clicca per aprire la tabella completa in alta definizione
        </p>
      </div>

      <!-- Quick Action Commands -->
      <div class="glass-panel p-4 rounded-xl border border-slate-800 space-y-3">
        <h3 class="text-xs font-black text-white flex items-center gap-1.5">
          <span>⚡</span>
          <span>CLI per Riccardo & Agenti</span>
        </h3>
        <p class="text-[11px] text-slate-400 leading-relaxed">
          Comandi diretti da eseguire su pupurabbux o da prompt AI:
        </p>
        <div class="bg-slate-950/90 p-2.5 rounded-lg border border-slate-800 text-[10px] font-mono text-emerald-400 space-y-1">
          <div>$ piota-cli status</div>
          <div>$ piota-cli list --kid seby</div>
          <div>$ piota-cli read &lt;id&gt; --as riccardo</div>
          <div>$ piota-cli archive &lt;id&gt; --as riccardo</div>
          <div>$ piota-cli claim &lt;id&gt; --owner kate</div>
        </div>
      </div>

    </div>

  </div>

  <!-- MODAL 1: Detail Modal for Reading Entire Notice / Photos / Links -->
  <div id="detail-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="glass-panel max-w-2xl w-full max-h-[85vh] rounded-2xl border border-slate-700 shadow-2xl flex flex-col overflow-hidden bg-slate-900" onclick="event.stopPropagation()">
      <!-- Modal Header -->
      <div class="p-4 border-b border-slate-800 flex items-start justify-between gap-3 bg-slate-950/60">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span id="modal-badge-kid" class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-blue-500/20 text-blue-300 border border-blue-500/30"></span>
            <span id="modal-badge-nature" class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30"></span>
            <span id="modal-date" class="text-[11px] text-amber-300 font-mono font-bold bg-slate-950/80 px-2 py-0.5 rounded border border-slate-800"></span>
          </div>
          <h2 id="modal-title" class="text-lg md:text-xl font-bold text-white leading-snug"></h2>
        </div>
        <button id="modal-close-btn" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center text-base transition">
          ✕
        </button>
      </div>

      <!-- Modal Toolbar -->
      <div class="px-4 py-2 bg-slate-950/40 border-b border-slate-800/80 flex items-center justify-between gap-2 text-xs">
        <button id="modal-translate-btn" class="px-2.5 py-1 rounded bg-blue-950 text-blue-300 hover:bg-blue-900 border border-blue-500/40 text-[11px] font-mono flex items-center gap-1.5">
          🌐 <span id="modal-translate-label">Traduci in Italiano</span>
        </button>
        <div class="text-[11px] text-slate-400 font-mono">
          Owner: <strong id="modal-owner" class="text-white"></strong>
        </div>
      </div>

      <!-- Dedicated Banner for External Links (Photos/Calendar) inside Modal -->
      <div id="modal-action-banner" class="hidden px-4 pt-3"></div>

      <!-- Modal Body Content -->
      <div class="p-5 overflow-y-auto space-y-4 text-xs md:text-sm text-slate-200 leading-relaxed whitespace-pre-line font-sans" id="modal-body">
      </div>

      <!-- Modal Footer -->
      <div class="p-3.5 bg-slate-950/80 border-t border-slate-800 flex items-center justify-between gap-3">
        <code id="modal-cli-code" class="text-[10px] font-mono text-emerald-400 bg-slate-950 px-2 py-1 rounded border border-slate-800 select-all"></code>
        <button id="modal-bottom-close" class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs transition">
          Chiudi
        </button>
      </div>
    </div>
  </div>

  <!-- MODAL 2: Full Screen Zoom for Weekly Menu Zürich -->
  <div id="menu-modal" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="max-w-4xl w-full max-h-[90vh] rounded-2xl border border-amber-500/40 shadow-2xl flex flex-col overflow-hidden bg-slate-900" onclick="event.stopPropagation()">
      <div class="p-4 border-b border-slate-800 flex items-center justify-between bg-slate-950">
        <div>
          <h2 class="text-base font-bold text-white flex items-center gap-2">
            <span>🍱</span>
            <span>Menüplan Zürich KW43 (Tandem IMS Seefeld)</span>
          </h2>
          <p class="text-xs text-amber-400 font-mono">Kindergarten & Primary (P1 - P4)</p>
        </div>
        <button id="menu-modal-close" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center text-base transition">
          ✕
        </button>
      </div>
      <div class="p-4 overflow-auto flex items-center justify-center bg-slate-950/50">
        <img 
          src={`${baseUrl}/menu/menu_zurich_kw43_table.png`} 
          alt="Menüplan Zürich KW43 High-Res" 
          class="max-w-full rounded-lg shadow-2xl border border-slate-800"
        />
      </div>
      <div class="p-3 bg-slate-950 border-t border-slate-800 flex justify-end">
        <button id="menu-modal-close-bottom" class="px-4 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition">
          Chiudi Menù
        </button>
      </div>
    </div>
  </div>

</Layout>

<script>
  // Filter logic
  const kidButtons = document.querySelectorAll('#kid-filters .filter-btn');
  const typeButtons = document.querySelectorAll('#type-filters .type-btn');
  const cards = document.querySelectorAll('.item-card');
  const visibleCountEl = document.getElementById('visible-count');

  let activeKid = 'all';
  let activeType = 'active';

  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const isAle = card.getAttribute('data-is-ale') === 'true';
      const isSeby = card.getAttribute('data-is-seby') === 'true';
      const nature = card.getAttribute('data-nature');
      const readRicc = card.getAttribute('data-read-ricc') === 'true';
      const isArchived = card.getAttribute('data-archived') === 'true';

      let matchKid = false;
      if (activeKid === 'all') matchKid = true;
      else if (activeKid === 'ale') matchKid = isAle;
      else if (activeKid === 'seby') matchKid = isSeby;

      let matchType = false;
      if (activeType === 'active') matchType = (!isArchived);
      else if (activeType === 'archived') matchType = (isArchived);
      else if (activeType === 'action') matchType = (!isArchived && nature === 'action_required');
      else if (activeType === 'unread-ricc') matchType = (!isArchived && !readRicc);

      if (matchKid && matchType) {
        (card as HTMLElement).style.display = '';
        visible++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (visibleCountEl) visibleCountEl.textContent = visible.toString();
  }

  kidButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      kidButtons.forEach(b => {
        b.classList.remove('active', 'bg-emerald-500', 'text-slate-950');
        b.classList.add('bg-slate-800/80', 'text-slate-300');
      });
      btn.classList.add('active', 'bg-emerald-500', 'text-slate-950');
      btn.classList.remove('bg-slate-800/80', 'text-slate-300');
      activeKid = btn.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });

  typeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      typeButtons.forEach(b => {
        b.classList.remove('active', 'bg-slate-700', 'text-white');
        b.classList.add('bg-slate-800/80');
      });
      btn.classList.add('active', 'bg-slate-700', 'text-white');
      btn.classList.remove('bg-slate-800/80');
      activeType = btn.getAttribute('data-type') || 'active';
      applyFilters();
    });
  });

  // Archive Click Handler
  document.querySelectorAll('.archive-toggle-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const card = btn.closest('.item-card');
      if (!card) return;
      const isArchived = card.getAttribute('data-archived') === 'true';
      const newArchived = !isArchived;
      card.setAttribute('data-archived', newArchived ? 'true' : 'false');
      btn.textContent = newArchived ? 'Ripristina' : 'Archivia';
      applyFilters();
    });
  });

  // Notice Detail Modal Popup
  const detailModal = document.getElementById('detail-modal');
  const modalTitle = document.getElementById('modal-title');
  const modalBody = document.getElementById('modal-body');
  const modalDate = document.getElementById('modal-date');
  const modalBadgeKid = document.getElementById('modal-badge-kid');
  const modalBadgeNature = document.getElementById('modal-badge-nature');
  const modalOwner = document.getElementById('modal-owner');
  const modalCliCode = document.getElementById('modal-cli-code');
  const modalTranslateBtn = document.getElementById('modal-translate-btn');
  const modalTranslateLabel = document.getElementById('modal-translate-label');
  const modalActionBanner = document.getElementById('modal-action-banner');

  let currentModalItem: any = null;
  let isTranslated = false;

  function makeLinksClickable(text: string) {
    // 1. Convert markdown links [label](url) cleanly without trailing brackets
    let html = text.replace(/\[([^\]]+)\]\((https?:\/\/[^\s\)]+)\)/g, (match, label, url) => {
      const cleanUrl = url.replace(/[).,;]+$/, '');
      return `<a href="${cleanUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-amber-400 hover:text-amber-300 font-bold underline transition">${label} ↗</a>`;
    });
    // 2. Convert remaining raw URLs not preceded by href="
    html = html.replace(/(?<!href=")(https?:\/\/[^\s<>"'\)]+)/g, (match, url) => {
      const cleanUrl = url.replace(/[).,;]+$/, '');
      return `<a href="${cleanUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-blue-400 hover:text-blue-300 font-semibold underline break-all transition">${cleanUrl} ↗</a>`;
    });
    return html;
  }

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const photosUrl = card.getAttribute('data-photos-url');
      const calendarUrl = card.getAttribute('data-calendar-url');

      currentModalItem = {
        id: card.getAttribute('data-id'),
        title: card.getAttribute('data-title') || '',
        body: card.getAttribute('data-body') || '',
        titleIt: card.getAttribute('data-title-it') || '',
        bodyIt: card.getAttribute('data-body-it') || '',
        date: card.getAttribute('data-date') || '',
        dateFull: card.getAttribute('data-date-full') || '',
        kids: card.getAttribute('data-kids') || '',
        nature: card.getAttribute('data-nature') || '',
        owner: card.getAttribute('data-owner') || '',
        photosUrl,
        calendarUrl
      };

      isTranslated = false;
      if (modalTranslateLabel) modalTranslateLabel.textContent = 'Traduci in Italiano';

      if (modalTitle) modalTitle.textContent = currentModalItem.title;
      if (modalBody) modalBody.innerHTML = makeLinksClickable(currentModalItem.body);
      if (modalDate) modalDate.textContent = currentModalItem.date ? `📅 ${currentModalItem.date}` : '';
      if (modalBadgeKid) modalBadgeKid.textContent = currentModalItem.kids;
      if (modalBadgeNature) modalBadgeNature.textContent = currentModalItem.nature === 'action_required' ? '⚡ Action Required' : '🌿 JFYI';
      
      if (modalOwner) {
        const o = currentModalItem.owner.toLowerCase();
        if (o === 'riccardo') modalOwner.innerHTML = '<span class="text-amber-400 font-bold">Papà (Riccardo)</span>';
        else if (o === 'kate') modalOwner.innerHTML = '<span class="text-purple-400 font-bold">Mamma (Kate)</span>';
        else modalOwner.innerHTML = '<span class="text-slate-400 italic">Nessuno (Non assegnato)</span>';
      }

      if (modalCliCode) modalCliCode.textContent = `piota-cli read ${currentModalItem.id} --as riccardo`;

      // Dedicated action button in modal
      if (modalActionBanner) {
        if (photosUrl) {
          modalActionBanner.innerHTML = `
            <a href="${photosUrl}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-lg transition">
              <div class="flex items-center gap-2">
                <span class="text-base">📸</span>
                <span>Apri l'album fotografico su Google Photos</span>
              </div>
              <span class="bg-blue-700/60 px-2.5 py-1 rounded-lg text-[11px]">Apri Album ↗</span>
            </a>
          `;
          modalActionBanner.classList.remove('hidden');
        } else if (calendarUrl) {
          modalActionBanner.innerHTML = `
            <a href="${calendarUrl}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-lg transition">
              <div class="flex items-center gap-2">
                <span class="text-base">📅</span>
                <span>Prenota incontro con l'insegnante su Google Calendar</span>
              </div>
              <span class="bg-emerald-700/60 px-2.5 py-1 rounded-lg text-[11px]">Prenota Ora ↗</span>
            </a>
          `;
          modalActionBanner.classList.remove('hidden');
        } else {
          modalActionBanner.innerHTML = '';
          modalActionBanner.classList.add('hidden');
        }
      }

      if (detailModal) detailModal.classList.remove('hidden');
    });
  });

  function closeDetailModal() {
    if (detailModal) detailModal.classList.add('hidden');
  }

  document.getElementById('modal-close-btn')?.addEventListener('click', closeDetailModal);
  document.getElementById('modal-bottom-close')?.addEventListener('click', closeDetailModal);
  detailModal?.addEventListener('click', closeDetailModal);

  // Modal translation toggle
  modalTranslateBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!currentModalItem) return;
    isTranslated = !isTranslated;
    if (isTranslated) {
      if (modalTitle) modalTitle.textContent = currentModalItem.titleIt || currentModalItem.title;
      if (modalBody) modalBody.innerHTML = makeLinksClickable(currentModalItem.bodyIt || currentModalItem.body);
      if (modalTranslateLabel) modalTranslateLabel.textContent = 'Mostra Originale';
    } else {
      if (modalTitle) modalTitle.textContent = currentModalItem.title;
      if (modalBody) modalBody.innerHTML = makeLinksClickable(currentModalItem.body);
      if (modalTranslateLabel) modalTranslateLabel.textContent = 'Traduci in Italiano';
    }
  });

  // Menu Modal Zoom
  const menuModal = document.getElementById('menu-modal');
  const menuTrigger = document.getElementById('menu-card-trigger');

  function openMenuModal() {
    if (menuModal) menuModal.classList.remove('hidden');
  }
  function closeMenuModal() {
    if (menuModal) menuModal.classList.add('hidden');
  }

  menuTrigger?.addEventListener('click', openMenuModal);
  document.getElementById('menu-modal-close')?.addEventListener('click', closeMenuModal);
  document.getElementById('menu-modal-close-bottom')?.addEventListener('click', closeMenuModal);
  menuModal?.addEventListener('click', closeMenuModal);

  // Keyboard escape
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDetailModal();
      closeMenuModal();
    }
  });

  applyFilters();
</script>
