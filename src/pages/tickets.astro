---
import Layout from '../layouts/Layout.astro';
import rawFeed from '../data/piota_feed.json';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Format feed items into unified cards
const items = rawFeed.map(it => {
  const c = it.consumption || {};
  const tk = it.ticket || {};
  const owner = (tk.owner || 'unassigned').toLowerCase();
  
  // Format kids display
  const kids = it.target_kids || ['All'];
  const isAle = kids.some((k: string) => k.toLowerCase() === 'ale' || k.toLowerCase() === 'alessandro');
  const isSeby = kids.some((k: string) => k.toLowerCase() === 'seby' || k.toLowerCase() === 'sebastian');
  const isAll = kids.some((k: string) => k.toLowerCase() === 'all') || (!isAle && !isSeby);

  return {
    id: it.id,
    title: it.title,
    body: it.body || '',
    nature: it.nature || 'jfyi',
    urgency: it.urgency || 'normal',
    targetKids: kids,
    classes: it.classes || [],
    isAle,
    isSeby,
    isAll,
    readRiccardo: !!c.read_by_riccardo,
    readKate: !!c.read_by_kate,
    owner: owner === 'riccardo' ? 'riccardo' : (owner === 'kate' ? 'kate' : 'unassigned'),
    status: tk.status || 'open',
    dateText: it.date_text || ''
  };
});

// Stats
const totalCount = items.length;
const riccCount = items.filter(t => t.owner === 'riccardo').length;
const kateCount = items.filter(t => t.owner === 'kate').length;
const unassignedCount = items.filter(t => t.owner === 'unassigned').length;
const actionCount = items.filter(t => t.nature === 'action_required').length;
---

<Layout title="Tandem IMS · Smart Agenda & OKF Feed" activeTab="tickets">
  
  <!-- Header Bar -->
  <div class="glass-panel p-4 md:p-6 mb-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-400 via-amber-500 to-amber-600 flex items-center justify-center text-3xl shadow-lg shadow-amber-500/30 ring-2 ring-amber-300/40 text-slate-950">
          🎒
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="text-xl md:text-2xl font-black text-white">Tandem IMS · Knowledge & Smart Feed</h1>
            <span class="text-xs uppercase font-mono font-bold bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded border border-emerald-500/30 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Firestore & OKF Live
            </span>
          </div>
          <p class="text-xs md:text-sm text-slate-300 mt-0.5">
            Inbox autonoma e non-consumata per <b>Alessandro (P3)</b> e <b>Sebastian (P1)</b>. Sincronizzata con Firestore e Google Calendar.
          </p>
        </div>
      </div>

      <!-- Quick Owner Distribution Legend -->
      <div class="flex flex-wrap items-center gap-2.5">
        <!-- Riccardo Pill -->
        <div class="flex items-center space-x-2 bg-slate-900/90 border border-amber-400/40 px-3 py-1.5 rounded-xl shadow-sm">
          <img 
            src={`${baseUrl}/avatars/avatar_riccardo.png`} 
            alt="Riccardo" 
            class="w-7 h-7 rounded-full object-cover ring-2 ring-amber-400"
          />
          <div class="text-xs">
            <span class="text-amber-400 font-extrabold">Riccardo:</span>
            <span class="text-white font-mono font-bold ml-1">{riccCount}</span>
          </div>
        </div>

        <!-- Kate Pill -->
        <div class="flex items-center space-x-2 bg-slate-900/90 border border-purple-500/40 px-3 py-1.5 rounded-xl shadow-sm">
          <img 
            src={`${baseUrl}/avatars/avatar_kate.png`} 
            alt="Kate" 
            class="w-7 h-7 rounded-full object-cover ring-2 ring-purple-500"
          />
          <div class="text-xs">
            <span class="text-purple-400 font-extrabold">Kate:</span>
            <span class="text-white font-mono font-bold ml-1">{kateCount}</span>
          </div>
        </div>

        <!-- Unassigned Pill -->
        <div class="flex items-center space-x-2 bg-slate-900/90 border border-slate-600/40 px-3 py-1.5 rounded-xl shadow-sm">
          <div class="w-7 h-7 rounded-full bg-slate-800 flex items-center justify-center text-xs text-slate-300 ring-2 ring-slate-400 font-bold">
            👤
          </div>
          <div class="text-xs">
            <span class="text-slate-300 font-extrabold">Nessuno:</span>
            <span class="text-white font-mono font-bold ml-1">{unassignedCount}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Filter Controls (Client Side) -->
  <div class="glass-panel p-4 mb-6 flex flex-wrap items-center justify-between gap-4">
    <!-- Kid Selection Tabs -->
    <div class="flex items-center space-x-2" id="kid-filters">
      <button data-filter="all" class="filter-btn active px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-emerald-500 text-slate-950 shadow-md">
        🏫 Tutti ({totalCount})
      </button>
      <button data-filter="seby" class="filter-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-slate-800/80 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700/60">
        <img src={`${baseUrl}/avatars/avatar_sebi_school.jpg`} alt="Seby" class="w-5 h-5 rounded-full object-cover ring-1 ring-emerald-400" />
        <span>Sebastian (P1)</span>
      </button>
      <button data-filter="ale" class="filter-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-slate-800/80 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700/60">
        <img src={`${baseUrl}/avatars/avatar_ale_school.jpg`} alt="Ale" class="w-5 h-5 rounded-full object-cover ring-1 ring-blue-400" />
        <span>Alessandro (P3)</span>
      </button>
    </div>

    <!-- Nature & Read Filters -->
    <div class="flex items-center space-x-2" id="type-filters">
      <button data-type="all" class="type-btn active px-3 py-1 rounded-md text-xs font-semibold bg-slate-700 text-white">
        Tutti i messaggi
      </button>
      <button data-type="action" class="type-btn px-3 py-1 rounded-md text-xs font-semibold bg-slate-800/80 text-rose-300 hover:bg-slate-700 border border-rose-500/30">
        ⚡ Solo Azioni ({actionCount})
      </button>
      <button data-type="unread-ricc" class="type-btn px-3 py-1 rounded-md text-xs font-semibold bg-slate-800/80 text-amber-300 hover:bg-slate-700 border border-amber-500/30">
        📬 Non letti Riccardo
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <!-- LEFT 2 COLS: Feed Stream -->
    <div class="lg:col-span-2 space-y-4">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-lg font-black text-white flex items-center gap-2">
          <span>📬</span>
          <span>Feed Comunicazioni & Compiti</span>
          <span class="text-xs font-mono bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full border border-slate-700" id="visible-count">{totalCount}</span>
        </h2>
        <span class="text-xs text-slate-400">Archivio non consumato per la famiglia</span>
      </div>

      <!-- Feed Cards List -->
      <div class="space-y-3.5" id="items-container">
        {items.map(item => {
          const isRicc = item.owner === 'riccardo';
          const isKate = item.owner === 'kate';
          const isUnassigned = item.owner === 'unassigned';

          // Ring & badge styles based on owner
          const avatarRing = isRicc 
            ? 'ring-2 ring-amber-400 ring-offset-2 ring-offset-slate-950 shadow-md shadow-amber-400/20' 
            : (isKate 
                ? 'ring-2 ring-purple-500 ring-offset-2 ring-offset-slate-950 shadow-md shadow-purple-500/20' 
                : 'ring-2 ring-slate-500 ring-offset-1 ring-offset-slate-950 opacity-70');

          const cardBorder = isRicc 
            ? 'border-amber-400/30 hover:border-amber-400/60 bg-gradient-to-r from-amber-950/20 via-slate-900/60 to-slate-900/90' 
            : (isKate 
                ? 'border-purple-500/30 hover:border-purple-500/60 bg-gradient-to-r from-purple-950/20 via-slate-900/60 to-slate-900/90' 
                : 'border-slate-800 hover:border-slate-700 bg-slate-900/60');

          return (
            <div 
              class={`glass-panel p-4 md:p-5 rounded-2xl border transition-all duration-200 shadow-lg item-card ${cardBorder}`}
              data-is-ale={item.isAle || item.isAll}
              data-is-seby={item.isSeby || item.isAll}
              data-nature={item.nature}
              data-read-ricc={item.readRiccardo}
            >
              <div class="flex items-start justify-between gap-3">
                <div class="flex-1 min-w-0">
                  
                  <!-- Tags Row -->
                  <div class="flex flex-wrap items-center gap-1.5 mb-2">
                    {/* Kid Badges */}
                    {item.targetKids.map((k: string) => (
                      <span class={`text-[10px] font-mono font-extrabold uppercase px-2 py-0.5 rounded tracking-wide ${
                        k.toLowerCase() === 'ale' 
                          ? 'bg-blue-500/20 text-blue-300 border border-blue-500/40' 
                          : (k.toLowerCase() === 'seby' 
                              ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40' 
                              : 'bg-purple-500/20 text-purple-300 border border-purple-500/40')
                      }`}>
                        {k.toLowerCase() === 'ale' ? '👦 Alessandro (P3)' : (k.toLowerCase() === 'seby' ? '🧒 Seby (P1)' : '🏫 Tutta la Scuola')}
                      </span>
                    ))}

                    {/* Nature Badge */}
                    {item.nature === 'action_required' && (
                      <span class="text-[10px] font-mono font-bold bg-rose-500/20 text-rose-300 border border-rose-500/40 px-2 py-0.5 rounded flex items-center gap-1">
                        ⚡ Azione Richiesta
                      </span>
                    )}
                    {item.nature === 'menu' && (
                      <span class="text-[10px] font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 px-2 py-0.5 rounded flex items-center gap-1">
                        🍱 Menu Mensa
                      </span>
                    )}
                    {item.nature === 'jfyi' && (
                      <span class="text-[10px] font-mono font-bold bg-slate-800 text-slate-400 border border-slate-700 px-2 py-0.5 rounded">
                        ℹ️ JFYI
                      </span>
                    )}

                    {/* Read Status Riccardo */}
                    <span class={`text-[10px] font-mono font-semibold px-2 py-0.5 rounded ${
                      item.readRiccardo ? 'bg-emerald-950/60 text-emerald-400 border border-emerald-800/40' : 'bg-slate-800 text-amber-300 border border-amber-500/30'
                    }`}>
                      {item.readRiccardo ? '✓ Letto Riccardo' : '○ Da leggere'}
                    </span>
                  </div>

                  <!-- Title -->
                  <h3 class="text-base md:text-lg font-bold text-white leading-snug">
                    {item.title}
                  </h3>

                  <!-- Description / Excerpt -->
                  <div class="text-xs md:text-sm text-slate-300 mt-2 line-clamp-3 leading-relaxed whitespace-pre-line">
                    {item.body}
                  </div>

                  {item.dateText && (
                    <div class="text-[11px] text-slate-500 mt-2 font-mono">
                      📅 {item.dateText}
                    </div>
                  )}
                </div>

                <!-- Owner Avatar Box (Riccardo / Kate / Unassigned) -->
                <div class="flex flex-col items-center justify-center pl-2 pt-1 min-w-[70px]">
                  <div class="relative group cursor-pointer" title={`Owner: ${item.owner}`}>
                    {isRicc && (
                      <img 
                        src={`${baseUrl}/avatars/avatar_riccardo.png`} 
                        alt="Riccardo" 
                        class={`w-11 h-11 rounded-full object-cover ${avatarRing}`}
                      />
                    )}
                    {isKate && (
                      <img 
                        src={`${baseUrl}/avatars/avatar_kate.png`} 
                        alt="Kate" 
                        class={`w-11 h-11 rounded-full object-cover ${avatarRing}`}
                      />
                    )}
                    {isUnassigned && (
                      <div class={`w-11 h-11 rounded-full bg-slate-800 flex items-center justify-center text-lg text-slate-400 ${avatarRing}`}>
                        👤
                      </div>
                    )}
                  </div>
                  <span class={`text-[10px] font-mono font-bold mt-1.5 uppercase ${
                    isRicc ? 'text-amber-400' : (isKate ? 'text-purple-400' : 'text-slate-500')
                  }`}>
                    {isRicc ? 'Riccardo' : (isKate ? 'Kate' : 'Nessuno')}
                  </span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- RIGHT COL: Weekly Menu & Quick Tools -->
    <div class="space-y-6">
      
      <!-- Weekly Menu Card -->
      <div class="glass-panel p-5 rounded-2xl border border-amber-500/30 bg-gradient-to-br from-amber-950/20 via-slate-900/60 to-slate-900/90 shadow-xl">
        <div class="flex items-center space-x-3 mb-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-xl">
            🍱
          </div>
          <div>
            <h3 class="text-sm font-bold text-white">Menù della Settimana</h3>
            <p class="text-[11px] text-amber-300/80">Tandem IMS · Küsnacht & Zürich</p>
          </div>
        </div>
        <div class="space-y-2 mt-4 text-xs text-slate-300">
          <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800">
            <span class="font-bold text-amber-400">📍 Menüplan Zürich KW43</span>
            <p class="text-[11px] text-slate-400 mt-1">Disponibile per KG & Primary (P1 - P4)</p>
          </div>
          <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800">
            <span class="font-bold text-slate-400">📍 Menüplan Küsnacht KW39</span>
          </div>
        </div>
      </div>

      <!-- Quick Action Commands -->
      <div class="glass-panel p-5 rounded-2xl border border-slate-800 space-y-4">
        <h3 class="text-sm font-black text-white flex items-center gap-2">
          <span>⚡</span>
          <span>CLI per Riccardo & AI Agents</span>
        </h3>
        <p class="text-xs text-slate-400 leading-relaxed">
          Puoi interrogare, assegnare o marcare come letto ogni avviso dal terminale con <code>piota-cli</code>:
        </p>
        <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800 text-[11px] font-mono text-emerald-400 space-y-1">
          <div>$ piota-cli status</div>
          <div>$ piota-cli list --kid seby</div>
          <div>$ piota-cli read &lt;id&gt; --as riccardo</div>
          <div>$ piota-cli claim &lt;id&gt; --owner kate</div>
        </div>
      </div>

    </div>

  </div>

</Layout>

<script>
  // Client-side filtering logic
  const kidButtons = document.querySelectorAll('#kid-filters .filter-btn');
  const typeButtons = document.querySelectorAll('#type-filters .type-btn');
  const cards = document.querySelectorAll('.item-card');
  const visibleCountEl = document.getElementById('visible-count');

  let activeKid = 'all';
  let activeType = 'all';

  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const isAle = card.getAttribute('data-is-ale') === 'true';
      const isSeby = card.getAttribute('data-is-seby') === 'true';
      const nature = card.getAttribute('data-nature');
      const readRicc = card.getAttribute('data-read-ricc') === 'true';

      let matchKid = false;
      if (activeKid === 'all') matchKid = true;
      else if (activeKid === 'ale') matchKid = isAle;
      else if (activeKid === 'seby') matchKid = isSeby;

      let matchType = false;
      if (activeType === 'all') matchType = true;
      else if (activeType === 'action') matchType = (nature === 'action_required');
      else if (activeType === 'unread-ricc') matchType = (!readRicc);

      if (matchKid && matchType) {
        (card as HTMLElement).style.display = 'block';
        visible++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (visibleCountEl) visibleCountEl.textContent = visible.toString();
  }

  kidButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      kidButtons.forEach(b => {
        b.classList.remove('active', 'bg-emerald-500', 'text-slate-950');
        b.classList.add('bg-slate-800/80', 'text-slate-300');
      });
      btn.classList.add('active', 'bg-emerald-500', 'text-slate-950');
      btn.classList.remove('bg-slate-800/80', 'text-slate-300');
      activeKid = btn.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });

  typeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      typeButtons.forEach(b => {
        b.classList.remove('active', 'bg-slate-700', 'text-white');
        b.classList.add('bg-slate-800/80');
      });
      btn.classList.add('active', 'bg-slate-700', 'text-white');
      btn.classList.remove('bg-slate-800/80');
      activeType = btn.getAttribute('data-type') || 'all';
      applyFilters();
    });
  });
</script>
