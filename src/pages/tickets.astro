<script>
  // State management: localStorage + live sync with /api/ticket -> Firestore (palladius-genai)
  const STORAGE_KEY = 'piota_gmail_state_v5';
  const USER_KEY = 'piota_active_parent_v5';

  interface ItemLocalState {
    owner?: string;
    note?: string;
    archived?: boolean;
    snoozed_until?: string;
    read_by_riccardo?: boolean;
    read_by_kate?: boolean;
  }

  let localStates: Record<string, ItemLocalState> = {};
  try {
    localStates = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
  } catch {
    localStates = {};
  }

  let activeUser = localStorage.getItem(USER_KEY) || 'riccardo';
  let activeTab = 'inbox';
  let activeKid = 'all';
  let activeSubj = 'all';
  let searchQuery = '';
  let aiFilterIds: Set<string> | null = null;
  let currentModalItemId: string | null = null;

  const rows = Array.from(document.querySelectorAll<HTMLElement>('.gmail-row'));
  const detailDialog = document.getElementById('detail-dialog') as HTMLDialogElement | null;
  const quickNoteDialog = document.getElementById('quick-note-dialog') as HTMLDialogElement | null;

  function saveLocalStates() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(localStates));
  }

  function updateSyncAgeBadge(isoStr?: string) {
    const wrap = document.getElementById('sync-status-wrap');
    const badge = document.getElementById('sync-status-badge');
    const reloadBtn = document.getElementById('btn-reload-sync');
    if (!wrap || !badge || !reloadBtn) return;

    const rawIso = isoStr || wrap.dataset.lastSynced || '';
    if (isoStr) wrap.dataset.lastSynced = isoStr;
    const syncDate = new Date(rawIso);
    if (isNaN(syncDate.getTime())) return;

    const diffMs = Math.max(0, Date.now() - syncDate.getTime());
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);

    let ageText = 'pochi minuti fa';
    if (diffDays >= 1) {
      ageText = `${diffDays} ${diffDays === 1 ? 'day' : 'days'} ago`;
    } else if (diffHours >= 1) {
      ageText = `${diffHours} ${diffHours === 1 ? 'hour' : 'hours'} ago`;
    } else if (diffMins >= 1) {
      ageText = `${diffMins} min ago`;
    }

    const isStale = diffDays >= 3;
    badge.classList.toggle('is-stale', isStale);
    reloadBtn.classList.toggle('is-stale-btn', isStale);
    if (isStale) {
      badge.textContent = `🔴 Last synced ${ageText} (>3 days!)`;
      reloadBtn.textContent = '🔴 Reload Sync Now!';
    } else {
      badge.textContent = `🟢 Last synced ${ageText}`;
      reloadBtn.textContent = '🔄 Reload Sync';
    }
  }

  async function persistToBackend(itemId: string, patch: ItemLocalState) {
    localStates[itemId] = { ...(localStates[itemId] || {}), ...patch };
    saveLocalStates();
    try {
      await fetch('/api/ticket', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: itemId, user: activeUser, ...patch }),
      });
    } catch {
      // Offline / static fallback: localStorage already has it
    }
  }

  function applyRowState(row: HTMLElement) {
    const id = row.dataset.id || '';
    const st = localStates[id] || {};

    const note = st.note !== undefined ? st.note : (row.dataset.note || '');
    const archived = st.archived !== undefined ? st.archived : (row.dataset.archived === 'true');
    const snoozedUntil = st.snoozed_until !== undefined ? st.snoozed_until : (row.dataset.snoozedUntil || '');
    const readR = st.read_by_riccardo !== undefined ? st.read_by_riccardo : (row.dataset.readRiccardo === 'true');

    row.dataset.note = note;
    row.dataset.archived = archived ? 'true' : 'false';
    row.dataset.snoozedUntil = snoozedUntil;
    row.dataset.readRiccardo = readR ? 'true' : 'false';

    row.classList.toggle('is-read', readR);
    row.classList.toggle('is-unread', !readR);
    row.classList.toggle('has-note', Boolean(note));

    const nowIso = new Date().toISOString();
    const isCurrentlySnoozed = Boolean(snoozedUntil && snoozedUntil > nowIso);

    // Sync Archive button label
    const archBtnLabel = row.querySelector<HTMLElement>('.btn-archive-label');
    if (archBtnLabel) {
      archBtnLabel.textContent = archived ? 'Ripristina' : 'Archivia';
    }

    // Sync Snooze button label
    const snoozeBtn = row.querySelector<HTMLElement>('[data-action="snooze-7d"]');
    const snoozeBtnLabel = row.querySelector<HTMLElement>('.btn-snooze-label');
    if (snoozeBtn && snoozeBtnLabel) {
      snoozeBtn.classList.toggle('is-snoozed-active', isCurrentlySnoozed);
      snoozeBtnLabel.textContent = isCurrentlySnoozed ? 'Sveglia' : 'Snooze 7g';
    }

    // Sync inline note pill & button
    const notePill = row.querySelector<HTMLElement>('[data-role="note-pill"]');
    const noteText = row.querySelector<HTMLElement>('[data-role="note-text"]');
    const noteBtn = row.querySelector<HTMLElement>('[data-action="open-note"]');
    const noteBtnLabel = row.querySelector<HTMLElement>('.btn-note-label');
    if (notePill && noteText) {
      noteText.textContent = note;
      notePill.classList.toggle('hidden', !note);
    }
    if (noteBtn && noteBtnLabel) {
      noteBtn.classList.toggle('has-note-btn', Boolean(note));
      noteBtnLabel.textContent = note ? 'Nota' : '+Nota';
      noteBtn.title = note ? `Modifica nota: ${note}` : 'Aggiungi una nota';
    }
  }

  function refreshAllAndFilter() {
    let cInbox = 0;
    let cAction = 0;
    let cNotes = 0;
    let cSnoozed = 0;
    let cArchived = 0;
    let visibleCount = 0;
    const nowIso = new Date().toISOString();

    // Matrix cell counters for current activeTab
    const matrixCounts: Record<string, number> = {
      'Ale:all': 0,
      'Ale:en': 0,
      'Ale:de': 0,
      'Ale:fr': 0,
      'Ale:math': 0,
      'Ale:piano': 0,
      'Seb:all': 0,
      'Seb:en': 0,
      'Seb:de': 0,
      'Seb:fr': 0,
      'Seb:math': 0,
      'Seb:piano': 0,
      'all:photos': 0,
      'all:misc': 0,
    };

    rows.forEach((row) => {
      applyRowState(row);
      const id = row.dataset.id || '';
      const isAutoExpired = row.dataset.autoExpired === 'true';
      const isManuallyArchived = row.dataset.archived === 'true';
      const isArchived = isAutoExpired || isManuallyArchived;
      const snoozedUntil = row.dataset.snoozedUntil || '';
      const isSnoozed = !isArchived && Boolean(snoozedUntil && snoozedUntil > nowIso);
      const isAction = row.dataset.nature === 'action_required';
      const hasNote = Boolean(row.dataset.note);
      const kid = row.dataset.kid || 'A+S';
      const rowSubjs = (row.dataset.subjects || 'misc').split(',').filter(Boolean);

      if (isArchived) {
        cArchived++;
      } else if (isSnoozed) {
        cSnoozed++;
      } else {
        cInbox++;
        if (isAction) cAction++;
        if (hasNote) cNotes++;
      }

      // Tab filter (Snoozed items disappear from Inbox for 7 days and return automatically!)
      let matchTab = false;
      if (activeTab === 'archived') matchTab = isArchived;
      else if (activeTab === 'snoozed') matchTab = isSnoozed;
      else if (activeTab === 'inbox') matchTab = !isArchived && !isSnoozed;
      else if (activeTab === 'action') matchTab = !isArchived && !isSnoozed && isAction;
      else if (activeTab === 'notes') matchTab = !isArchived && !isSnoozed && hasNote;

      // Update 2x5 matrix counters for rows matching the current Tab
      if (matchTab) {
        const isAleRow = kid === 'Ale' || kid === 'A+S';
        const isSebRow = kid === 'Seb' || kid === 'A+S';
        if (isAleRow) matrixCounts['Ale:all']++;
        if (isSebRow) matrixCounts['Seb:all']++;
        for (const s of ['en', 'de', 'fr', 'math', 'piano']) {
          if (rowSubjs.includes(s)) {
            if (isAleRow) matrixCounts[`Ale:${s}`]++;
            if (isSebRow) matrixCounts[`Seb:${s}`]++;
          }
        }
        if (rowSubjs.includes('photos')) matrixCounts['all:photos']++;
        if (rowSubjs.includes('misc')) matrixCounts['all:misc']++;
      }

      // Kid filter from 2x5 matrix
      const matchKid = activeKid === 'all' || kid === activeKid || kid === 'A+S';
      // Subject filter from 2x5 matrix
      const matchSubj = activeSubj === 'all' || rowSubjs.includes(activeSubj);
      // Search query
      const searchable = `${row.dataset.title || ''} ${row.dataset.snippet || ''} ${row.dataset.note || ''} ${row.dataset.senderLabel || ''}`.toLowerCase();
      const matchSearch = !searchQuery || searchable.includes(searchQuery);
      // AI matched IDs filter (when user clicks "Filtra queste righe nella tabella")
      const matchAi = !aiFilterIds || aiFilterIds.has(id);

      const show = matchTab && matchKid && matchSubj && matchSearch && matchAi;
      row.classList.toggle('hidden', !show);
      if (show) visibleCount++;
    });

    const setBadge = (id: string, n: number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(n);
    };
    setBadge('count-inbox', cInbox);
    setBadge('count-action', cAction);
    setBadge('count-notes', cNotes);
    setBadge('count-snoozed', cSnoozed);
    setBadge('count-archived', cArchived);

    // Update matrix count badges
    document.querySelectorAll<HTMLElement>('[data-mcount]').forEach((el) => {
      const k = el.dataset.mcount || '';
      const count = matrixCounts[k] ?? 0;
      el.textContent = String(count);
      const btn = el.closest<HTMLElement>('.matrix-btn');
      if (btn && !btn.classList.contains('matrix-row-hdr')) {
        btn.classList.toggle('zero-items', count === 0);
      }
    });

    const emptyBanner = document.getElementById('empty-inbox-banner');
    if (emptyBanner) emptyBanner.classList.toggle('hidden', visibleCount > 0);
  }

  // Pull fresh state from /api/tickets-state on load
  async function syncFromServer() {
    try {
      const res = await fetch('/api/tickets-state');
      if (!res.ok) return;
      const data = await res.json();
      if (data?.last_synced_at) {
        updateSyncAgeBadge(data.last_synced_at);
      }
      if (data && data.states) {
        for (const [id, s] of Object.entries<any>(data.states)) {
          const t = s.ticket || {};
          const c = s.consumption || {};
          localStates[id] = {
            ...(localStates[id] || {}),
            note: t.note ?? localStates[id]?.note ?? '',
            archived: Boolean(c.archived),
            snoozed_until: c.snoozed_until ?? localStates[id]?.snoozed_until ?? '',
            read_by_riccardo: Boolean(c.read_by_riccardo),
          };
        }
        saveLocalStates();
        refreshAllAndFilter();
      }
    } catch {
      // Ignore if offline
    }
  }

  // Wire up 2x5 Matrix buttons (Ale/Seby x EN/DE/FR/Math/Piano + Photos & Misc)
  const matrixBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.matrix-btn'));
  const photoMapSection = document.getElementById('photo-albums-map-view');
  const togglePhotoMapBtn = document.getElementById('btn-toggle-photo-map');
  const closePhotoMapBtn = document.getElementById('btn-close-photo-map');
  let activePhotoAct = 'all';

  function syncUrlQueryParams() {
    try {
      const url = new URL(window.location.href);
      const isPhotosVisible = Boolean(photoMapSection && !photoMapSection.classList.contains('hidden'));
      const setOrDel = (k: string, val: string, defVal: string) => {
        if (!val || val === defVal) url.searchParams.delete(k);
        else url.searchParams.set(k, val);
      };
      setOrDel('tab', activeTab, 'inbox');
      setOrDel('kid', activeKid, 'all');
      setOrDel('subj', activeSubj, 'all');
      setOrDel('photos', isPhotosVisible ? '1' : '0', '0');
      setOrDel('photo_act', activePhotoAct, 'all');
      setOrDel('q', searchQuery, '');
      window.history.replaceState(null, '', url);
    } catch {
      // Ignore if file://
    }
  }

  function filterPhotoMapCards() {
    document.querySelectorAll<HTMLElement>('.photo-album-row').forEach((row) => {
      const cKid = row.dataset.photoKid || 'A+S';
      const cAct = row.dataset.photoActivity || 'classe';
      const matchKid = activeKid === 'all' || cKid === activeKid || cKid === 'A+S';
      const matchAct = activePhotoAct === 'all' || cAct === activePhotoAct;
      row.classList.toggle('hidden', !(matchKid && matchAct));
    });
  }

  function setPhotoMapVisible(visible: boolean) {
    photoMapSection?.classList.toggle('hidden', !visible);
    togglePhotoMapBtn?.classList.toggle('active', visible);
    togglePhotoMapBtn?.setAttribute('aria-expanded', visible ? 'true' : 'false');
    if (visible) filterPhotoMapCards();
    syncUrlQueryParams();
  }

  togglePhotoMapBtn?.addEventListener('click', () => {
    const isCurrentlyHidden = photoMapSection?.classList.contains('hidden');
    setPhotoMapVisible(Boolean(isCurrentlyHidden));
  });

  closePhotoMapBtn?.addEventListener('click', () => {
    setPhotoMapVisible(false);
  });

  document.querySelectorAll<HTMLButtonElement>('.photo-act-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.photo-act-btn').forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-checked', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-checked', 'true');
      activePhotoAct = btn.dataset.photoAct || 'all';
      filterPhotoMapCards();
      syncUrlQueryParams();
    });
  });

  function setActiveMatrixFilter(kid: string, subj: string) {
    activeKid = kid;
    activeSubj = subj;
    aiFilterIds = null;
    matrixBtns.forEach((b) => {
      const isMatch = (b.dataset.matrixKid || 'all') === kid && (b.dataset.matrixSubj || 'all') === subj;
      b.classList.toggle('active', isMatch);
    });
    // Automatically show the Photo Albums Table whenever the user clicks 📸 Photos!
    if (subj === 'photos') {
      setPhotoMapVisible(true);
    } else {
      filterPhotoMapCards();
    }
    refreshAllAndFilter();
    syncUrlQueryParams();
  }

  matrixBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tKid = btn.dataset.matrixKid || 'all';
      const tSubj = btn.dataset.matrixSubj || 'all';
      // Clicking the already active filter (other than Tutto) resets back to Tutto!
      if (activeKid === tKid && activeSubj === tSubj && !(tKid === 'all' && tSubj === 'all')) {
        setActiveMatrixFilter('all', 'all');
      } else {
        setActiveMatrixFilter(tKid, tSubj);
      }
    });
  });

  // Wire up Inbox Tabs
  document.querySelectorAll<HTMLButtonElement>('.inbox-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.inbox-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeTab = btn.dataset.tab || 'inbox';
      aiFilterIds = null;
      refreshAllAndFilter();
    });
  });

  // Wire up Search input
  const searchInput = document.getElementById('gmail-search-input') as HTMLInputElement | null;
  searchInput?.addEventListener('input', () => {
    searchQuery = searchInput.value.trim().toLowerCase();
    aiFilterIds = null;
    refreshAllAndFilter();
  });

  // Wire up Reload Sync button (POST /api/sync)
  const reloadSyncBtn = document.getElementById('btn-reload-sync') as HTMLButtonElement | null;
  reloadSyncBtn?.addEventListener('click', async () => {
    if (!reloadSyncBtn) return;
    const origText = reloadSyncBtn.textContent;
    reloadSyncBtn.disabled = true;
    reloadSyncBtn.textContent = '⏳ Syncing Gmail & Calendars...';
    try {
      const res = await fetch('/api/sync', { method: 'POST' });
      const data = await res.json();
      if (data?.last_synced_at) {
        updateSyncAgeBadge(data.last_synced_at);
      }
      window.location.reload();
    } catch {
      reloadSyncBtn.disabled = false;
      reloadSyncBtn.textContent = origText || '🔄 Reload Sync';
    }
  });

  // Wire up Vertex AI / Gemini Assistant Panel
  const aiPanel = document.getElementById('ai-assistant-panel');
  const toggleAiBtn = document.getElementById('btn-toggle-ai-panel');
  const closeAiBtn = document.getElementById('ai-close-btn');
  const aiForm = document.getElementById('ai-question-form') as HTMLFormElement | null;
  const aiInput = document.getElementById('ai-question-input') as HTMLInputElement | null;
  const aiSubmitBtn = document.getElementById('ai-submit-btn') as HTMLButtonElement | null;
  const aiRespBox = document.getElementById('ai-response-box');
  const aiAnswerText = document.getElementById('ai-answer-text');
  const aiMatchedLinks = document.getElementById('ai-matched-links');
  const aiFilterTableBtn = document.getElementById('ai-filter-table-btn');
  let lastAiMatchedIds: string[] = [];

  toggleAiBtn?.addEventListener('click', () => {
    const isHidden = aiPanel?.classList.toggle('hidden');
    toggleAiBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
    if (!isHidden) aiInput?.focus();
  });

  closeAiBtn?.addEventListener('click', () => {
    aiPanel?.classList.add('hidden');
    toggleAiBtn?.setAttribute('aria-expanded', 'false');
    if (aiFilterIds) {
      aiFilterIds = null;
      refreshAllAndFilter();
    }
  });

  function renderClientMarkdown(md: string): string {
    if (!md) return '';
    const escaped = md
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
    return escaped
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*([^*\n]+)\*/g, '<em>$1</em>')
      .replace(/\[([^\]]+)\]\(#item:([^\s)]+)\)/g, '<a href="#item:$2" data-open-item="$2" class="magic-item-link">$1</a>')
      .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
      .replace(/^- (.+)$/gm, '• $1')
      .split(/\n{2,}/)
      .map(p => `<p>${p.replace(/\n/g, '<br/>')}</p>`)
      .join('');
  }

  // Wire up Top of Mind Parent Switcher (Riccardo default / Kate on click)
  document.querySelectorAll<HTMLButtonElement>('.tom-parent-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetParent = btn.dataset.tomParent || 'riccardo';
      document.querySelectorAll<HTMLButtonElement>('.tom-parent-btn').forEach((b) => {
        const isSel = b.dataset.tomParent === targetParent;
        b.classList.toggle('active', isSel);
        b.setAttribute('aria-selected', isSel ? 'true' : 'false');
      });
      document.getElementById('tom-pane-riccardo')?.classList.toggle('hidden', targetParent !== 'riccardo');
      document.getElementById('tom-pane-kate')?.classList.toggle('hidden', targetParent !== 'kate');
    });
  });

  // Wire up Local Magic Links (a[data-open-item]) across Top of Mind & AI responses!
  document.addEventListener('click', (ev) => {
    const target = (ev.target as HTMLElement | null)?.closest<HTMLElement>('[data-open-item]');
    if (!target) return;
    ev.preventDefault();
    const itemId = target.dataset.openItem || '';
    if (!itemId) return;
    const row = rows.find(r => r.dataset.id === itemId || (r.dataset.id || '').includes(itemId));
    if (row) {
      openDetailModal(row);
    }
  });

  async function askPiotaAi(question: string) {
    const q = question.trim();
    if (!q || !aiRespBox || !aiAnswerText || !aiMatchedLinks) return;
    if (aiInput) aiInput.value = q;
    aiPanel?.classList.remove('hidden');
    aiRespBox.classList.remove('hidden');
    aiAnswerText.innerHTML = '<p>🤖 <em>Sto leggendo le email e i calendari di Ale e Seby con Vertex AI / Gemini...</em></p>';
    aiMatchedLinks.innerHTML = '';
    if (aiSubmitBtn) aiSubmitBtn.disabled = true;

    let answer = '';
    let matchedIds: string[] = [];
    try {
      const res = await fetch('/api/ask-ai', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: q }),
      });
      if (res.ok) {
        const data = await res.json();
        answer = data.answer || '';
        matchedIds = data.matched_ids || [];
      }
    } catch {
      // Client-side instant fallback if offline
    }

    if (!answer) {
      const qLow = q.toLowerCase();
      const matchedRows = rows.filter((r) => {
        if (r.dataset.autoExpired === 'true' || r.dataset.archived === 'true') return false;
        const txt = `${r.dataset.title} ${r.dataset.snippet} ${r.dataset.senderLabel} ${r.dataset.subjects}`.toLowerCase();
        return qLow.split(/\s+/).filter(w => w.length > 3).some(w => txt.includes(w));
      }).slice(0, 5);
      matchedIds = matchedRows.map(r => r.dataset.id || '').filter(Boolean);
      answer = matchedRows.length
        ? matchedRows.map(r => `- **${r.dataset.ymd}** — [📧 ${r.dataset.title}](#item:${r.dataset.id}): ${r.dataset.snippet}`).join('\n')
        : 'Nessuna email specifica trovata; prova a cliccare uno dei tasti della matrice 2x5 qui sotto!';
    }

    if (aiSubmitBtn) aiSubmitBtn.disabled = false;
    aiAnswerText.innerHTML = renderClientMarkdown(answer);
    lastAiMatchedIds = matchedIds;

    // Render clickable email/task links that open the full reader modal!
    aiMatchedLinks.innerHTML = '';
    matchedIds.forEach((mid) => {
      const row = rows.find(r => r.dataset.id === mid);
      if (!row) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ai-email-link-card';
      const kidTag = row.dataset.kid === 'Ale' ? '🐉 Ale' : (row.dataset.kid === 'Seb' ? '🚗 Seb' : '🐉🚗 A+S');
      const icon = row.dataset.type === 'alert' ? '📧' : '📅';
      btn.textContent = `${icon} ${kidTag} · ${row.dataset.ymd} — ${row.dataset.title}`;
      btn.title = 'Clicca per aprire questa email/compito nell\'app';
      btn.addEventListener('click', () => openDetailModal(row));
      aiMatchedLinks.appendChild(btn);
    });
  }

  aiForm?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    if (aiInput?.value) askPiotaAi(aiInput.value);
  });

  document.querySelectorAll<HTMLButtonElement>('.ai-chip-btn').forEach((chip) => {
    chip.addEventListener('click', () => {
      const q = chip.dataset.aiQ || '';
      if (q) askPiotaAi(q);
    });
  });

  aiFilterTableBtn?.addEventListener('click', () => {
    if (lastAiMatchedIds.length > 0) {
      aiFilterIds = new Set(lastAiMatchedIds);
      refreshAllAndFilter();
    }
  });

  // Open Detail Modal
  function openDetailModal(row: HTMLElement) {
    const id = row.dataset.id || '';
    currentModalItemId = id;

    // Mark as read for active user
    const readPatch = activeUser === 'riccardo' ? { read_by_riccardo: true } : { read_by_kate: true };
    persistToBackend(id, readPatch);
    refreshAllAndFilter();

    const titleEl = document.getElementById('dialog-title');
    const provBadge = document.getElementById('dialog-prov-badge');
    const provBar = document.getElementById('dialog-provenance-bar');
    const provKFrom = document.getElementById('dialog-prov-k-from');
    const provVFrom = document.getElementById('dialog-prov-v-from');
    const provKSubj = document.getElementById('dialog-prov-k-subj');
    const provVSubj = document.getElementById('dialog-prov-v-subj');
    const provVTs = document.getElementById('dialog-prov-v-ts');
    const provVOrigin = document.getElementById('dialog-prov-v-origin');
    const datesBadge = document.getElementById('dialog-dates-badge');
    const bodyEl = document.getElementById('dialog-body-content');
    const noteInput = document.getElementById('dialog-note-input') as HTMLInputElement | null;
    const srcLink = document.getElementById('dialog-source-link') as HTMLAnchorElement | null;
    const srcLinkText = document.getElementById('dialog-source-link-text');

    const provKind = row.dataset.provKind || 'piota_legacy';
    if (titleEl) titleEl.textContent = row.dataset.title || '';
    if (datesBadge) datesBadge.textContent = row.dataset.datesLabel || '';
    if (noteInput) noteInput.value = row.dataset.note || '';

    if (provBadge) {
      provBadge.textContent = row.dataset.provBadge || '';
      provBadge.className = `dialog-prov-pill prov-${provKind}`;
    }
    if (provBar) {
      provBar.className = `dialog-provenance-bar prov-bar-${provKind}`;
    }
    if (provKFrom) {
      provKFrom.textContent = provKind === 'email' ? 'Mittente' : provKind === 'gcal' ? 'Calendario' : provKind === 'ai_auto' ? 'Generatore' : 'Mittente';
    }
    if (provKSubj) {
      provKSubj.textContent = provKind === 'email' ? 'Subject' : provKind === 'gcal' ? 'Evento' : 'Titolo';
    }
    if (provVFrom) provVFrom.textContent = row.dataset.provFrom || '';
    if (provVSubj) provVSubj.textContent = row.dataset.provSubject || row.dataset.title || '';
    if (provVTs) provVTs.textContent = row.dataset.provTs || row.dataset.ymd || '—';
    if (provVOrigin) provVOrigin.textContent = row.dataset.provOrigin || '';

    const tpl = row.querySelector<HTMLTemplateElement>('.item-body-template');
    if (bodyEl && tpl) {
      bodyEl.innerHTML = '';
      bodyEl.appendChild(tpl.content.cloneNode(true));
    }

    if (srcLink) {
      const url = row.dataset.sourceUrl || '';
      const label = row.dataset.sourceLabel || 'Apri sorgente';
      if (url) {
        srcLink.href = url;
        if (srcLinkText) srcLinkText.textContent = label;
        srcLink.classList.remove('hidden');
      } else {
        srcLink.classList.add('hidden');
      }
    }

    detailDialog?.showModal();
  }

  // Open Quick Note Modal
  function openQuickNoteModal(row: HTMLElement) {
    const id = row.dataset.id || '';
    currentModalItemId = id;
    const sub = document.getElementById('quick-note-subtitle');
    const ta = document.getElementById('quick-note-textarea') as HTMLTextAreaElement | null;
    if (sub) sub.textContent = `${row.dataset.senderLabel} — ${row.dataset.title}`;
    if (ta) ta.value = row.dataset.note || '';
    quickNoteDialog?.showModal();
    ta?.focus();
  }

  // Delegate Row Actions using addEventListener (zero inline onclick handlers)
  rows.forEach((row) => {
    const id = row.dataset.id || '';

    // 1. Toggle Read dot
    row.querySelector('[data-action="toggle-read"]')?.addEventListener('click', () => {
      const curRead = row.dataset.readRiccardo === 'true';
      persistToBackend(id, { read_by_riccardo: !curRead });
      refreshAllAndFilter();
    });

    // Prevent clicking inline Google Photos chip from opening the row modal
    row.querySelectorAll<HTMLElement>('.row-gphoto-pill').forEach((pill) => {
      pill.addEventListener('click', (ev) => {
        ev.stopPropagation();
      });
    });

    // 2. Click Subject/Content to open reader modal (/show/)
    const contentCell = row.querySelector<HTMLElement>('[data-action="open-detail"]');
    contentCell?.addEventListener('click', () => openDetailModal(row));
    contentCell?.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' || ev.key === ' ') {
        ev.preventDefault();
        openDetailModal(row);
      }
    });

    // 3. ARCHIVIA button (marks as read + removes from inbox)
    row.querySelector('[data-action="archive-read"]')?.addEventListener('click', () => {
      const curArch = row.dataset.archived === 'true';
      persistToBackend(id, {
        archived: !curArch,
        read_by_riccardo: true,
        snoozed_until: '',
      });
      refreshAllAndFilter();
    });

    // 4. SNOOZE 7g button (hides for 7 days then returns automatically)
    row.querySelector('[data-action="snooze-7d"]')?.addEventListener('click', () => {
      const nowIso = new Date().toISOString();
      const curSnooze = row.dataset.snoozedUntil || '';
      const isSnoozed = Boolean(curSnooze && curSnooze > nowIso);
      const nextSnooze = isSnoozed ? '' : new Date(Date.now() + 7 * 86400000).toISOString();
      persistToBackend(id, {
        snoozed_until: nextSnooze,
        archived: false,
      });
      refreshAllAndFilter();
    });

    // 5. Open Quick Note Dialog
    row.querySelector('[data-action="open-note"]')?.addEventListener('click', () => {
      openQuickNoteModal(row);
    });
  });

  // Big "HO LETTO — Archivia" button inside /show/ Detail Modal
  document.getElementById('dialog-ho-letto-btn')?.addEventListener('click', () => {
    if (!currentModalItemId) return;
    const noteInput = document.getElementById('dialog-note-input') as HTMLInputElement | null;
    const val = (noteInput?.value || '').trim();
    const patch: ItemLocalState = {
      read_by_riccardo: true,
      archived: true,
      snoozed_until: '',
    };
    if (val) patch.note = val;
    persistToBackend(currentModalItemId, patch);
    refreshAllAndFilter();
    detailDialog?.close();
  });

  // "Snooze 7 giorni" button inside /show/ Detail Modal
  document.getElementById('dialog-snooze-btn')?.addEventListener('click', () => {
    if (!currentModalItemId) return;
    const nextSnooze = new Date(Date.now() + 7 * 86400000).toISOString();
    persistToBackend(currentModalItemId, {
      snoozed_until: nextSnooze,
      archived: false,
    });
    refreshAllAndFilter();
    detailDialog?.close();
  });

  // Save Note inside Detail Modal
  document.getElementById('dialog-save-note-btn')?.addEventListener('click', () => {
    if (!currentModalItemId) return;
    const noteInput = document.getElementById('dialog-note-input') as HTMLInputElement | null;
    const val = (noteInput?.value || '').trim();
    persistToBackend(currentModalItemId, { note: val });
    refreshAllAndFilter();
  });

  // Quick Note Form Submit / Clear / Close
  document.getElementById('quick-note-form')?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    if (!currentModalItemId) return;
    const ta = document.getElementById('quick-note-textarea') as HTMLTextAreaElement | null;
    const val = (ta?.value || '').trim();
    persistToBackend(currentModalItemId, { note: val });
    refreshAllAndFilter();
    quickNoteDialog?.close();
  });

  document.getElementById('quick-note-clear-btn')?.addEventListener('click', () => {
    if (!currentModalItemId) return;
    persistToBackend(currentModalItemId, { note: '' });
    refreshAllAndFilter();
    quickNoteDialog?.close();
  });

  document.getElementById('quick-note-cancel')?.addEventListener('click', () => quickNoteDialog?.close());
  document.getElementById('quick-note-close-btn')?.addEventListener('click', () => quickNoteDialog?.close());

  // Initial render + URL query params (?tab=..., ?kid=Ale|Seb, ?subj=..., ?photos=1, ?photo_act=...) + fetch server state
  const urlParams = new URLSearchParams(window.location.search);
  const qTab = urlParams.get('tab');
  if (qTab && ['inbox', 'action', 'notes', 'snoozed', 'archived'].includes(qTab)) {
    activeTab = qTab;
    document.querySelectorAll('.inbox-tab').forEach((b) => {
      b.classList.toggle('active', (b as HTMLElement).dataset.tab === qTab);
    });
  }
  const qPhotoAct = urlParams.get('photo_act');
  if (qPhotoAct) {
    activePhotoAct = qPhotoAct;
    document.querySelectorAll<HTMLButtonElement>('.photo-act-btn').forEach((b) => {
      const isSel = b.dataset.photoAct === qPhotoAct;
      b.classList.toggle('active', isSel);
      b.setAttribute('aria-checked', isSel ? 'true' : 'false');
    });
  }
  const qKid = urlParams.get('kid') || 'all';
  const qSubj = urlParams.get('subj') || 'all';
  if (qKid !== 'all' || qSubj !== 'all') {
    setActiveMatrixFilter(qKid, qSubj);
  } else {
    refreshAllAndFilter();
  }
  if (urlParams.get('photos') === '1' || qSubj === 'photos') {
    setPhotoMapVisible(true);
  }
  updateSyncAgeBadge();
  syncFromServer();
</script>
