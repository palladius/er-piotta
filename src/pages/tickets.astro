  /* Column Header Bar (Col 1 = FIGLIO, Col 2 = MITTENTE, Col 3 = DATA Lun 16 Nov) */
  .gmail-list-header {
    display: grid;
    grid-template-columns: 105px 195px 150px 1fr 290px;
    gap: 0.65rem;
    padding: 0.35rem 0.9rem;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #64748b;
    text-transform: uppercase;
  }

  /* Gmail List & Row */
  .gmail-list {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
  }

  .gmail-row {
    display: grid;
    grid-template-columns: 105px 195px 150px 1fr 290px;
    gap: 0.65rem;
    align-items: center;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid #f1f5f9;
    transition: background 0.12s ease;
    font-size: 0.86rem;
