export JAVA_HOME := env_var_or_default("JAVA_HOME", "/home/riccardo/opt/jdk17")
export ANDROID_HOME := env_var_or_default("ANDROID_HOME", "/home/riccardo/Android/Sdk")

default:
    @just --list

sync-feed:
    cp ../src/data/piota_feed.json app/src/main/assets/piota_feed.json
    @ls -lh app/src/main/assets/piota_feed.json

test:
    ./gradlew testDebugUnitTest

build-apk: sync-feed
    ./gradlew assembleDebug
    @ls -lh app/build/outputs/apk/debug/app-debug.apk

install-pixel: build-apk
    {{ANDROID_HOME}}/platform-tools/adb install --user 0 -r -g app/build/outputs/apk/debug/app-debug.apk
    {{ANDROID_HOME}}/platform-tools/adb shell am start -n org.carlessos.erpiotta/.MainActivity
